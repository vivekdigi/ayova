/* Sticky Purchase Action Bar */
.mobile-sticky-action-bar {
  display: block;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-top: 1px solid #E2E6DF;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
  z-index: 999;
  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
}

.mobile-sticky-inner {
  display: flex;
  gap: 10px;
  align-items: center;
  justify-content: center;
  max-width: 500px;
  margin: 0 auto;
  width: 100%;
}

.btn-sticky-action {
  flex: 1;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 30px;
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  border: none;
  cursor: pointer;
  box-sizing: border-box;
  padding: 0 12px;
  letter-spacing: 0.02em;
  transition: opacity 0.2s, transform 0.15s, background-color 0.2s;
}

.btn-sticky-action:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-sticky-action.flipkart-sticky {
  background-color: #FF9F00;
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(255, 159, 0, 0.25);
}

.btn-sticky-action.flipkart-sticky:hover {
  background-color: #f29600;
  color: #ffffff;
}

.btn-sticky-action.amazon-sticky {
  background-color: #FFD814;
  color: #0F1111;
  box-shadow: 0 2px 6px rgba(255, 216, 20, 0.25);
}

.btn-sticky-action.amazon-sticky:hover {
  background-color: #f7ca00;
  color: #0F1111;
}

.btn-sticky-action.add-cart-sticky {
  background-color: var(--color-forest-primary, #285044);
  color: #ffffff;
}

.btn-sticky-action.buy-now-sticky {
  background-color: var(--color-terracotta, #D96C3F);
  color: #ffffff;
}

@media (min-width: 769px) {
  .mobile-sticky-action-bar {
    padding: 12px 24px;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .mobile-sticky-action-bar.is-sticky-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-sticky-inner {
    max-width: 520px;
    gap: 14px;
  }

  .btn-sticky-action {
    height: 48px;
    font-size: 0.88rem;
    padding: 0 16px;
  }

  .btn-sticky-action:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }
}
</style>

{% if product.metafields.custom.product_video != blank %}
  <div class="floating-product-video" id="floatingProductVideo">
    <button type="button" class="floating-video-toggle" id="floatingVideoToggle" aria-label="Minimize video">−</button>
    <div class="floating-video-sound-toggle">
      <button type="button" id="floatingSoundBtn" aria-label="Toggle Sound">🔇</button>
    </div>
    <video class="floating-video-element" autoplay muted loop playsinline controlsList="nodownload" oncontextmenu="return false;" disablePictureInPicture style="cursor: pointer;">
      {% for source in product.metafields.custom.product_video.value.sources %}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {% endfor %}
    </video>
  </div>
  <style>
    .floating-product-video {
      position: fixed;
      bottom: 20px;
      left: 20px;
      width: 110px;
      border-radius: 10px;
      overflow: hidden;
      z-index: 9999;
      box-shadow: 0 6px 18px rgba(0,0,0,0.25);
      background: #000;
      aspect-ratio: 9/16;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }
    .floating-product-video.minimized {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      aspect-ratio: 1/1;
    }
    .floating-product-video.minimized video {
      border-radius: 50%;
    }
    .floating-video-toggle {
      position: absolute;
      top: 4px;
      right: 4px;
      width: 20px;
      height: 20px;
      background: rgba(0,0,0,0.55);
      color: #fff;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      line-height: 1;
      z-index: 10;
    }
    .floating-video-toggle:hover {
      background: rgba(0,0,0,0.85);
    }
    .floating-product-video video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: all 0.3s ease;
    }
    .floating-video-sound-toggle {
      position: absolute;
      bottom: 6px;
      right: 6px;
      z-index: 10;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .floating-product-video:hover .floating-video-sound-toggle {
      opacity: 1;
    }
    #floatingSoundBtn {
      background: rgba(0,0,0,0.6);
      color: #fff;
      border: none;
      border-radius: 50%;
      width: 26px;
      height: 26px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
    }
    #floatingSoundBtn:hover {
      background: rgba(0,0,0,0.85);
    }
    @media (max-width: 768px) {
      .floating-product-video {
        bottom: 75px;
        left: 14px;
        width: 65px;
        height: 65px;
        border-radius: 50%;
        aspect-ratio: 1/1;
        box-shadow: 0 4px 14px rgba(0,0,0,0.3);
      }
      .floating-product-video video {
        border-radius: 50%;
      }
      .floating-product-video.expanded {
        width: 140px;
        height: auto;
        aspect-ratio: 9/16;
        border-radius: 12px;
      }
      .floating-product-video.expanded video {
        border-radius: 12px;
      }
      .floating-product-video.minimized {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        aspect-ratio: 1/1;
      }
      .floating-video-sound-toggle {
        display: none;
      }
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var videoContainer = document.getElementById('floatingProductVideo');
      var toggleBtn = document.getElementById('floatingVideoToggle');
      var soundBtn = document.getElementById('floatingSoundBtn');
      var videoEl = document.querySelector('.floating-video-element');
      
      if(videoContainer && toggleBtn) {
        if (window.innerWidth <= 768) {
          videoContainer.classList.add('minimized');
          toggleBtn.innerHTML = '+';
          toggleBtn.setAttribute('aria-label', 'Maximize video');
        }
        toggleBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          videoContainer.classList.toggle('minimized');
          if(videoContainer.classList.contains('minimized')) {
            videoContainer.classList.remove('expanded');
            toggleBtn.innerHTML = '+';
            toggleBtn.setAttribute('aria-label', 'Maximize video');
          } else {
            videoContainer.classList.add('expanded');
            toggleBtn.innerHTML = '−';
            toggleBtn.setAttribute('aria-label', 'Minimize video');
          }
        });
      }
      
      if(soundBtn && videoEl) {
        soundBtn.addEventListener('click', function(e) {
          e.preventDefault();
          videoEl.muted = !videoEl.muted;
          this.innerHTML = videoEl.muted ? '🔇' : '🔊';
        });
      }
      
      if(videoEl) {
        videoEl.addEventListener('click', function() {
          if (videoEl.paused) {
            videoEl.play();
          } else {
            videoEl.pause();
          }
        });
      }
    });
  </script>
{% endif %}

<!-- Sticky Purchase Action Bar -->
<div class="mobile-sticky-action-bar" id="mobileStickyActionBar">
  <div class="mobile-sticky-inner">
    {% if is_redirect_true and (flipkart_link != blank or amazon_link != blank) %}
      {% if flipkart_link != blank %}
        <a href="{{ flipkart_link }}" target="_blank" rel="noopener noreferrer" class="btn-sticky-action flipkart-sticky">
          BUY ON FLIPKART
        </a>
      {% endif %}
      {% if amazon_link != blank %}
        <a href="{{ amazon_link }}" target="_blank" rel="noopener noreferrer" class="btn-sticky-action amazon-sticky">
          BUY ON AMAZON
        </a>
      {% endif %}
    {% else %}
      <button type="button" class="btn-sticky-action add-cart-sticky" onclick="var f=document.querySelector('.product-form'); if(f){ var b=f.querySelector('button[name=add]'); if(b) b.click(); else f.querySelector('button[type=submit]').click(); }">
        ADD TO CART
      </button>
      <button type="button" class="btn-sticky-action buy-now-sticky" onclick="var f=document.querySelector('.product-form'); if(f){ var buyBtn=f.querySelector('.btn-buy-now') || f.querySelector('.btn-buy-now-new'); if(buyBtn) buyBtn.click(); else { var b=f.querySelector('button[name=add]'); if(b) b.click(); else f.submit(); } }">
        BUY NOW
      </button>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var stickyBar = document.getElementById('mobileStickyActionBar');
    var purchaseRow = document.querySelector('.purchase-actions-row');
    if (stickyBar && purchaseRow) {
      function checkStickyVisibility() {
        if (window.innerWidth > 768) {
          var rect = purchaseRow.getBoundingClientRect();
          if (rect.bottom < 0) {
            stickyBar.classList.add('is-sticky-visible');
          } else {
            stickyBar.classList.remove('is-sticky-visible');
          }
        }
      }
      window.addEventListener('scroll', checkStickyVisibility, { passive: true });
      window.addEventListener('resize', checkStickyVisibility);
      checkStickyVisibility();
    }
  });
</script>

