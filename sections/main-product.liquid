{% comment %}
  AYOVA PRODUCT DETAIL MAIN SECTION - Redesigned Layout
{% endcomment %}

<div class="section-padding product-page">
  <div class="container">
    
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="breadcrumbs">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/collections/all">Shop</a>
      <span aria-hidden="true">/</span>
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-main-grid">
      
      <!-- Left Column: Product Gallery -->
      <div class="product-gallery-wrapper">
        <div class="gallery-inner">
          
          <!-- Big Size Main Featured Image Box -->
          <div class="main-image-box" id="mainImageBox">
            <!-- Lightbox Zoom Icon Button on Main Image -->
            <button type="button" class="btn-lightbox-trigger" id="btnLightboxTrigger" aria-label="Open Lightbox Image Zoom" title="Click to zoom image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
            
            {% assign media_items = product.media | default: product.images %}
            {% if media_items.size > 1 %}
              <button type="button" class="main-carousel-nav-btn main-carousel-prev" id="mainCarouselPrevBtn" aria-label="Previous Slide">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 18l-6-6 6-6"/>
                </svg>
              </button>
            {% endif %}

            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" id="mainProductImg" title="Click to zoom image">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            {% if media_items.size > 1 %}
              <button type="button" class="main-carousel-nav-btn main-carousel-next" id="mainCarouselNextBtn" aria-label="Next Slide">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </button>
            {% endif %}
          </div>

          <!-- Horizontal Thumbnails Carousel Below Main Image -->
          {% if media_items.size > 1 %}
          <div class="gallery-thumbs-carousel-wrapper" id="galleryThumbsWrapper">
            <button type="button" class="thumb-nav-btn prev-thumb-btn disabled" aria-label="Previous thumbnail" id="prevThumbBtn" disabled>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>
            
            <div class="thumbs-carousel-container" id="thumbsCarouselContainer">
              <div class="thumbs-list" id="thumbsList">
                {% for item in media_items %}
                  {% assign item_image = item.preview_image | default: item %}
                  <div class="thumb {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" data-full="{{ item_image | image_url: width: 1400 }}" data-id="{{ item.id }}" {% if item.media_type == 'video' or item.media_type == 'external_video' %}data-is-video="true"{% endif %}>
                    <img src="{{ item_image | image_url: width: 240 }}" alt="{{ product.title | escape }}" class="thumb-img" loading="lazy">
                    {% if item.media_type == 'video' or item.media_type == 'external_video' %}
                      <div class="thumb-video-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="#ffffff"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>

            <button type="button" class="thumb-nav-btn next-thumb-btn" aria-label="Next thumbnail" id="nextThumbBtn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </button>
          </div>
          {% endif %}

        </div>

        <!-- Image Navigation Pills -->
        {% if section.settings.show_gallery_pills %}
        <div class="gallery-pills-wrapper">
          <div class="gallery-pills">
            {% assign pill_count = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'gallery_pill' %}
                <button class="gallery-pill {% if pill_count == 0 %}active{% endif %}" onclick="showGalleryPillContent({{ forloop.index0 }})" {{ block.shopify_attributes }}>{{ block.settings.title }}</button>
                {% assign pill_count = pill_count | plus: 1 %}
              {% endif %}
            {% endfor %}

            {% if pill_count == 0 %}
              <button class="gallery-pill active">Front View</button>
              <button class="gallery-pill">Label Detail</button>
              <button class="gallery-pill">Lifestyle</button>
              <button class="gallery-pill">Benefits</button>
            {% endif %}
          </div>
          
          <div class="gallery-pill-contents">
            {% assign pill_count = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'gallery_pill' %}
                <div class="gallery-pill-content {% if pill_count == 0 %}active{% endif %}" id="pill-content-{{ forloop.index0 }}">
                  {% if block.settings.description != blank %}
                    {{ block.settings.description }}
                  {% endif %}
                </div>
                {% assign pill_count = pill_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <script>
          function showGalleryPillContent(index) {
            const pills = document.querySelectorAll('.gallery-pills-wrapper .gallery-pill');
            const contents = document.querySelectorAll('.gallery-pills-wrapper .gallery-pill-content');
            
            pills.forEach((el, i) => {
              if(i === index) el.classList.add('active');
              else el.classList.remove('active');
            });
            contents.forEach((el, i) => {
              if(i === index) el.classList.add('active');
              else el.classList.remove('active');
            });
          }
        </script>
      {% endif %}

        <!-- Product Features & Trust Badges (Below Gallery) -->
        <div class="gallery-features-wrapper">
          <!-- Product Info Grid -->
          {% if section.settings.show_info_grid %}
          <div class="product-info-grid">
            <div class="info-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"></line></svg>
              <p>{{ section.settings.feature_1_text | default: "Contains pure Ayurvedic herbs and standardized extracts that support your everyday wellness" }}</p>
            </div>
            <div class="info-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5"><rect x="4" y="6" width="16" height="12" rx="6"></rect><line x1="12" y1="6" x2="12" y2="18"></line></svg>
              <p>{{ section.settings.feature_2_text | default: "Authentic classical formulation made in India, customized for optimal bioavailability" }}</p>
            </div>
            <div class="info-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5"><path d="M10 2v7.31"></path><path d="M14 9.3V1.99"></path><path d="M8.5 2h7"></path><path d="M14 9.3a6.5 6.5 0 1 1-4 0"></path><path d="M5.52 16h12.96"></path></svg>
              <p>{{ section.settings.feature_3_text | default: "Scientifically backed botanicals to help you achieve your health goals naturally" }}</p>
            </div>
          </div>
          {% endif %}

          <!-- Trust Badges Block -->
          {% if section.settings.show_trust_badges %}
          <div class="product-trust-block">
            <div class="trust-feat">
              <div class="tf-icon" style="background-color: #c94c66;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg></div>
              <span>{{ section.settings.trust_1_text }}</span>
            </div>
            <div class="trust-feat">
              <div class="tf-icon" style="background-color: #ff9e2a;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div>
              <span>{{ section.settings.trust_2_text }}</span>
            </div>
            <div class="trust-feat">
              <div class="tf-icon" style="background-color: #22a855;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
              <span>{{ section.settings.trust_3_text }}</span>
            </div>
            <div class="trust-feat">
              <div class="tf-icon" style="background-color: #1994d1;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></div>
              <span>{{ section.settings.trust_4_text }}</span>
            </div>
          </div>
          {% endif %}

        </div>
      </div>

      <!-- Right Column: Product Details & Purchase Form -->
      <div class="product-details-wrapper">
        <div class="details-header">
          {% if product.type != blank %}
            <span class="badge badge-category-light">{{ product.type | upcase }}</span>
          {% endif %}
          <h1 class="product-title-new">{{ product.title }}</h1>
          
          <div class="product-reviews-row-new">
            <span class="rating-stars-new">★★★★★</span>
            <span class="rating-text-new">4.9 • <span class="verified-text">1,248 verified reviews</span></span>
          </div>

          {% comment %}
          <div class="live-orders-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            <span id="liveOrderCount">1000</span> orders received today!
          </div>
          {% endcomment %}
        </div>

        <div class="product-price-wrapper">
          <div class="product-price-box-new">
            {% if product.compare_at_price > product.price %}
              <span class="price-mrp-wrap">MRP : <span class="price-compare-new">{{ product.compare_at_price | money }}</span></span>
            {% endif %}
            <span class="price-large-new">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="price-discount-new">{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% OFF</span>
            {% endif %}
          </div>
          
          {% if product.metafields.custom.per_count_price != blank %}
            <div class="product-per-count-price" style="font-size: 0.9rem; color: #666; margin-top: 4px; margin-bottom: 4px;">
              ({{ product.metafields.custom.per_count_price }})
            </div>
          {% endif %}

          <div class="gst-label-new">Inclusive of all taxes</div>
        </div>

        {% if section.settings.show_description and product.description != blank %}
          <div class="product-subtitle">{{ product.description | strip_html | truncatewords: 35 }}</div>
        {% endif %}

        <!-- Feature List -->
        {% if section.settings.show_why_love_it %}
        <div class="why-love-it">
          <h4>Why you'll love it</h4>
          <ul class="feature-list">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Supports healthy liver function
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Standardized to 80% Silymarin
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Helps natural detox pathways
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Vegetarian capsules • 60 count
            </li>
          </ul>
        </div>
        {% endif %}

        <!-- Add to Cart Form -->
        <form action="/cart/add" method="post" enctype="multipart/form-data" class="product-form" data-product-form onsubmit="event.preventDefault(); var btn = event.submitter || this.querySelector('button[type=submit]'); if(btn.dataset.added === 'true') { window.location.href='/cart'; return; } btn.innerHTML = 'Adding...'; btn.disabled = true; fetch('/cart/add.js', { method: 'POST', body: new FormData(this) }).then(res=>res.json()).then(data=>{ btn.innerHTML = 'View Cart'; btn.disabled = false; btn.dataset.added = 'true'; }).catch(err => { btn.innerHTML = 'Error'; btn.disabled = false; });">
          <!-- Choose Pack / Variants -->
          <div class="variant-picker-new">
            <h4 class="variant-label-new">Select a Pack</h4>
            
            <div class="variant-options-grid variant-cards-grid">
              {% if product.has_only_default_variant %}
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              {% else %}
                {% for variant in product.variants %}
                  {% assign is_bestseller = false %}
                  {% if variant.title contains 'Pack of 2' or variant.title contains '2' and product.variants.size > 1 and forloop.index == 2 %}
                    {% assign is_bestseller = true %}
                  {% elsif forloop.index == 2 and product.variants.size > 1 %}
                    {% assign is_bestseller = true %}
                  {% endif %}
                  {% assign var_image = variant.featured_image | default: variant.image %}

                  <label class="variant-box variant-pack-card {% if forloop.first %}active{% endif %}" data-variant-id="{{ variant.id }}">
                    <input type="radio" 
                      name="id" 
                      value="{{ variant.id }}" 
                      {% if forloop.first %}checked{% endif %} 
                      class="hidden-radio" 
                      data-price="{{ variant.price }}" 
                      data-compare="{{ variant.compare_at_price }}"
                      {% if var_image != blank %}
                        data-image="{{ var_image | image_url: width: 800 }}"
                        data-image-id="{{ var_image.id }}"
                      {% endif %}
                    >

                    <!-- Top Row: Subhead / Bestseller Badge + Radio Circle -->
                    <div class="pack-card-header">
                      {% if is_bestseller %}
                        <span class="pack-badge-bestseller">BEST SELLER</span>
                      {% else %}
                        <span class="pack-subhead">{{ variant.title | upcase }}</span>
                      {% endif %}
                      <span class="pack-radio-circle"></span>
                    </div>

                    <div class="pack-card-divider"></div>

                    <!-- Middle: Title -->
                    <div class="pack-card-title">{{ variant.title }}</div>

                    <!-- Price Row -->
                    <div class="pack-card-prices">
                      <span class="pack-price">{{ variant.price | money }}</span>
                      {% if variant.compare_at_price > variant.price %}
                        <span class="pack-compare-price">{{ variant.compare_at_price | money }}</span>
                      {% endif %}
                    </div>

                    <!-- Bottom: Savings Pill -->
                    {% if variant.compare_at_price > variant.price %}
                      {% assign save_diff = variant.compare_at_price | minus: variant.price %}
                      <div class="pack-savings-pill">Save {{ save_diff | money }}</div>
                    {% endif %}
                  </label>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <!-- Available Offers (Discount Coupons Carousel) -->
          {% if section.settings.show_available_offers != false %}
          {% assign coupon_blocks = section.blocks | where: "type", "coupon_offer" %}
          <div class="product-available-offers-section" id="productAvailableOffersSection" data-has-offers="true">
            <div class="available-offers-header">
              <div class="available-offers-title-wrap">
                <svg class="offer-tag-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                  <circle cx="7" cy="7" r="1.5" fill="currentColor"></circle>
                </svg>
                <h4 class="available-offers-title">{{ section.settings.available_offers_title | default: "Available Offers" }}</h4>
                <span class="offers-count-badge" id="offersCountBadge">1 of 3</span>
              </div>
              <div class="offers-nav-arrows" id="offersNavArrows">
                <button type="button" class="offer-nav-btn offer-nav-prev" onclick="scrollOffersCarousel(this, -1)" aria-label="Previous Offer">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <button type="button" class="offer-nav-btn offer-nav-next" onclick="scrollOffersCarousel(this, 1)" aria-label="Next Offer">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
              </div>
            </div>

            <div class="available-offers-track" id="availableOffersTrack">
              {% if coupon_blocks.size > 0 %}
                {% for block in coupon_blocks %}
                  {% if block.settings.coupon_code != blank %}
                    <div class="available-offer-card" {{ block.shopify_attributes }} data-coupon-code="{{ block.settings.coupon_code | escape }}" data-start-date="{{ block.settings.start_date | escape }}" data-end-date="{{ block.settings.end_date | escape }}">
                      <div class="offer-card-top">
                        <div class="offer-card-title">{{ block.settings.title | default: "Special Discount" }}</div>
                        {% if block.settings.description != blank %}
                          <div class="offer-card-desc">{{ block.settings.description }}</div>
                        {% endif %}
                      </div>
                      <div class="offer-coupon-box">
                        <div class="offer-coupon-meta">
                          <span class="coupon-lbl">COUPON CODE</span>
                          <span class="coupon-code-val">{{ block.settings.coupon_code }}</span>
                        </div>
                        <button type="button" class="btn-copy-coupon" onclick="copyOfferCoupon(this, '{{ block.settings.coupon_code | escape }}')">COPY</button>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              {% else %}
                {% if section.settings.offer_1_code != blank %}
                  <div class="available-offer-card" data-coupon-code="{{ section.settings.offer_1_code | escape }}" data-start-date="{{ section.settings.offer_1_start | default: '2024-01-01' | escape }}" data-end-date="{{ section.settings.offer_1_end | default: '2030-12-31' | escape }}">
                    <div class="offer-card-top">
                      <div class="offer-card-title">{{ section.settings.offer_1_title | default: "10% off" }}</div>
                      {% if section.settings.offer_1_desc != blank %}
                        <div class="offer-card-desc">{{ section.settings.offer_1_desc }}</div>
                      {% endif %}
                    </div>
                    <div class="offer-coupon-box">
                      <div class="offer-coupon-meta">
                        <span class="coupon-lbl">COUPON CODE</span>
                        <span class="coupon-code-val">{{ section.settings.offer_1_code }}</span>
                      </div>
                      <button type="button" class="btn-copy-coupon" onclick="copyOfferCoupon(this, '{{ section.settings.offer_1_code | escape }}')">COPY</button>
                    </div>
                  </div>
                {% endif %}

                {% if section.settings.offer_2_code != blank %}
                  <div class="available-offer-card" data-coupon-code="{{ section.settings.offer_2_code | escape }}" data-start-date="{{ section.settings.offer_2_start | default: '2024-01-01' | escape }}" data-end-date="{{ section.settings.offer_2_end | default: '2030-12-31' | escape }}">
                    <div class="offer-card-top">
                      <div class="offer-card-title">{{ section.settings.offer_2_title | default: "5% OFF" }}</div>
                      {% if section.settings.offer_2_desc != blank %}
                        <div class="offer-card-desc">{{ section.settings.offer_2_desc }}</div>
                      {% endif %}
                    </div>
                    <div class="offer-coupon-box">
                      <div class="offer-coupon-meta">
                        <span class="coupon-lbl">COUPON CODE</span>
                        <span class="coupon-code-val">{{ section.settings.offer_2_code }}</span>
                      </div>
                      <button type="button" class="btn-copy-coupon" onclick="copyOfferCoupon(this, '{{ section.settings.offer_2_code | escape }}')">COPY</button>
                    </div>
                  </div>
                {% endif %}

                {% if section.settings.offer_3_code != blank %}
                  <div class="available-offer-card" data-coupon-code="{{ section.settings.offer_3_code | escape }}" data-start-date="{{ section.settings.offer_3_start | default: '2024-01-01' | escape }}" data-end-date="{{ section.settings.offer_3_end | default: '2030-12-31' | escape }}">
                    <div class="offer-card-top">
                      <div class="offer-card-title">{{ section.settings.offer_3_title | default: "FLAT ₹150 OFF" }}</div>
                      {% if section.settings.offer_3_desc != blank %}
                        <div class="offer-card-desc">{{ section.settings.offer_3_desc }}</div>
                      {% endif %}
                    </div>
                    <div class="offer-coupon-box">
                      <div class="offer-coupon-meta">
                        <span class="coupon-lbl">COUPON CODE</span>
                        <span class="coupon-code-val">{{ section.settings.offer_3_code }}</span>
                      </div>
                      <button type="button" class="btn-copy-coupon" onclick="copyOfferCoupon(this, '{{ section.settings.offer_3_code | escape }}')">COPY</button>
                    </div>
                  </div>
                {% endif %}

                {% if section.settings.offer_4_code != blank %}
                  <div class="available-offer-card" data-coupon-code="{{ section.settings.offer_4_code | escape }}" data-start-date="{{ section.settings.offer_4_start | default: '2024-01-01' | escape }}" data-end-date="{{ section.settings.offer_4_end | default: '2030-12-31' | escape }}">
                    <div class="offer-card-top">
                      <div class="offer-card-title">{{ section.settings.offer_4_title | default: "Special Offer" }}</div>
                      {% if section.settings.offer_4_desc != blank %}
                        <div class="offer-card-desc">{{ section.settings.offer_4_desc }}</div>
                      {% endif %}
                    </div>
                    <div class="offer-coupon-box">
                      <div class="offer-coupon-meta">
                        <span class="coupon-lbl">COUPON CODE</span>
                        <span class="coupon-code-val">{{ section.settings.offer_4_code }}</span>
                      </div>
                      <button type="button" class="btn-copy-coupon" onclick="copyOfferCoupon(this, '{{ section.settings.offer_4_code | escape }}')">COPY</button>
                    </div>
                  </div>
                {% endif %}
              {% endif %}
            </div>

            <!-- Dots Indicator for Multi-Offer Carousel -->
            <div class="offers-dots-indicator" id="offersDotsIndicator"></div>
          </div>
          {% endif %}

          <!-- Promo Banners -->
          {% if section.settings.show_promos %}
          <div class="product-promos">
            <div class="promo-box">
