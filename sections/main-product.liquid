  font-size: 0.7rem;
  color: #888;
  margin-top: 4px;
}
@media (max-width: 768px) {
  .order-toast-popup {
    bottom: 80px; /* Above mobile actions if any */
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Live Orders Counter
    let baseOrders = parseInt(localStorage.getItem('fakeOrdersCount')) || 1000;
    const orderCountEl = document.getElementById('liveOrderCount');
    
    if (orderCountEl) {
      orderCountEl.innerText = baseOrders;
    }
    
    setInterval(() => {
      baseOrders += 2;
      localStorage.setItem('fakeOrdersCount', baseOrders);
      if (orderCountEl) {
        orderCountEl.innerText = baseOrders;
      }
    }, 60000); // Every 1 minute

    // Order Received Toast
    const toast = document.getElementById('orderToastPopup');
    if(toast) {
      setInterval(() => {
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
        }, 5000); // Hide after 5 seconds
      }, 60000); // Show every 1 minute
    }

    // Available Offers Dynamic Date & Coupon Validation
    if (typeof window.filterActiveCouponOffers === 'function') {
      window.filterActiveCouponOffers();
    }
  });

  // Available Offers Single-Card Carousel Scrolling
  window.scrollOffersCarousel = function(btn, direction) {
    var section = btn.closest('.product-available-offers-section');
    var track = section ? section.querySelector('.available-offers-track') : document.getElementById('availableOffersTrack');
    if (!track) return;

    var cards = track.querySelectorAll('.available-offer-card:not([style*="display: none"])');
    if (cards.length <= 1) return;

    var cardWidth = track.clientWidth || 1;
    var currentScroll = track.scrollLeft;
    var currentIndex = Math.round(currentScroll / cardWidth);
    var nextIndex = currentIndex + direction;

    // Loop carousel around seamlessly
    if (nextIndex >= cards.length) {
      nextIndex = 0;
    } else if (nextIndex < 0) {
      nextIndex = cards.length - 1;
    }

    track.scrollTo({
      left: nextIndex * cardWidth,
      behavior: 'smooth'
    });

    setTimeout(function() {
      updateOffersCarouselState(nextIndex, cards.length);
    }, 150);
  };

  // Direct dot navigation
  window.goToOfferSlide = function(index) {
    var track = document.getElementById('availableOffersTrack');
    if (!track) return;
    var cardWidth = track.clientWidth || 1;
    track.scrollTo({
      left: index * cardWidth,
      behavior: 'smooth'
    });
    var cards = track.querySelectorAll('.available-offer-card:not([style*="display: none"])');
    updateOffersCarouselState(index, cards.length);
  };

  // Update badge and dots state
  function updateOffersCarouselState(activeIdx, total) {
    var badge = document.getElementById('offersCountBadge');
    if (badge && total > 1) {
      badge.innerText = (activeIdx + 1) + ' of ' + total;
      badge.style.display = 'inline-block';
    } else if (badge) {
      badge.style.display = 'none';
    }

    var dots = document.querySelectorAll('#offersDotsIndicator .offer-dot');
    dots.forEach(function(dot, idx) {
      if (idx === activeIdx) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });
  }

  // Copy Coupon Code to Clipboard with User Feedback
  window.copyOfferCoupon = function(btn, code) {
    if (!code) return;
    var originalText = btn.innerText;

    function markCopied() {
      btn.innerText = 'COPIED! ✓';
      btn.classList.add('copied');
      setTimeout(function() {
        btn.innerText = originalText;
        btn.classList.remove('copied');
      }, 2500);
    }

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(markCopied).catch(function() {
        fallbackCopy(code);
        markCopied();
      });
    } else {
      fallbackCopy(code);
      markCopied();
    }
  };

  function fallbackCopy(text) {
    var el = document.createElement('textarea');
    el.value = text;
    el.setAttribute('readonly', '');
    el.style.position = 'absolute';
    el.style.left = '-9999px';
    document.body.appendChild(el);
    el.select();
    try {
      document.execCommand('copy');
    } catch (e) {}
    document.body.removeChild(el);
  }

  // Dynamic Date and Coupon Presence Filtering
  window.filterActiveCouponOffers = function() {
    var now = new Date();
    var currentTimestamp = now.getTime();
    var visibleOffers = 0;

    var cards = document.querySelectorAll('.available-offer-card');
    cards.forEach(function(card) {
      var code = (card.getAttribute('data-coupon-code') || '').trim();
      var startDateStr = (card.getAttribute('data-start-date') || '').trim();
      var endDateStr = (card.getAttribute('data-end-date') || '').trim();

      // If coupon code is missing, do not show offer
      if (!code) {
        card.style.display = 'none';
        return;
      }

      var isValidDate = true;

      // Check start date (YYYY-MM-DD)
      if (startDateStr) {
        var start = new Date(startDateStr.indexOf('T') > -1 ? startDateStr : startDateStr + 'T00:00:00');
        if (!isNaN(start.getTime()) && currentTimestamp < start.getTime()) {
          isValidDate = false;
        }
      }

      // Check end date (YYYY-MM-DD)
      if (endDateStr) {
        var end = new Date(endDateStr.indexOf('T') > -1 ? endDateStr : endDateStr + 'T23:59:59');
        if (!isNaN(end.getTime()) && currentTimestamp > end.getTime()) {
          isValidDate = false;
        }
      }

      if (isValidDate) {
        card.style.display = 'flex';
        visibleOffers++;
      } else {
        card.style.display = 'none';
      }
    });

    // Handle section visibility
    var sections = document.querySelectorAll('.product-available-offers-section');
    sections.forEach(function(sec) {
      if (visibleOffers === 0) {
        sec.style.display = 'none';
      } else {
        sec.style.display = 'block';
      }
    });

    // Controls visibility and dynamic dots generation
    var navArrows = document.getElementById('offersNavArrows');
    var countBadge = document.getElementById('offersCountBadge');
    var dotsContainer = document.getElementById('offersDotsIndicator');

    if (visibleOffers > 1) {
      if (navArrows) navArrows.style.display = 'flex';
      if (countBadge) {
        countBadge.innerText = '1 of ' + visibleOffers;
        countBadge.style.display = 'inline-block';
      }
      if (dotsContainer) {
        dotsContainer.innerHTML = '';
        for (var i = 0; i < visibleOffers; i++) {
          var dot = document.createElement('span');
          dot.className = 'offer-dot' + (i === 0 ? ' active' : '');
          dot.setAttribute('onclick', 'goToOfferSlide(' + i + ')');
          dot.setAttribute('aria-label', 'Go to offer ' + (i + 1));
          dotsContainer.appendChild(dot);
        }
        dotsContainer.style.display = 'flex';
      }
    } else {
      if (navArrows) navArrows.style.display = 'none';
      if (countBadge) countBadge.style.display = 'none';
      if (dotsContainer) dotsContainer.style.display = 'none';
    }

    // Attach scroll listener to update dots on touch swipe
    var track = document.getElementById('availableOffersTrack');
    if (track && !track._hasScrollListener) {
      track._hasScrollListener = true;
      var scrollTimer = null;
      track.addEventListener('scroll', function() {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(function() {
          var w = track.clientWidth || 1;
          var activeIdx = Math.round(track.scrollLeft / w);
          updateOffersCarouselState(activeIdx, visibleOffers);
        }, 80);
      });
    }
  };

  // Immediate execution for fast rendering
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
