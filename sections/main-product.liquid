<!-- Lightbox Modal Component -->
<div class="product-lightbox-modal" id="productLightboxModal" aria-hidden="true" role="dialog" aria-label="Product Gallery Lightbox">
  <div class="lightbox-backdrop" id="lightboxBackdrop"></div>
  
  <div class="lightbox-dialog">
    <!-- Top Bar -->
    <div class="lightbox-topbar">
      <div class="lightbox-counter" id="lightboxCounter">1 / {{ media_items.size | default: 1 }}</div>
      <div class="lightbox-top-actions">
        <button type="button" class="lightbox-btn" id="lightboxZoomToggle" aria-label="Toggle zoom" title="Toggle zoom">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>
        <button type="button" class="lightbox-btn" id="lightboxCloseBtn" aria-label="Close lightbox" title="Close (Esc)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Viewport with Nav Arrows -->
    <div class="lightbox-viewport">
      <button type="button" class="lightbox-nav-btn lightbox-prev" id="lightboxPrevBtn" aria-label="Previous image">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

      <div class="lightbox-image-stage" id="lightboxImageStage">
        <img src="" alt="{{ product.title | escape }}" id="lightboxImg">
      </div>

      <button type="button" class="lightbox-nav-btn lightbox-next" id="lightboxNextBtn" aria-label="Next image">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>

    <!-- Bottom Thumbnail Strip -->
    <div class="lightbox-bottom-strip" id="lightboxBottomStrip">
      {% for item in media_items %}
        {% assign item_image = item.preview_image | default: item %}
        <div class="lightbox-thumb {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
          <img src="{{ item_image | image_url: width: 140 }}" alt="Slide {{ forloop.index }}">
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Variant pack card selector and image switcher
    document.querySelectorAll('.variant-box').forEach(box => {
      box.addEventListener('click', function(e) {
        document.querySelectorAll('.variant-box').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        
        const input = this.querySelector('input[type="radio"]');
        if (input) {
          input.checked = true;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }

        const priceElement = document.querySelector('.price-large-new');
        const compareElement = document.querySelector('.price-compare-new');
        const mrpWrap = document.querySelector('.price-mrp-wrap');
        const discountElement = document.querySelector('.price-discount-new');
        
        if (input && input.dataset.price) {
          const priceNum = parseInt(input.dataset.price);
          const compareNum = input.dataset.compare ? parseInt(input.dataset.compare) : 0;
          const price = (priceNum / 100).toLocaleString('en-IN', {
            style: 'currency',
            currency: 'INR',
            maximumFractionDigits: 0
          });
          if(priceElement) priceElement.textContent = price;

          if (compareNum > priceNum) {
            const comparePrice = (compareNum / 100).toLocaleString('en-IN', {
              style: 'currency',
              currency: 'INR',
              maximumFractionDigits: 0
            });
            if(compareElement) compareElement.textContent = comparePrice;
            if(mrpWrap) mrpWrap.style.display = 'inline-flex';
            
            const discountPct = Math.round(((compareNum - priceNum) * 100) / compareNum);
            if(discountElement) {
              discountElement.textContent = discountPct + '% OFF';
              discountElement.style.display = 'inline-block';
            }
          } else {
            if(mrpWrap) mrpWrap.style.display = 'none';
            if(discountElement) discountElement.style.display = 'none';
          }
        }

        // Switch variant image on PDP when variant has an image
        if (input && input.dataset.image) {
          const mainImg = document.getElementById('mainProductImg');
          if (mainImg) {
            mainImg.src = input.dataset.image;
          }

          const imageId = input.dataset.imageId;
          const thumbs = document.querySelectorAll('.thumbs-list .thumb');
          thumbs.forEach((thumb, idx) => {
            const thumbMatch = (imageId && thumb.dataset.id === imageId) ||
                               (thumb.dataset.full && thumb.dataset.full.includes(input.dataset.image.split('?')[0].split('/').pop()));
            if (thumbMatch) {
              if (typeof window.goToSlide === 'function') {
                window.goToSlide(idx);
              } else {
                thumbs.forEach(t => t.classList.remove('active'));
                thumb.classList.add('active');
                thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
              }
            }
          });
        }
      });
    });

    // Gallery Carousel & Lightbox Logic
    const mainImg = document.getElementById('mainProductImg');
    const mainBox = document.getElementById('mainImageBox');
    const prevMainBtn = document.getElementById('mainCarouselPrevBtn');
    const nextMainBtn = document.getElementById('mainCarouselNextBtn');
    const btnLightbox = document.getElementById('btnLightboxTrigger');

    const galleryContainer = document.getElementById('thumbsCarouselContainer');
    const prevThumbBtn = document.getElementById('prevThumbBtn');
    const nextThumbBtn = document.getElementById('nextThumbBtn');
    const allGalleryThumbs = Array.from(document.querySelectorAll('.thumbs-list .thumb'));

    // Lightbox elements
    const lightboxModal = document.getElementById('productLightboxModal');
    const lightboxBackdrop = document.getElementById('lightboxBackdrop');
    const lightboxCloseBtn = document.getElementById('lightboxCloseBtn');
    const lightboxPrevBtn = document.getElementById('lightboxPrevBtn');
    const lightboxNextBtn = document.getElementById('lightboxNextBtn');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxCounter = document.getElementById('lightboxCounter');
    const lightboxZoomToggle = document.getElementById('lightboxZoomToggle');
    const lightboxImageStage = document.getElementById('lightboxImageStage');
    const lightboxBottomStrip = document.getElementById('lightboxBottomStrip');

    let currentIndex = 0;
    const totalSlides = allGalleryThumbs.length;

    // Go to slide function
    window.goToSlide = function(index, smoothScroll = true) {
      if (totalSlides === 0) return;
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;

      const activeThumb = allGalleryThumbs[currentIndex];
      if (!activeThumb) return;

      const fullSrc = activeThumb.dataset.full;

      if (mainImg && fullSrc) {
        mainImg.style.opacity = '0.3';
        mainImg.src = fullSrc;
        mainImg.onload = function() {
          mainImg.style.opacity = '1';
        };
      }

      allGalleryThumbs.forEach((t, i) => {
        if (i === currentIndex) {
          t.classList.add('active');
          if (smoothScroll) {
            t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        } else {
          t.classList.remove('active');
        }
      });

      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll('.main-carousel-dot');
        dots.forEach((d, i) => d.classList.toggle('active', i === currentIndex));
      }

      if (lightboxModal && lightboxModal.classList.contains('active')) {
        updateLightboxSlide();
      }
    };

    if (prevMainBtn) {
      prevMainBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        window.goToSlide(currentIndex - 1);
      });
    }

    if (nextMainBtn) {
      nextMainBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        window.goToSlide(currentIndex + 1);
      });
    }

    allGalleryThumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', function() {
        window.goToSlide(i);
      });
    });

    if (galleryContainer && allGalleryThumbs.length > 0) {
      function updateGalleryArrows() {
        const maxScroll = galleryContainer.scrollWidth - galleryContainer.clientWidth;
        if (maxScroll <= 4) {
          if (prevThumbBtn) prevThumbBtn.style.display = 'none';
          if (nextThumbBtn) nextThumbBtn.style.display = 'none';
          return;
        } else {
          if (prevThumbBtn) prevThumbBtn.style.display = 'flex';
          if (nextThumbBtn) nextThumbBtn.style.display = 'flex';
        }

        if (galleryContainer.scrollLeft <= 5) {
          if (prevThumbBtn) {
            prevThumbBtn.disabled = true;
            prevThumbBtn.classList.add('disabled');
          }
        } else {
          if (prevThumbBtn) {
            prevThumbBtn.disabled = false;
            prevThumbBtn.classList.remove('disabled');
          }
        }

        if (galleryContainer.scrollLeft >= maxScroll - 5) {
          if (nextThumbBtn) {
            nextThumbBtn.disabled = true;
            nextThumbBtn.classList.add('disabled');
          }
        } else {
          if (nextThumbBtn) {
            nextThumbBtn.disabled = false;
            nextThumbBtn.classList.remove('disabled');
          }
        }
      }

      function getThumbScrollStep() {
        const first = allGalleryThumbs[0];
        if (first && first.offsetWidth > 0) {
          return first.offsetWidth + 12;
        }
        return galleryContainer.clientWidth / 4;
      }

      if (prevThumbBtn) {
        prevThumbBtn.addEventListener('click', function(e) {
          e.preventDefault();
          galleryContainer.scrollBy({ left: -getThumbScrollStep(), behavior: 'smooth' });
        });
      }

      if (nextThumbBtn) {
        nextThumbBtn.addEventListener('click', function(e) {
          e.preventDefault();
          galleryContainer.scrollBy({ left: getThumbScrollStep(), behavior: 'smooth' });
        });
      }

      galleryContainer.addEventListener('scroll', updateGalleryArrows);
      window.addEventListener('resize', updateGalleryArrows);
      setTimeout(updateGalleryArrows, 150);
    }

    // Touch swipe on main image
    if (mainBox) {
      let touchStartX = 0;
      let touchStartY = 0;
      let touchEndX = 0;
      let touchEndY = 0;

      mainBox.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      mainBox.addEventListener('touchend', function(e) {
        touchEndX = e.changedTouches[0].screenX;
        touchEndY = e.changedTouches[0].screenY;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;

        if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
          if (diffX < 0) {
            window.goToSlide(currentIndex + 1);
          } else {
            window.goToSlide(currentIndex - 1);
          }
        }
      }, { passive: true });
    }

    // Lightbox Controller
    function openLightbox() {
      if (!lightboxModal) return;
      lightboxModal.classList.add('active');
      lightboxModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      updateLightboxSlide();
    }

    function closeLightbox() {
      if (!lightboxModal) return;
      lightboxModal.classList.remove('active');
      lightboxModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lightboxImageStage) lightboxImageStage.classList.remove('zoomed');
    }

    function updateLightboxSlide() {
      const activeThumb = allGalleryThumbs[currentIndex];
      if (!activeThumb) return;

      const fullSrc = activeThumb.dataset.full;
      if (lightboxImg && fullSrc) {
        lightboxImg.style.opacity = '0.3';
        lightboxImg.src = fullSrc;
        lightboxImg.onload = function() {
          lightboxImg.style.opacity = '1';
        };
      }

      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${totalSlides}`;
      }

      if (lightboxBottomStrip) {
        const stripThumbs = lightboxBottomStrip.querySelectorAll('.lightbox-thumb');
        stripThumbs.forEach((st, i) => {
          st.classList.toggle('active', i === currentIndex);
          if (i === currentIndex) {
            st.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        });
      }

      if (lightboxImageStage) {
        lightboxImageStage.classList.remove('zoomed');
      }
    }

    if (btnLightbox) {
      btnLightbox.addEventListener('click', function(e) {
        e.stopPropagation();
        openLightbox();
      });
    }

    if (mainImg) {
      mainImg.addEventListener('click', function(e) {
        openLightbox();
      });
    }

    if (lightboxCloseBtn) lightboxCloseBtn.addEventListener('click', closeLightbox);
    if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);

    if (lightboxPrevBtn) {
      lightboxPrevBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        window.goToSlide(currentIndex - 1);
      });
    }

    if (lightboxNextBtn) {
      lightboxNextBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        window.goToSlide(currentIndex + 1);
      });
    }

    if (lightboxZoomToggle && lightboxImageStage) {
      lightboxZoomToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        lightboxImageStage.classList.toggle('zoomed');
      });

      lightboxImageStage.addEventListener('click', function(e) {
        if (e.target === lightboxImg) {
          lightboxImageStage.classList.toggle('zoomed');
        }
      });
    }

    if (lightboxBottomStrip) {
      const stripThumbs = lightboxBottomStrip.querySelectorAll('.lightbox-thumb');
      stripThumbs.forEach((st, i) => {
        st.addEventListener('click', function(e) {
          e.stopPropagation();
          window.goToSlide(i);
        });
      });
    }

    document.addEventListener('keydown', function(e) {
      if (!lightboxModal || !lightboxModal.classList.contains('active')) return;
      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === 'ArrowLeft') {
        window.goToSlide(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        window.goToSlide(currentIndex + 1);
      }
    });

    if (lightboxImageStage) {
      let lbStartX = 0;
      let lbEndX = 0;
      lightboxImageStage.addEventListener('touchstart', function(e) {
        lbStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      lightboxImageStage.addEventListener('touchend', function(e) {
        lbEndX = e.changedTouches[0].screenX;
        const diffX = lbEndX - lbStartX;
        if (Math.abs(diffX) > 40) {
          if (diffX < 0) window.goToSlide(currentIndex + 1);
          else window.goToSlide(currentIndex - 1);
        }
      }, { passive: true });
    }
  });
</script>

