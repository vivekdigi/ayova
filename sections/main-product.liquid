{% comment %}
  AYOVA PRODUCT DETAIL MAIN SECTION - Redesigned Layout
{% endcomment %}

<div class="section-padding product-page">
  <div class="container">
    
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="breadcrumbs">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/collections/all">Shop</a>
      <span aria-hidden="true">/</span>
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-main-grid">
      
      <!-- Left Column: Product Gallery -->
      <div class="product-gallery-wrapper">
        <div class="gallery-inner">
          
          <!-- Vertical Thumbnails -->
          <div class="gallery-vertical-thumbs">
            <button class="thumb-nav-btn" aria-label="Previous image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 15l-6-6-6 6"/></svg>
            </button>
            
            <div class="thumbs-list">
              {% for image in product.images %}
                <img src="{{ image | image_url: width: 200 }}" alt="{{ product.title | escape }}" class="thumb {% if forloop.first %}active{% endif %}" onclick="document.getElementById('mainProductImg').src=this.dataset.full; document.querySelectorAll('.thumbs-list .thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');" data-full="{{ image | image_url: width: 800 }}">
              {% endfor %}
            </div>

            <button class="thumb-nav-btn" aria-label="Next image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="thumb-count">1/{{ product.images.size }}</div>
          </div>

          <!-- Main Image -->
          <div class="main-image-box">
            <div class="main-image-top-badges">
              <span class="badge badge-bestseller">BESTSELLER</span>
              <button class="btn-wishlist" aria-label="Add to Wishlist">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              </button>
            </div>
            
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" id="mainProductImg">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            
            <div class="main-image-text">
              <h3>{{ product.metafields.custom.subtitle | default: 'PREMIUM AYURVEDIC FORMULATION' }}</h3>
              <p class="hover-zoom-text">Hover to zoom • Swipe for more views</p>
              <div class="secure-pack-text">Original Ayova product • Securely packed</div>
            </div>
          </div>
        </div>

        <!-- Image Navigation Pills -->
        <div class="gallery-pills-wrapper">
          <div class="gallery-pills">
            {% assign pill_count = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'gallery_pill' %}
                <button class="gallery-pill {% if pill_count == 0 %}active{% endif %}" onclick="showGalleryPillContent({{ forloop.index0 }})" {{ block.shopify_attributes }}>{{ block.settings.title }}</button>
                {% assign pill_count = pill_count | plus: 1 %}
              {% endif %}
            {% endfor %}

            {% if pill_count == 0 %}
              <button class="gallery-pill active">Front View</button>
              <button class="gallery-pill">Label Detail</button>
              <button class="gallery-pill">Lifestyle</button>
              <button class="gallery-pill">Benefits</button>
            {% endif %}
          </div>
          
          <div class="gallery-pill-contents">
            {% assign pill_count = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'gallery_pill' %}
                <div class="gallery-pill-content {% if pill_count == 0 %}active{% endif %}" id="pill-content-{{ forloop.index0 }}">
                  {% if block.settings.description != blank %}
                    {{ block.settings.description }}
                  {% endif %}
                </div>
                {% assign pill_count = pill_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <script>
          function showGalleryPillContent(index) {
            const pills = document.querySelectorAll('.gallery-pills-wrapper .gallery-pill');
            const contents = document.querySelectorAll('.gallery-pills-wrapper .gallery-pill-content');
            
            pills.forEach((el, i) => {
              if(i === index) el.classList.add('active');
              else el.classList.remove('active');
            });
            contents.forEach((el, i) => {
              if(i === index) el.classList.add('active');
              else el.classList.remove('active');
            });
          }
        </script>
      </div>

      <!-- Right Column: Product Details & Purchase Form -->
      <div class="product-details-wrapper">
        <div class="details-header">
          {% if product.type != blank %}
            <span class="badge badge-category-light">{{ product.type | upcase }}</span>
          {% endif %}
          <h1 class="product-title-new">{{ product.title }}</h1>
          
          <div class="product-reviews-row-new">
            <span class="rating-stars-new">★★★★★</span>
            <span class="rating-text-new">4.9 • <span class="verified-text">1,248 verified reviews</span></span>
          </div>

          {% comment %}
          <div class="live-orders-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            <span id="liveOrderCount">1000</span> orders received today!
          </div>
          {% endcomment %}
        </div>

        <div class="product-price-wrapper">
          <div class="product-price-box-new">
            {% if product.compare_at_price > product.price %}
              <span class="price-mrp-wrap">MRP : <span class="price-compare-new">{{ product.compare_at_price | money }}</span></span>
            {% endif %}
            <span class="price-large-new">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="price-discount-new">{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% OFF</span>
            {% endif %}
          </div>
          
          {% if product.metafields.custom.per_count_price != blank %}
            <div class="product-per-count-price" style="font-size: 0.9rem; color: #666; margin-top: 4px; margin-bottom: 4px;">
              ({{ product.metafields.custom.per_count_price }})
            </div>
          {% endif %}

          <div class="gst-label-new">Inclusive of all taxes</div>
        </div>

        {% if product.description != blank %}
          <div class="product-subtitle">{{ product.description | strip_html | truncatewords: 35 }}</div>
        {% endif %}

        <!-- Feature List -->
        <div class="why-love-it">
          <h4>Why you'll love it</h4>
          <ul class="feature-list">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Supports healthy liver function
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Standardized to 80% Silymarin
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Helps natural detox pathways
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Vegetarian capsules • 60 count
            </li>
          </ul>
        </div>

        <!-- Add to Cart Form -->
        <form action="/cart/add" method="post" enctype="multipart/form-data" class="product-form" data-product-form onsubmit="event.preventDefault(); var btn = event.submitter || this.querySelector('button[type=submit]'); if(btn.dataset.added === 'true') { window.location.href='/cart'; return; } btn.innerHTML = 'Adding...'; btn.disabled = true; fetch('/cart/add.js', { method: 'POST', body: new FormData(this) }).then(res=>res.json()).then(data=>{ btn.innerHTML = 'View Cart'; btn.disabled = false; btn.dataset.added = 'true'; }).catch(err => { btn.innerHTML = 'Error'; btn.disabled = false; });">
          <!-- Choose Pack / Variants -->
          <div class="variant-picker-new">
            <h4 class="variant-label-new">SELECT SIZE</h4>
            
            <div class="variant-options-grid pill-style">
              {% if product.has_only_default_variant %}
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              {% else %}
                {% for variant in product.variants %}
                  <label class="variant-box pill-box {% if forloop.first %}active{% endif %}">
                    <input type="radio" name="id" value="{{ variant.id }}" {% if forloop.first %}checked{% endif %} class="hidden-radio" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price }}">
                    <span class="box-title">{{ variant.title }}</span>
                  </label>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <!-- Promo Banners -->
          <div class="product-promos">
            <div class="promo-box">
              🎁 {{ section.settings.promo_1_text | default: "Get a Free Wellness Sipper worth Rs. 300 if your cart has 'Ayova Milk Thistle' and your cart value is ₹999 or above" }} 🎁
            </div>
            <div class="promo-box">
              🎁 {{ section.settings.promo_2_text | default: "Get a FREE Ayova Herbal Tea (worth ₹499) on orders of ₹1495 or more!" }} 🎁
            </div>
          </div>

          <!-- Product Info Grid -->
          <div class="product-info-grid">
            <div class="info-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"></line></svg>
              <p>{{ section.settings.feature_1_text | default: "Contains pure Ayurvedic herbs and standardized extracts that support your everyday wellness" }}</p>
            </div>
            <div class="info-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5"><rect x="4" y="6" width="16" height="12" rx="6"></rect><line x1="12" y1="6" x2="12" y2="18"></line></svg>
              <p>{{ section.settings.feature_2_text | default: "Authentic classical formulation made in India, customized for optimal bioavailability" }}</p>
            </div>
            <div class="info-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5"><path d="M10 2v7.31"></path><path d="M14 9.3V1.99"></path><path d="M8.5 2h7"></path><path d="M14 9.3a6.5 6.5 0 1 1-4 0"></path><path d="M5.52 16h12.96"></path></svg>
              <p>{{ section.settings.feature_3_text | default: "Scientifically backed botanicals to help you achieve your health goals naturally" }}</p>
            </div>
          </div>

          <!-- Trust Badges Block -->
          <div class="product-trust-block">
            <div class="trust-feat">
              <div class="tf-icon" style="background-color: #c94c66;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg></div>
              <span>{{ section.settings.trust_1_text }}</span>
            </div>
            <div class="trust-feat">
              <div class="tf-icon" style="background-color: #ff9e2a;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div>
              <span>{{ section.settings.trust_2_text }}</span>
            </div>
            <div class="trust-feat">
              <div class="tf-icon" style="background-color: #22a855;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
              <span>{{ section.settings.trust_3_text }}</span>
            </div>
            <div class="trust-feat">
              <div class="tf-icon" style="background-color: #1994d1;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></div>
              <span>{{ section.settings.trust_4_text }}</span>
            </div>
          </div>

          <!-- Quantity and Buttons -->
          {%- assign amazon_link = product.metafields.custom.amazon_link.value | default: product.metafields.custom.amazon_link -%}
          {%- if amazon_link == blank -%}
            {%- assign amazon_link = product.metafields.custom.amazon_url.value | default: product.metafields.custom.amazon_url -%}
          {%- endif -%}
          {%- if amazon_link == blank -%}
            {%- assign amazon_link = product.metafields.custom.amazon_product_link.value | default: product.metafields.custom.amazon_product_link -%}
          {%- endif -%}
          {%- if amazon_link == blank -%}
            {%- assign amazon_link = product.metafields.custom.amazon.value | default: product.metafields.custom.amazon -%}
          {%- endif -%}
          {%- if amazon_link == blank and product.tags != blank -%}
            {%- for tag in product.tags -%}
              {%- assign tag_lower = tag | downcase -%}
              {%- if tag_lower contains 'amazon:' -%}
                {%- assign amazon_link = tag | remove_first: 'amazon:' | strip -%}
                {%- break -%}
              {%- elsif tag_lower contains 'amazon_link:' -%}
                {%- assign amazon_link = tag | remove_first: 'amazon_link:' | strip -%}
                {%- break -%}
              {%- elsif tag_lower contains 'amazon_url:' -%}
                {%- assign amazon_link = tag | remove_first: 'amazon_url:' | strip -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if amazon_link != blank -%}
            {%- unless amazon_link contains 'http://' or amazon_link contains 'https://' -%}
              {%- assign amazon_link = 'https://' | append: amazon_link -%}
            {%- endunless -%}
          {%- endif -%}

          {%- assign flipkart_link = product.metafields.custom.flipkart_link.value | default: product.metafields.custom.flipkart_link -%}
          {%- if flipkart_link == blank -%}
            {%- assign flipkart_link = product.metafields.custom.flipkart_url.value | default: product.metafields.custom.flipkart_url -%}
          {%- endif -%}
          {%- if flipkart_link == blank -%}
            {%- assign flipkart_link = product.metafields.custom.flipkart.value | default: product.metafields.custom.flipkart -%}
          {%- endif -%}
          {%- if flipkart_link == blank and product.tags != blank -%}
            {%- for tag in product.tags -%}
              {%- assign tag_lower = tag | downcase -%}
              {%- if tag_lower contains 'flipkart:' -%}
                {%- assign flipkart_link = tag | remove_first: 'flipkart:' | strip -%}
                {%- break -%}
              {%- elsif tag_lower contains 'flipkart_link:' -%}
                {%- assign flipkart_link = tag | remove_first: 'flipkart_link:' | strip -%}
                {%- break -%}
              {%- elsif tag_lower contains 'flipkart_url:' -%}
                {%- assign flipkart_link = tag | remove_first: 'flipkart_url:' | strip -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if flipkart_link != blank -%}
            {%- unless flipkart_link contains 'http://' or flipkart_link contains 'https://' -%}
              {%- assign flipkart_link = 'https://' | append: flipkart_link -%}
            {%- endunless -%}
          {%- endif -%}

          {%- assign redirect_val = product.metafields.custom.enable_redirect.value | default: product.metafields.custom.enable_redirect -%}
          {%- assign is_redirect_true = false -%}
          {%- if redirect_val == true or redirect_val == 'true' or redirect_val == 'True' or redirect_val == 1 or redirect_val == '1' -%}
            {%- assign is_redirect_true = true -%}
          {%- endif -%}

          {% if is_redirect_true and (flipkart_link != blank or amazon_link != blank) %}
            <div class="purchase-actions-row redirect-row">
              {% if flipkart_link != blank %}
                <a href="{{ flipkart_link }}" target="_blank" rel="noopener noreferrer" class="btn-buy-now flipkart-btn">
                  BUY ON FLIPKART
                </a>
              {% endif %}
              {% if amazon_link != blank %}
                <a href="{{ amazon_link }}" target="_blank" rel="noopener noreferrer" class="btn-buy-now amazon-btn">
                  BUY ON AMAZON
                </a>
              {% endif %}
            </div>
          {% else %}
            <div class="purchase-actions-row">
              <div class="quantity-selector-new">
                <button type="button" class="qty-btn" onclick="let q=document.getElementById('pQty'); if(q.value>1)q.value--;">-</button>
                <input type="number" name="quantity" id="pQty" value="1" min="1" readonly>
                <button type="button" class="qty-btn" onclick="let q=document.getElementById('pQty'); q.value++;">+</button>
              </div>

              <button type="submit" name="add" class="btn-add-cart-new" data-add-to-cart>
                ADD TO CART
              </button>
              
              <button type="submit" class="btn-buy-now">
                BUY NOW
              </button>
            </div>

            {%- if amazon_link != blank or flipkart_link != blank -%}
              {% render 'marketplace-buttons', amazon_link: amazon_link, flipkart_link: flipkart_link, context: 'product-page' %}
            {%- endif -%}
          {% endif %}
          
          <div class="shipping-notice">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D35F3C" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            {{ section.settings.shipping_text | default: "Free shipping above ₹499 - COD available" }}
          </div>
        </form>

      </div>
    </div>

    <!-- Trust Badges Strip -->
    <div class="trust-badges-strip">
      <div class="trust-item"><img src="https://cdn.shopify.com/s/files/1/0612/8150/1402/files/fssai.png?v=1648011234" alt="" onerror="this.style.display='none'"> <span>FSSAI Approved</span></div>
      <div class="trust-item"><img src="https://cdn.shopify.com/s/files/1/0612/8150/1402/files/gmp.png?v=1648011234" alt="" onerror="this.style.display='none'"> <span>GMP Certified</span></div>
      <div class="trust-item"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> <span>Vegetarian</span></div>
      <div class="trust-item"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg> <span>Easy Returns</span></div>
      <div class="trust-item"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg> <span>Expert Support</span></div>
    </div>

    <!-- Product Details Tabs Section -->
    <div class="product-tabs-section">
      <div class="tabs-header-text">
        <h5 class="tabs-eyebrow">PRODUCT DETAILS</h5>
        <h2 class="tabs-title">Everything you need to know</h2>
        <p class="tabs-subtitle">A focused, transparent formulation designed for everyday liver wellness.</p>
      </div>

      <div class="product-tabs" data-tabs>
        <div class="tab-nav">
          <button class="tab-btn active" data-tab="overview">OVERVIEW</button>
          <button class="tab-btn" data-tab="mf-benefits">BENEFITS</button>
          <button class="tab-btn" data-tab="mf-ingredients">INGREDIENTS</button>
          <button class="tab-btn" data-tab="mf-how-to-use">HOW TO USE</button>



        </div>

        <div class="overview-grid">
          <div class="overview-left">
            <div class="tab-content active" data-tab-content="overview">
              {% if product.description != blank %}
                <div class="product-description rte">
                  {{ product.description }}
                </div>
              {% else %}
                <h3>Daily liver support, without unnecessary complexity.</h3>
                <p>Ayova Milk Thistle combines a concentrated 30:1 extract standardized to 80% Silymarin. This single-ingredient formula is designed to support healthy liver function, antioxidant protection and the body's natural detox pathways.</p>
              {% endif %}
              
              <div class="stats-boxes">
                <div class="stat-box">
                  <strong>30:1</strong>
                  <span>Concentrated extract</span>
                </div>
                <div class="stat-box">
                  <strong>80%</strong>
                  <span>Standardized Silymarin</span>
                </div>
                <div class="stat-box">
                  <strong>60</strong>
                  <span>Vegetarian capsules</span>
                </div>
              </div>
            </div>

            <div class="tab-content" data-tab-content="mf-benefits">
              <div class="rte">
                {% if product.metafields.custom.benefits_tab != blank %}
                  {{ product.metafields.custom.benefits_tab | metafield_tag }}
                {% else %}
                  <p>Experience the natural benefits of Ayova wellness products, formulated to support your everyday health and vitality.</p>
                {% endif %}
              </div>
            </div>
            
            <div class="tab-content" data-tab-content="mf-ingredients">
              <div class="rte">
                {% if product.metafields.custom.ingredients_tabs != blank %}
                  {{ product.metafields.custom.ingredients_tabs | metafield_tag }}
                {% else %}
                  <p>Formulated with pure, authentic Ayurvedic herbs and standardized botanical extracts. No hidden fillers or artificial blends.</p>
                {% endif %}
              </div>
            </div>
            
            <div class="tab-content" data-tab-content="mf-how-to-use">
              <div class="rte">
                {% if product.metafields.custom.how_to_use != blank %}
                  {{ product.metafields.custom.how_to_use | metafield_tag }}
                {% else %}
                  <p>Take one capsule daily after a meal, or as directed by your healthcare professional. Consistency is key for optimal results.</p>
                {% endif %}
              </div>
            </div>
            



          </div>
          
          <div class="overview-right">
            <h3>Made for your daily routine</h3>
            <ul class="routine-list">
              <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D35F3C" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> One capsule daily after a meal</li>
              <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D35F3C" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> No added fillers or complex blends</li>
