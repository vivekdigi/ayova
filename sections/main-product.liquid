<style>
.live-orders-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #fdf3f2;
  border: 1px solid #fadbd8;
  color: #e74c3c;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
  margin-top: 10px;
  margin-bottom: 20px;
}
.order-toast-popup {
  position: fixed;
  bottom: 20px;
  left: 20px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  width: 300px;
  transform: translateY(100px);
  opacity: 0;
  visibility: hidden;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  z-index: 9999;
  border: 1px solid #eaeaea;
}
.order-toast-popup.show {
  transform: translateY(0);
  opacity: 1;
  visibility: visible;
}
.toast-img img {
  width: 48px;
  height: 48px;
  border-radius: 6px;
  object-fit: cover;
}
.toast-text {
  display: flex;
  flex-direction: column;
}
.toast-text strong {
  font-size: 0.85rem;
  color: var(--color-forest-dark);
}
.toast-text span {
  font-size: 0.8rem;
  color: #555;
  margin-top: 2px;
}
.toast-text small {
  font-size: 0.7rem;
  color: #888;
  margin-top: 4px;
}
@media (max-width: 768px) {
  .order-toast-popup {
    bottom: 80px; /* Above mobile actions if any */
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Live Orders Counter
    let baseOrders = parseInt(localStorage.getItem('fakeOrdersCount')) || 1000;
    const orderCountEl = document.getElementById('liveOrderCount');
    
    if (orderCountEl) {
      orderCountEl.innerText = baseOrders;
    }
    
    setInterval(() => {
      baseOrders += 2;
      localStorage.setItem('fakeOrdersCount', baseOrders);
      if (orderCountEl) {
        orderCountEl.innerText = baseOrders;
      }
    }, 60000); // Every 1 minute

    // Order Received Toast
    const toast = document.getElementById('orderToastPopup');
    if(toast) {
      setInterval(() => {
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
        }, 5000); // Hide after 5 seconds
      }, 60000); // Show every 1 minute
    }
  });
</script>