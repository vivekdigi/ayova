      .floating-product-video {
        bottom: calc(115px + env(safe-area-inset-bottom, 0px));
        left: 14px;
        width: 65px;
        height: 65px;
        border-radius: 50%;
        aspect-ratio: 1/1;
        box-shadow: 0 4px 14px rgba(0,0,0,0.3);
      }
      .floating-product-video video {
        border-radius: 50%;
      }
      .floating-product-video.expanded {
        width: 140px;
        height: auto;
        aspect-ratio: 9/16;
        border-radius: 12px;
      }
      .floating-product-video.expanded video {
        border-radius: 12px;
      }
      .floating-product-video.minimized {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        aspect-ratio: 1/1;
      }
      .floating-video-sound-toggle {
        display: none;
      }
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var videoContainer = document.getElementById('floatingProductVideo');
      var toggleBtn = document.getElementById('floatingVideoToggle');
      var soundBtn = document.getElementById('floatingSoundBtn');
      var videoEl = document.querySelector('.floating-video-element');
      
      if(videoContainer && toggleBtn) {
        if (window.innerWidth <= 768) {
          videoContainer.classList.add('minimized');
          toggleBtn.innerHTML = '+';
          toggleBtn.setAttribute('aria-label', 'Maximize video');
        }
        toggleBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          videoContainer.classList.toggle('minimized');
          if(videoContainer.classList.contains('minimized')) {
            videoContainer.classList.remove('expanded');
            toggleBtn.innerHTML = '+';
            toggleBtn.setAttribute('aria-label', 'Maximize video');
          } else {
            videoContainer.classList.add('expanded');
            toggleBtn.innerHTML = '−';
            toggleBtn.setAttribute('aria-label', 'Minimize video');
          }
        });
      }
      
      if(soundBtn && videoEl) {
        soundBtn.addEventListener('click', function(e) {
          e.preventDefault();
          videoEl.muted = !videoEl.muted;
          this.innerHTML = videoEl.muted ? '🔇' : '🔊';
        });
      }
      
      if(videoEl) {
        videoEl.addEventListener('click', function() {
          if (videoEl.paused) {
            videoEl.play();
          } else {
            videoEl.pause();
          }
        });
      }
    });
  </script>
{% endif %}

