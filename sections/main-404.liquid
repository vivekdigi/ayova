{% endcomment %}

<section class="section-padding main-404-section text-center" style="padding: 100px 0;">
  <div class="container" style="max-width: 600px;">
    <span class="badge badge-accent" style="font-size: 1rem; padding: 6px 16px;">ERROR 404</span>
    <h1 class="page-title" style="font-family: var(--font-serif); font-size: 3rem; margin: 16px 0;">
      Page Not Found
    </h1>
    <p class="section-subtitle" style="margin-bottom: 32px; font-size: 1.1rem; color: var(--color-text-muted);">
      The page you were looking for does not exist or has been moved. Explore our authentic Ayurvedic formulations below.
    </p>
    <a href="/" class="btn btn-primary btn-hero">
      Return to Homepage →
    </a>
  </div>
</section>

