{% comment %}
  AYOVA CUSTOM CHECKOUT & PAYMENT SECTION
  Figma Spec: 3-Step Progress (01 Contact, 02 Delivery Address, 03 Payment Method: UPI, Card, NetBanking, COD) + Order Summary Sidebar
{% endcomment %}

<div class="section-padding checkout-page">
  {% if customer %}
  <div class="container checkout-main-content">
    
    <!-- Checkout Breadcrumb & Header -->
    <div class="checkout-header-row">
      <div>
        <span class="checkout-breadcrumb">Home / Cart / Checkout</span>
        <h1 class="checkout-title">Secure Checkout</h1>
        <p class="checkout-subtitle">Complete your delivery details and choose a payment method.</p>
      </div>
    </div>

    <!-- 3-Step Progress Indicator -->
    <div class="checkout-steps-bar">
      <div class="step-item step-completed">
        <span class="step-circle">✓</span>
        <span class="step-label">CART</span>
      </div>
      <div class="step-connector active"></div>
      <div class="step-item step-active">
        <span class="step-circle">2</span>
        <span class="step-label">CHECKOUT</span>
      </div>
      <div class="step-connector"></div>
      <div class="step-item">
        <span class="step-circle">3</span>
        <span class="step-label">PAYMENT</span>
      </div>
    </div>

    <!-- Main Checkout Grid -->
    <div class="checkout-grid">
      
      <!-- Left Form Panels -->
      <div class="checkout-forms">
        
        <!-- Step 1: Contact Details -->
        <div class="checkout-card">
          <div class="card-step-header">
            <span class="step-num">01</span>
            <div>
              <h3 class="step-title">Contact details</h3>
              <p class="step-desc">We’ll use these details for order and delivery updates.</p>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label">EMAIL ADDRESS</label>
              <input type="email" placeholder="you@example.com" value="user@example.com" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">MOBILE NUMBER</label>
              <input type="tel" placeholder="+91 98765 43210" value="+91 98765 43210" class="form-input">
            </div>
          </div>
        </div>

        <!-- Step 2: Delivery Address -->
        <div class="checkout-card">
          <div class="card-step-header">
            <span class="step-num">02</span>
            <div>
              <h3 class="step-title">Delivery address</h3>
              <p class="step-desc">Enter the address where you want your Ayova order delivered.</p>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label">FULL NAME</label>
              <input type="text" placeholder="Your full name" value="Rahul Sharma" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">PHONE</label>
              <input type="tel" placeholder="Mobile number" value="+91 98765 43210" class="form-input">
            </div>
            <div class="form-group full-width">
              <label class="form-label">ADDRESS</label>
              <input type="text" placeholder="House / Flat / Building / Street" value="Flat 402, Green Park Apartments, Sector 15" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">CITY</label>
              <input type="text" placeholder="City" value="Mumbai" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">PIN CODE</label>
              <input type="text" placeholder="6-digit PIN code" value="400001" class="form-input">
            </div>
          </div>
        </div>

        <!-- Step 3: Payment Method -->
        <div class="checkout-card">
          <div class="card-step-header">
            <span class="step-num">03</span>
            <div>
              <h3 class="step-title">Choose payment method</h3>
              <p class="step-desc">All payment options are processed through secure 256-bit SSL checkout.</p>
            </div>
          </div>

          <div class="payment-options">
            
            <!-- Option 1: UPI / QR -->
            <label class="payment-option-card active">
              <input type="radio" name="payment_type" checked>
              <div class="payment-option-content">
                <div class="payment-option-title">UPI / QR (Google Pay, PhonePe, Paytm)</div>
                <div class="payment-option-sub">Pay instantly using any UPI app or scan QR code</div>
              </div>
              <span class="payment-tag">INSTANT</span>
            </label>

            <!-- Option 2: Card -->
            <label class="payment-option-card">
              <input type="radio" name="payment_type">
              <div class="payment-option-content">
                <div class="payment-option-title">Credit / Debit Card</div>
                <div class="payment-option-sub">Visa, Mastercard, RuPay and supported cards</div>
              </div>
            </label>

            <!-- Option 3: Net Banking -->
            <label class="payment-option-card">
              <input type="radio" name="payment_type">
              <div class="payment-option-content">
                <div class="payment-option-title">Net Banking</div>
                <div class="payment-option-sub">All major Indian banks</div>
              </div>
            </label>

            <!-- Option 4: COD -->
            <label class="payment-option-card">
              <input type="radio" name="payment_type">
              <div class="payment-option-content">
                <div class="payment-option-title">Cash on Delivery (COD)</div>
                <div class="payment-option-sub">Pay cash upon delivery at your doorstep</div>
              </div>
            </label>

          </div>
        </div>

      </div>

      <!-- Right Order Summary Panel -->
      <div class="checkout-summary-panel">
        <h3 class="summary-title">Order Summary</h3>

        <div class="checkout-items-list">
          {% for item in cart.items %}
            <div class="summary-item">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">
              {% else %}
                <div style="width:60px; height:60px; background:#eee; border-radius:4px;"></div>
              {% endif %}
              <div>
                <h4 class="summary-item-name">{{ item.product.title }}</h4>
                <p class="summary-item-qty">
                  {% unless item.product.has_only_default_variant %}{{ item.variant.title }} • {% endunless %}Qty {{ item.quantity }}
                </p>
                <span class="summary-item-price">{{ item.final_line_price | money }}</span>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="coupon-card">
          <div class="coupon-header">Offer & Coupons</div>
          <div class="coupon-input-group">
            <input type="text" placeholder="Apply Coupon" class="coupon-input">
            <button type="button" class="btn-coupon">Apply</button>
          </div>
        </div>

        <div class="summary-totals">
          <div class="summary-row">
            <span>Item total</span>
            <span>{{ cart.items_subtotal_price | money }}</span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            {% if cart.total_price >= 49900 %}
              <span class="free-text">FREE</span>
            {% else %}
              <span>Calculated at checkout</span>
            {% endif %}
          </div>
          <div class="summary-row total-payable">
            <span>Amount payable</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
        </div>

        <button type="button" class="btn btn-accent btn-pay" onclick="alert('Order Placed! Please note: Submitting orders from a custom page requires a backend app or API integration.');">
          PAY {{ cart.total_price | money }} SECURELY →
        </button>

        <p class="checkout-terms">
          🔒 By continuing, you agree to Ayova’s Terms of Use and Refund Policy.
        </p>
      </div>

    </div>

  </div>
  {% else %}
  <div class="container checkout-login-prompt">
    <div class="login-prompt-card">
      <h2>Looks like you're new here</h2>
      <p>Please login or sign up with your Email ID to access Secure Checkout.</p>
      <a href="/customer_authentication/login?return_to=%2Fpages%2Fcheckout" class="btn btn-accent btn-pay" style="display:inline-block; margin-top: 20px; max-width: 300px; text-decoration: none; text-align: center;">
        LOGIN TO CONTINUE →
      </a>
    </div>
  </div>
  {% endif %}
</div>

<style>
.checkout-login-prompt {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
}
.login-prompt-card {
  background: var(--color-white);
  border: 1px solid var(--color-sage-border);
  border-radius: var(--radius-lg);
  padding: 40px;
  text-align: center;
  max-width: 500px;
  box-shadow: var(--shadow-sm);
}
.login-prompt-card h2 {
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--color-forest-primary);
  margin-bottom: 12px;
  font-size: 24px;
}
.login-prompt-card p {
  color: var(--color-text-muted);
  font-size: 15px;
}

/* --- Authentication Modals CSS --- */
.auth-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease;
}
.auth-overlay.active {
  opacity: 1;
  visibility: visible;
}
.auth-modal {
  background: #fff;
  width: 90%;
  max-width: 460px;
  border-radius: 8px;
  padding: 40px;
  position: relative;
  display: none;
  max-height: 90vh;
  overflow-y: auto;
}
.auth-modal.active {
  display: block;
}
.auth-modal-header {
  margin-bottom: 24px;
}
.auth-modal-header.center {
  text-align: center;
  margin-top: 20px;
}
.auth-title {
  font-size: 24px;
  font-weight: 800;
  color: #111;
  margin: 0 0 8px 0;
}
.auth-subtitle {
  font-size: 14px;
  color: #555;
  margin: 0;
}
.auth-form-group {
  margin-bottom: 16px;
}
.auth-form-group label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: #111;
  margin-bottom: 6px;
}
.auth-form-group input[type="text"],
.auth-form-group input[type="email"],
.auth-form-group input[type="date"] {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #ccd1d9;
  border-radius: 6px;
  font-size: 14px;
  outline: none;
}
.auth-form-group input:focus {
  border-color: #285044;
}
.auth-radio-group {
  display: flex;
  align-items: center;
  gap: 16px;
}
.auth-radio-group label.auth-radio-main-label {
  margin-bottom: 0;
  margin-right: 8px;
}
.auth-radio-group label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  font-size: 13px;
  margin: 0;
}
.auth-terms {
  margin: 24px 0;
}
.auth-checkbox {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 11px;
  color: #555;
  line-height: 1.5;
  cursor: pointer;
}
.auth-checkbox input {
  margin-top: 3px;
}
.btn-auth-submit {
  width: 100%;
  background: #e2e6ea;
  color: #888;
  border: none;
  padding: 14px;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
}
#signupForm:valid .btn-auth-submit,
#otpForm:valid .btn-auth-submit {
  background: #232f3e;
  color: #fff;
}
.auth-close-btn {
  position: absolute;
  top: 16px;
  right: 16px;
  background: none;
  border: none;
  font-size: 20px;
  cursor: pointer;
  color: #333;
}
.otp-inputs {
  display: flex;
  justify-content: center;
  margin-bottom: 16px;
}
.otp-box {
  width: 200px;
  padding: 12px;
  border: 1px solid #ccd1d9;
  border-radius: 6px;
  font-size: 20px;
  outline: none;
}
.otp-resend {
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  color: #111;
  margin-bottom: 24px;
}
.otp-timer {
  color: #888;
  font-weight: 400;
}
.otp-terms {
  text-align: center;
  font-size: 11px;
  color: #555;
  margin-top: 24px;
}
.checkout-main-content.hidden {
  display: none;
}

/* --- Checkout CSS --- */
.checkout-breadcrumb {
  font-size: 0.85rem;
  color: var(--color-text-muted);
}

.checkout-title {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 2.2rem;
  color: var(--color-forest-primary);
  margin: 4px 0;
}

.checkout-subtitle {
  color: var(--color-text-muted);
  margin-bottom: 24px;
}

.checkout-steps-bar {
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--color-white);
  padding: 16px 24px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-sage-border);
}

.step-item {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-text-muted);
}

.step-circle {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-sage-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: 700;
}

.step-completed .step-circle {
  background: var(--color-forest-mid);
  color: var(--color-white);
}

.step-active .step-circle {
  background: #1f2924;
  color: var(--color-white);
}

.step-active .step-label {
  font-weight: 700;
  color: var(--color-forest-primary);
}

.step-connector {
  flex-grow: 1;
  height: 2px;
  background: var(--color-sage-border);
}

.step-connector.active {
  background: var(--color-forest-mid);
}

.checkout-grid {
  display: grid;
  grid-template-columns: 1fr 400px;
  gap: 36px;
}

.checkout-forms {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.checkout-card {
  background: var(--color-white);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-sage-border);
  padding: 5px 20px;
  margin-bottom: 5px;
}

.card-step-header {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}

.step-num {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.5rem;
  color: var(--color-terracotta);
  margin: 0;
}

.step-title {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.3rem;
  color: var(--color-forest-primary);
  margin: 0 0 4px 0;
}

.step-desc {
  font-size: 0.85rem;
  color: var(--color-text-muted);
  margin: 0;
}

.form-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.form-group.full-width {
  grid-column: span 2;
}

.form-label {
  display: block;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-forest-primary);
  margin: 0 0 4px 0;
  letter-spacing: 0.05em;
}

.form-input {
  width: 100%;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-sage-border);
  font-size: 0.95rem;
  margin: 0;
}

.payment-options {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--color-sage-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.payment-option-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--color-sage-border);
  background: var(--color-white);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.payment-option-card:last-child {
  border-bottom: none;
}

.payment-option-card.active, .payment-option-card:hover {
  background: var(--color-sage-light);
}

.payment-option-title {
  font-weight: 700;
  color: var(--color-forest-primary);
  font-size: 0.95rem;
}

.payment-option-sub {
  font-size: 0.8rem;
  color: var(--color-text-muted);
}

.payment-tag {
  margin-left: auto;
  background: var(--color-terracotta);
  color: var(--color-white);
  font-size: 0.65rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: var(--radius-full);
}

.checkout-summary-panel {
  background: var(--color-white);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-sage-border);
  padding: 28px;
  height: fit-content;
  box-shadow: var(--shadow-sm);
}

.checkout-items-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--color-sage-border);
  padding-bottom: 20px;
}

.summary-item {
  display: flex;
  gap: 14px;
  align-items: center;
}

.summary-item img {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  background: var(--color-sage-light);
}

.summary-item-name {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--color-forest-primary);
}

.summary-item-qty {
  font-size: 0.8rem;
  color: var(--color-text-muted);
}

.summary-item-price {
  font-weight: 700;
  color: var(--color-forest-dark);
}

.summary-totals {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.9rem;
  color: var(--color-text-muted);
}

.total-payable {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.3rem;
  color: var(--color-forest-dark);
  border-top: 1px solid var(--color-sage-border);
  padding-top: 12px;
}

.btn-pay {
  width: 100%;
  padding: 16px;
  font-size: 1rem;
  margin-bottom: 16px;
}

.checkout-terms {
  font-size: 13px;
  color: var(--color-text-muted);
  text-align: center;
  margin-top: 12px;
}

/* Coupon Styles */
.coupon-card {
  background: var(--color-bg-cream);
  border: 1px solid var(--color-sage-border);
  border-radius: var(--radius-md);
  padding: 16px;
  margin-bottom: 24px;
}
.coupon-header {
  font-weight: 600;
  font-size: 15px;
  color: var(--color-text-heading);
  margin-bottom: 12px;
}
.coupon-input-group {
  display: flex;
  position: relative;
}
.coupon-input {
  flex: 1;
  border: 1px solid var(--color-sage-border);
  border-radius: 30px;
  padding: 10px 100px 10px 16px; /* Space for absolute button */
  font-size: 14px;
  outline: none;
}
.coupon-input:focus {
  border-color: var(--color-forest-mid);
}
.btn-coupon {
  position: absolute;
  right: 0;
  top: 0;
  height: 100%;
  background: #1F2924;
  color: #fff;
  border: none;
  border-radius: 30px;
  padding: 0 24px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: opacity 0.3s ease;
}
.btn-coupon:hover {
  opacity: 0.9;
}

@media (max-width: 900px) {
  .checkout-grid {
    grid-template-columns: 1fr;
  }
  .form-grid-2 {
    grid-template-columns: 1fr;
  }
  .form-group.full-width {
    grid-column: span 1;
  }
}
</style>

{% schema %}
{
  "name": "Checkout Page",
  "settings": [],
  "presets": [
    {
      "name": "Checkout Page"
    }
  ]
}
{% endschema %}
