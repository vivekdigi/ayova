{% comment %}
  AYOVA HEADER & ANNOUNCEMENT BAR SECTION
{% endcomment %}

<header class="ayova-header-wrapper">
  <!-- Top Announcement Bar -->
  <div class="announcement-bar">
    <div class="container announcement-content">
      <span>🌿 Free Shipping on orders above Rs. 499</span>
      <span class="announcement-divider">•</span>
      <span>100% Ayurvedic Formulations</span>
      <span class="announcement-divider">•</span>
      <span>AYUSH & ISO Certified Quality</span>
    </div>
  </div>

  <!-- Main Navigation Header -->
  <div class="main-header">
    <div class="container header-container">
      <!-- Logo -->
      <a href="/" class="header-logo">
        <span class="logo-title">AYOVA</span>
        <span class="logo-sub">AYURVEDA & WELLNESS</span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="header-nav">
        <a href="/" class="nav-link active">Home</a>
        <a href="/collections/all" class="nav-link">Shop</a>
        <a href="/pages/about" class="nav-link">About</a>
        <a href="/pages/contact" class="nav-link">Contact us</a>
      </nav>

      <!-- Right Header Utilities -->
      <div class="header-utilities">
        <!-- Search Button -->
        <button type="button" class="utility-icon-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- Account -->
        <a href="/account" class="utility-icon-btn" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>

        <!-- Cart Bag Button with Counter -->
        <a href="/cart" class="cart-btn" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-count-badge" data-cart-count>2</span>
        </a>

        <!-- Mobile Toggle -->
        <button type="button" class="mobile-toggle-btn" data-mobile-menu-toggle aria-label="Toggle menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-menu-drawer" data-mobile-menu>
    <nav class="mobile-nav">
      <a href="/" class="mobile-nav-link">Home</a>
      <a href="/collections/all" class="mobile-nav-link">Shop</a>
      <a href="/pages/about" class="mobile-nav-link">About Us</a>
      <a href="/pages/contact" class="mobile-nav-link">Contact Us</a>
    </nav>
  </div>
</header>

<style>
.ayova-header-wrapper {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-white);
  box-shadow: var(--shadow-sm);
}

.announcement-bar {
  background-color: var(--color-forest-dark);
  color: var(--color-white);
  font-family: var(--font-heading);
  font-size: 0.8rem;
  padding: 8px 0;
  text-align: center;
  font-weight: 500;
}

.announcement-content {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.announcement-divider {
  opacity: 0.5;
}

.main-header {
  border-bottom: 1px solid var(--color-sage-border);
  padding: 16px 0;
}

.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-logo {
  display: flex;
  flex-direction: column;
}

.logo-title {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.8rem;
  letter-spacing: 0.1em;
  color: var(--color-forest-primary);
  line-height: 1;
}

.logo-sub {
  font-size: 0.55rem;
  letter-spacing: 0.25em;
  color: var(--color-terracotta);
  font-weight: 600;
}

.header-nav {
  display: flex;
  align-items: center;
  gap: 32px;
}

.nav-link {
  font-family: var(--font-heading);
  font-weight: 500;
  font-size: 0.95rem;
  color: var(--color-text-dark);
  transition: color var(--transition-fast);
  position: relative;
  padding: 4px 0;
}

.nav-link:hover, .nav-link.active {
  color: var(--color-forest-mid);
}

.nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background-color: var(--color-forest-mid);
}

.header-utilities {
  display: flex;
  align-items: center;
  gap: 14px;
}

.utility-icon-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid var(--color-sage-border);
  background: var(--color-white);
  color: var(--color-forest-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.utility-icon-btn:hover {
  background: var(--color-sage-light);
  border-color: var(--color-forest-primary);
}

.cart-btn {
  position: relative;
  background-color: var(--color-forest-mid);
  color: var(--color-white);
  padding: 10px 18px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: 8px;
  transition: background var(--transition-fast);
}

.cart-btn:hover {
  background-color: var(--color-forest-dark);
}

.cart-count-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  background: var(--color-terracotta);
  color: var(--color-white);
  font-size: 0.7rem;
  font-weight: 700;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--color-white);
}

.mobile-toggle-btn {
  display: none;
  background: none;
  border: none;
  color: var(--color-forest-primary);
  cursor: pointer;
}

.mobile-menu-drawer {
  display: none;
  background: var(--color-white);
  border-bottom: 1px solid var(--color-sage-border);
  padding: 16px 24px;
}

.mobile-menu-drawer.active {
  display: block;
}

.mobile-nav {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mobile-nav-link {
  font-weight: 600;
  color: var(--color-forest-primary);
}

@media (max-width: 900px) {
  .header-nav { display: none; }
  .mobile-toggle-btn { display: block; }
  .announcement-divider { display: none; }
}
</style>

{% schema %}
{
  "name": "Header and Announcement",
  "settings": []
}
{% endschema %}
