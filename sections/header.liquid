{% comment %}
  AYOVA HEADER — Figma Pixel-Perfect
  Dynamic: Logo, Navigation (Shopify menus), Utilities, Mobile Drawer
  Announcement bar with dynamic blocks
{% endcomment %}

<header class="ayova-header-wrapper {% if section.settings.enable_sticky %}ayova-header-wrapper--sticky{% endif %}" data-header>
  <!-- Announcement Bar — Figma: 34px, #285044 -->
  {% if section.settings.show_announcement %}
    <div class="announcement-bar" style="background-color: {{ section.settings.announcement_bg | default: '#285044' }}; color: {{ section.settings.announcement_text_color | default: '#FFFFFF' }};">
      <div class="announcement-marquee">
        {% capture marquee_content %}
          {% for block in section.blocks %}
            {% if block.type == 'announcement' %}
              <span class="marquee-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
              <span class="announcement-divider" style="margin: 0 15px;">•</span>
            {% endif %}
          {% endfor %}
        {% endcapture %}
        
        <div class="marquee-track">
          {{ marquee_content }}
          {{ marquee_content }}
          {{ marquee_content }}
          {{ marquee_content }}
        </div>
      </div>
    </div>
    <style>
      .announcement-bar {
        overflow: hidden;
        white-space: nowrap;
        display: flex;
        align-items: center;
        height: 34px;
      }
      .announcement-marquee {
        width: 100%;
        overflow: hidden;
      }
      .marquee-track {
        display: inline-flex;
        align-items: center;
        animation: scroll-marquee 25s linear infinite;
      }
      .marquee-track:hover {
        animation-play-state: paused;
      }
      .marquee-item {
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.5px;
      }
      @keyframes scroll-marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
    </style>
  {% endif %}

  <!-- Main Header — Figma: 80px height -->
  <div class="main-header">
    <div class="header-inner">
      <!-- Logo — Figma: 97x48px -->
      <a href="/" class="header-logo" aria-label="{{ shop.name }}">
        {% assign custom_logo = section.settings.logo | default: settings.logo %}
        {% assign custom_logo_width = section.settings.logo_width | default: 97 %}
        {% if custom_logo != blank %}
          {% assign custom_logo_width_2x = custom_logo_width | times: 2 %}
          <img
            src="{{ custom_logo | image_url: width: custom_logo_width }}"
            srcset="{{ custom_logo | image_url: width: custom_logo_width }} 1x, {{ custom_logo | image_url: width: custom_logo_width_2x }} 2x"
            alt="{{ custom_logo.alt | default: shop.name | escape }}"
            width="{{ custom_logo_width }}"
            height="{{ custom_logo_width | divided_by: 2 }}"
            loading="eager"
            style="width: {{ custom_logo_width }}px; height: auto;"
          >
        {% else %}
          <span class="logo-text">
            <span class="logo-title">{{ shop.name | upcase }}</span>
          </span>
        {% endif %}
      </a>

      <!-- Desktop Navigation — Figma: Montserrat Medium/SemiBold 16px, gap 26px -->
      {% assign main_menu = linklists[section.settings.menu] %}
      <nav class="header-nav" role="navigation" aria-label="Main navigation">
        {% for link in main_menu.links %}
          <div class="nav-item {% if link.active %}active{% endif %}">
            <a href="{{ link.url }}" class="nav-link" {% if link.current %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
            {% if link.links.size > 0 %}
              <div class="nav-dropdown">
                {% for child_link in link.links %}
                  <a href="{{ child_link.url }}" class="nav-dropdown-link">{{ child_link.title }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </nav>

      <!-- Header Utilities — Figma: Search, Account, Wishlist icons + Cart pill -->
      <div class="header-utilities">
        <!-- Marketplace Buttons -->
        <div class="header-marketplace-buttons">
          {% if section.settings.blinkit_url != blank %}
            <a href="{{ section.settings.blinkit_url }}" class="marketplace-btn btn-blinkit" target="_blank">
              {% if section.settings.blinkit_logo != blank %}
                <img src="{{ section.settings.blinkit_logo | image_url: height: 32 }}" alt="Blinkit" style="height: 20px; width: auto;">
              {% else %}
                blinkit
              {% endif %}
            </a>
          {% endif %}
          {% if section.settings.amazon_url != blank %}
            <a href="{{ section.settings.amazon_url }}" class="marketplace-btn btn-amazon" target="_blank">
              {% if section.settings.amazon_logo != blank %}
                <img src="{{ section.settings.amazon_logo | image_url: height: 32 }}" alt="Amazon" style="height: 20px; width: auto;">
              {% else %}
                amazon
              {% endif %}
            </a>
          {% endif %}
          {% if section.settings.flipkart_url != blank %}
            <a href="{{ section.settings.flipkart_url }}" class="marketplace-btn btn-flipkart" target="_blank">
              {% if section.settings.flipkart_logo != blank %}
                <img src="{{ section.settings.flipkart_logo | image_url: height: 32 }}" alt="Flipkart" style="height: 20px; width: auto;">
              {% else %}
                Flipkart
              {% endif %}
            </a>
          {% endif %}
        </div>

        <!-- Search -->
        <button type="button" class="utility-icon-btn" aria-label="Search" data-search-toggle>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- Account -->
        <a href="{{ routes.account_url }}" class="utility-icon-btn" aria-label="Account">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>

        {% if section.settings.show_wishlist %}
          <!-- Wishlist -->
          <button type="button" class="utility-icon-btn" aria-label="Wishlist">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </button>
        {% endif %}

        <!-- Cart Bag — Figma: #285044, border-radius 20px, 46px wide -->
        <a href="{{ routes.cart_url }}" class="cart-btn" aria-label="Cart ({{ cart.item_count }} items)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-count-badge" data-cart-count>{{ cart.item_count }}</span>
        </a>

        <!-- Mobile Menu Toggle -->
        <button type="button" class="mobile-toggle-btn" data-mobile-menu-toggle aria-label="Open menu" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu-overlay" data-mobile-overlay></div>
  <div class="mobile-menu-drawer" data-mobile-menu role="dialog" aria-label="Mobile menu">
    <div class="mobile-menu-header">
      <a href="/" class="header-logo" aria-label="{{ shop.name }}">
        {% assign custom_logo = section.settings.logo | default: settings.logo %}
        {% assign custom_logo_width = section.settings.logo_width | default: 97 %}
        {% if custom_logo != blank %}
          <img src="{{ custom_logo | image_url: width: custom_logo_width }}" alt="{{ shop.name | escape }}" width="{{ custom_logo_width }}" height="{{ custom_logo_width | divided_by: 2 }}" style="width: {{ custom_logo_width }}px; height: auto;">
        {% else %}
          <span class="logo-text"><span class="logo-title">{{ shop.name | upcase }}</span></span>
        {% endif %}
      </a>
      <button type="button" class="mobile-menu-close" data-mobile-menu-close aria-label="Close menu">✕</button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {% for link in main_menu.links %}
        <a href="{{ link.url }}" class="mobile-nav-link">{{ link.title }}</a>
        {% if link.links.size > 0 %}
          <div class="mobile-nav-child">
            {% for child_link in link.links %}
              <a href="{{ child_link.url }}" class="mobile-nav-link">{{ child_link.title }}</a>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </nav>
  </div>

  <!-- Search Overlay (Rich Design) -->
  <div class="search-overlay-bg" data-search-overlay-bg></div>
  <div class="search-overlay-panel" data-search-overlay role="dialog" aria-label="Search" aria-modal="true">
    <div class="search-panel-inner">

      <div class="search-panel-header">
        <span class="search-eyebrow">SEARCH AYOVA</span>
        <h2 class="search-panel-title">What are you looking for?</h2>
        <p class="search-panel-sub">Search products, ingredients or wellness goals.</p>
        <button type="button" class="search-close-btn" data-search-close aria-label="Close search">✕</button>
      </div>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel-form">
        <div class="search-panel-input-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7A857F" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" name="q" id="searchPanelInput" class="search-panel-input" placeholder="Search Milk Thistle, Curcumin, Liver Care..." autocomplete="off" aria-label="Search" spellcheck="false">
          <button type="button" class="search-clear-btn" id="searchClearBtn" aria-label="Clear">✕</button>
        </div>
        <input type="hidden" name="type" value="product">
      </form>

      <!-- Live Results (shown while typing) -->
      <div class="search-live-results" id="searchLiveResults" style="display:none;">
        <div class="search-results-grid" id="searchResultsGrid"></div>
        <p class="search-results-footer">Start typing to see matching products instantly.</p>
      </div>

      <!-- Popular Products (shown by default) -->
      <div class="search-popular" id="searchPopular">
        <div class="search-popular-header">
          <div>
            <h4 class="search-popular-title">Popular products</h4>
            <p class="search-popular-sub">Frequently explored by Ayova customers</p>
          </div>
          <a href="/collections/all" class="search-view-all">VIEW ALL PRODUCTS →</a>
        </div>
        <div class="search-popular-grid">
          {% assign popular_collection = collections['all'] %}
          {% for product in popular_collection.products limit: 4 %}
            <a href="{{ product.url }}" class="search-pop-card">
              <div class="search-pop-img">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" loading="lazy">
                {% endif %}
              </div>
              <div class="search-pop-info">
                {% if product.type != blank %}
                  <span class="search-pop-cat">{{ product.type | upcase }}</span>
                {% endif %}
                <span class="search-pop-name">{{ product.title }}</span>
                <span class="search-pop-price">{{ product.price | money }}</span>
                <div class="search-pop-stars">★★★★★</div>
              </div>
              <span class="search-pop-btn">VIEW PRODUCT →</span>
            </a>
          {% endfor %}
        </div>
        <p class="search-panel-hint">Start typing to see matching products instantly.</p>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 5,
      "default": 95,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement Background",
      "default": "#285044"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Utilities"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky Header",
      "default": true
    },
    {
      "type": "header",
      "content": "Marketplace Buttons"
    },
    {
      "type": "url",
      "id": "blinkit_url",
      "label": "Blinkit URL",
      "default": "/"
    },
    {
      "type": "image_picker",
      "id": "blinkit_logo",
      "label": "Blinkit Custom Logo"
    },
    {
      "type": "url",
      "id": "amazon_url",
      "label": "Amazon URL",
      "default": "/"
    },
    {
      "type": "image_picker",
      "id": "amazon_logo",
      "label": "Amazon Custom Logo"
    },
    {
      "type": "url",
      "id": "flipkart_url",
      "label": "Flipkart URL",
      "default": "/"
    },
    {
      "type": "image_picker",
      "id": "flipkart_logo",
      "label": "Flipkart Custom Logo"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message Text",
          "default": "🌿 Free Shipping on orders above Rs. 499"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "announcement",
          "settings": { "text": "🌿 Free Shipping on orders above Rs. 499" }
        },
        {
          "type": "announcement",
          "settings": { "text": "100% Ayurvedic & Lab Tested" }
        },
        {
          "type": "announcement",
          "settings": { "text": "AYUSH & ISO Certified Quality" }
        },
        {
          "type": "announcement",
          "settings": { "text": "⭐ 10,000+ Happy Customers" }
        }
      ]
    }
  ]
}
{% endschema %}