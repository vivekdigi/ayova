{% comment %}
  AYOVA RESPONSIVE BANNER & SLIDER SECTION (Desktop & Mobile)
  - Single Banner OR Interactive Carousel / Slider
  - Multiple Sources Supported:
    1. Product Metaobjects (e.g. custom.product_banners, custom.banners, custom.banner_slider)
       - List of Metaobjects (each entry = 1 slide with desktop/mobile image, link, text)
       - Single Metaobject with 'images' list (list of files inside metaobject)
    2. Global Metaobjects in shop.metaobjects (e.g. product_banner, product_banners, banner_slide)
       - Metaobjects linking to product reference
    3. Product Metafields:
       - List of image files: product.metafields.custom.desktop_banners, banners, product_banners
       - Numbered metafields: desktop_banner, desktop_banner_2, desktop_banner_3, desktop_banner_4, desktop_banner_5
       - Single metafield: desktop_banner (with mobile fallback)
    4. Theme Customizer Blocks:
       - Multiple banner slides per product or general slides
    5. Section Fallback Images:
       - Used if no product-specific banners are found
  - Features: Touch swipe, Autoplay, Glassmorphic navigation arrows, Dots, Responsive <picture> loading
{% endcomment %}

{% liquid
  assign is_product_page = false
  if template.name == 'product' and product != blank
    assign is_product_page = true
  endif

  assign total_slides = 0
  assign slide_source = 'none'

  comment
    Source 1: Customizer Blocks matching this product
  endcomment
  assign product_blocks_count = 0
  if is_product_page and section.blocks.size > 0
    for block in section.blocks
      if block.type == 'product_banner' and block.settings.product != blank
        if block.settings.product.handle == product.handle or block.settings.product.id == product.id
          assign product_blocks_count = product_blocks_count | plus: 1
        endif
      endif
    endfor
  endif

  if product_blocks_count > 0
    assign total_slides = product_blocks_count
    assign slide_source = 'product_blocks'
  endif

  comment
    Source 2: Direct Product Metafield List of Files (list.file_reference)
    Supports: custom.product_banner, custom.product_banners, custom.desktop_banners, custom.banners
  endcomment
  if total_slides == 0 and is_product_page
    assign potential_list = product.metafields.custom.product_banner.value
    if potential_list == blank
      assign potential_list = product.metafields.custom.product_banners.value
    endif
    if potential_list == blank
      assign potential_list = product.metafields.custom.desktop_banners.value
    endif
    if potential_list == blank
      assign potential_list = product.metafields.custom.desktop_banner.value
    endif
    if potential_list == blank
      assign potential_list = product.metafields.custom.banners.value
    endif
    if potential_list == blank
      assign potential_list = product.metafields.custom.banner.value
    endif

    assign list_item_count = 0
    if potential_list != blank
      for test_item in potential_list
        assign list_item_count = list_item_count | plus: 1
      endfor
    endif

    if list_item_count > 0
      assign total_slides = list_item_count
      assign file_list = potential_list
      assign slide_source = 'meta_list'
    endif
  endif

  comment
    Source 3: Product Metaobjects (via Product Metafield reference or list of metaobjects)
  endcomment
  assign mo_ref = nil
  if total_slides == 0 and is_product_page
    assign mo_ref = product.metafields.custom.product_banners.value | default: product.metafields.custom.banners.value | default: product.metafields.custom.product_banner.value | default: product.metafields.custom.banner_slider.value | default: product.metafields.custom.banner_object.value | default: product.metafields.custom.banner.value

    if mo_ref != blank
      comment
        Check if mo_ref is a List of Metaobjects
      endcomment
      if mo_ref.first != blank and mo_ref.size > 0
        assign is_metaobject_list = false
        for item in mo_ref
          if item.desktop_image != blank or item.image != blank or item.desktop_banner != blank or item.banner != blank or item.file != blank
            assign is_metaobject_list = true
            break
          endif
        endfor

        if is_metaobject_list
          assign total_slides = mo_ref.size
          assign slide_source = 'metaobject_list'
        endif
      endif

      comment
        Check if mo_ref is a Single Metaobject containing a list of images (e.g. mo_ref.images or mo_ref.desktop_images)
      endcomment
      if total_slides == 0
        assign mo_images_list = mo_ref.images.value | default: mo_ref.desktop_images.value | default: mo_ref.banners.value | default: mo_ref.desktop_banners.value | default: mo_ref.banner_images.value | default: mo_ref.files.value
        if mo_images_list != blank and mo_images_list.size > 0
          assign total_slides = mo_images_list.size
          assign slide_source = 'metaobject_single_images'
        endif
      endif
    endif
  endif

  comment
    Source 4: Shop Metaobjects (Global metaobjects pointing to product reference)
  endcomment
  if total_slides == 0 and is_product_page
    assign global_mo_count = 0
    if shop.metaobjects.product_banner != blank
      for entry in shop.metaobjects.product_banner.values
        if entry.product.value.handle == product.handle or entry.product.value.id == product.id
          assign global_mo_count = global_mo_count | plus: 1
        endif
      endfor
    elsif shop.metaobjects.product_banners != blank
      for entry in shop.metaobjects.product_banners.values
        if entry.product.value.handle == product.handle or entry.product.value.id == product.id
          assign global_mo_count = global_mo_count | plus: 1
        endif
      endfor
    elsif shop.metaobjects.banner_slide != blank
      for entry in shop.metaobjects.banner_slide.values
        if entry.product.value.handle == product.handle or entry.product.value.id == product.id
          assign global_mo_count = global_mo_count | plus: 1
        endif
      endfor
    endif

    if global_mo_count > 0
      assign total_slides = global_mo_count
      assign slide_source = 'shop_metaobjects'
    endif
  endif

  comment
    Source 5: Numbered or Single Product Metafields
  endcomment
  if total_slides == 0 and is_product_page
    assign m1 = product.metafields.custom.desktop_banner.value | default: product.metafields.custom.desktop_banner
    if m1 == blank
      assign m1 = product.metafields.custom.banner.value | default: product.metafields.custom.banner
    endif
    if m1 == blank
      assign m1 = product.metafields.custom.banner_image.value | default: product.metafields.custom.banner_image
    endif
    if m1 == blank
      assign m1 = product.metafields.custom.desktop_banner_image.value | default: product.metafields.custom.desktop_banner_image
    endif

    assign m2 = product.metafields.custom.desktop_banner_2.value | default: product.metafields.custom.desktop_banner_2
    assign m3 = product.metafields.custom.desktop_banner_3.value | default: product.metafields.custom.desktop_banner_3
    assign m4 = product.metafields.custom.desktop_banner_4.value | default: product.metafields.custom.desktop_banner_4
    assign m5 = product.metafields.custom.desktop_banner_5.value | default: product.metafields.custom.desktop_banner_5

    if m1 != blank
      assign total_slides = 1
      assign slide_source = 'meta_numbered'
      if m2 != blank
        assign total_slides = total_slides | plus: 1
      endif
      if m3 != blank
        assign total_slides = total_slides | plus: 1
      endif
      if m4 != blank
        assign total_slides = total_slides | plus: 1
      endif
      if m5 != blank
        assign total_slides = total_slides | plus: 1
      endif
    endif
  endif

  comment
    Source 6: Generic Customizer Blocks (blocks with no product specified)
  endcomment
  if total_slides == 0 and section.blocks.size > 0
    assign generic_blocks_count = 0
    for block in section.blocks
      if block.type == 'product_banner' and block.settings.product == blank and block.settings.desktop_image != blank
        assign generic_blocks_count = generic_blocks_count | plus: 1
      endif
    endfor
    if generic_blocks_count > 0
      assign total_slides = generic_blocks_count
      assign slide_source = 'generic_blocks'
    endif
  endif

  comment
    Source 7: Section Settings Fallback
  endcomment
  if total_slides == 0
    if section.settings.desktop_image != blank or section.settings.desktop_image_url != blank
      assign total_slides = 1
      assign slide_source = 'section_settings'
    endif
  endif

  comment
    Check Hide condition
  endcomment
  assign skip_section = false
  if is_product_page and section.settings.hide_if_no_product_banner
    if slide_source == 'generic_blocks' or slide_source == 'section_settings' or slide_source == 'none'
      assign skip_section = true
    endif
  endif
%}

{% unless skip_section %}

<section id="banner-{{ section.id }}" class="ayova-banner-section {% if section.settings.full_width %}ayova-banner-section--full{% else %}container{% endif %}" style="--p-top: {{ section.settings.padding_top }}px; --p-bottom: {{ section.settings.padding_bottom }}px; --m-top: {{ section.settings.margin_top }}px; --m-bottom: {{ section.settings.margin_bottom }}px;">
  <div class="ayova-banner-box {% if section.settings.border_radius > 0 %}ayova-banner-box--rounded{% endif %}" style="--border-rad: {{ section.settings.border_radius }}px;">

    {% assign is_slider = false %}
    {% if section.settings.layout_mode == 'slider' %}
      {% assign is_slider = true %}
    {% endif %}

    <div class="{% if is_slider %}ayova-banner-slider-container{% else %}ayova-banner-stack-container{% endif %}" 
         style="--stack-gap: {{ section.settings.stack_gap | default: 16 }}px;"
         {% if is_slider %}
           data-autoplay="{{ section.settings.slider_autoplay }}" 
           data-speed="{{ section.settings.slider_speed | default: 5 | times: 1000 }}" 
           data-total-slides="{{ total_slides }}"
         {% endif %}>
      
      <div class="{% if is_slider %}ayova-banner-track{% else %}ayova-banner-stack{% endif %}">

        {% comment %} CASE 1: PRODUCT BLOCKS {% endcomment %}
        {% if slide_source == 'product_blocks' %}
          {% for block in section.blocks %}
            {% if block.type == 'product_banner' and block.settings.product != blank %}
              {% if block.settings.product.handle == product.handle or block.settings.product.id == product.id %}
                {% assign s_desk = block.settings.desktop_image %}
                {% assign s_mob = block.settings.mobile_image | default: s_desk %}
                {% assign s_link = block.settings.banner_link | default: section.settings.banner_link %}
                {% assign s_heading = block.settings.heading | default: section.settings.heading %}
                {% assign s_subheading = block.settings.subheading | default: section.settings.subheading %}
                {% assign s_badge = section.settings.badge_text %}
                {% assign s_btn_text = block.settings.button_text | default: section.settings.button_1_text %}
                {% assign s_btn_link = block.settings.button_link | default: section.settings.button_1_link %}
                {% render 'banner-slide-item', s_desk: s_desk, s_mob: s_mob, s_link: s_link, s_heading: s_heading, s_subheading: s_subheading, s_badge: s_badge, s_btn_text: s_btn_text, s_btn_link: s_btn_link, section: section, forloop: forloop %}
              {% endif %}
            {% endif %}
          {% endfor %}

        {% comment %} CASE 2A: LIST OF METAOBJECTS (Each entry = 1 slide) {% endcomment %}
        {% elsif slide_source == 'metaobject_list' %}
          {% for slide_item in mo_ref %}
            {% assign s_desk = slide_item.desktop_image.value | default: slide_item.desktop_image | default: slide_item.image.value | default: slide_item.image | default: slide_item.desktop_banner.value | default: slide_item.desktop_banner | default: slide_item.banner.value | default: slide_item.banner | default: slide_item.file.value | default: slide_item.file %}
            {% assign s_mob = slide_item.mobile_image.value | default: slide_item.mobile_image | default: slide_item.mobile_banner.value | default: slide_item.mobile_banner | default: s_desk %}
            {% assign s_link = slide_item.link.value | default: slide_item.link | default: slide_item.banner_link.value | default: slide_item.banner_link | default: slide_item.url.value | default: slide_item.url | default: section.settings.banner_link %}
            {% assign s_heading = slide_item.heading.value | default: slide_item.heading | default: slide_item.title.value | default: slide_item.title | default: section.settings.heading %}
            {% assign s_subheading = slide_item.subheading.value | default: slide_item.subheading | default: slide_item.subtitle.value | default: slide_item.subtitle | default: section.settings.subheading %}
            {% assign s_badge = section.settings.badge_text %}
            {% assign s_btn_text = slide_item.button_text.value | default: slide_item.button_text | default: section.settings.button_1_text %}
            {% assign s_btn_link = slide_item.button_link.value | default: slide_item.button_link | default: section.settings.button_1_link %}
            {% render 'banner-slide-item', s_desk: s_desk, s_mob: s_mob, s_link: s_link, s_heading: s_heading, s_subheading: s_subheading, s_badge: s_badge, s_btn_text: s_btn_text, s_btn_link: s_btn_link, section: section, forloop: forloop %}
          {% endfor %}

        {% comment %} CASE 2B: SINGLE METAOBJECT WITH IMAGES LIST {% endcomment %}
        {% elsif slide_source == 'metaobject_single_images' %}
          {% assign mo_mob_list = mo_ref.mobile_images.value | default: mo_ref.mobile_banners.value %}
          {% for img_item in mo_images_list %}
            {% assign s_desk = img_item %}
            {% assign s_mob = nil %}
            {% if mo_mob_list != blank and mo_mob_list[forloop.index0] != blank %}
              {% assign s_mob = mo_mob_list[forloop.index0] %}
            {% else %}
              {% assign s_mob = s_desk %}
            {% endif %}
            {% assign s_link = mo_ref.link.value | default: mo_ref.link | default: mo_ref.banner_link.value | default: mo_ref.banner_link | default: section.settings.banner_link %}
            {% assign s_heading = mo_ref.heading.value | default: mo_ref.heading | default: section.settings.heading %}
            {% assign s_subheading = mo_ref.subheading.value | default: mo_ref.subheading | default: section.settings.subheading %}
            {% assign s_badge = section.settings.badge_text %}
            {% assign s_btn_text = section.settings.button_1_text %}
            {% assign s_btn_link = section.settings.button_1_link %}
            {% render 'banner-slide-item', s_desk: s_desk, s_mob: s_mob, s_link: s_link, s_heading: s_heading, s_subheading: s_subheading, s_badge: s_badge, s_btn_text: s_btn_text, s_btn_link: s_btn_link, section: section, forloop: forloop %}
          {% endfor %}

        {% comment %} CASE 3: GLOBAL SHOP METAOBJECTS (linking to product) {% endcomment %}
        {% elsif slide_source == 'shop_metaobjects' %}
          {% if shop.metaobjects.product_banner != blank %}
            {% for entry in shop.metaobjects.product_banner.values %}
              {% if entry.product.value.handle == product.handle or entry.product.value.id == product.id %}
                {% assign s_desk = entry.desktop_image.value | default: entry.desktop_image | default: entry.image.value | default: entry.image | default: entry.banner.value | default: entry.banner | default: entry.file.value | default: entry.file %}
                {% assign s_mob = entry.mobile_image.value | default: entry.mobile_image | default: entry.mobile_banner.value | default: entry.mobile_banner | default: s_desk %}
                {% assign s_link = entry.link.value | default: entry.link | default: entry.banner_link.value | default: entry.banner_link | default: entry.url.value | default: entry.url | default: section.settings.banner_link %}
                {% assign s_heading = entry.heading.value | default: entry.heading | default: entry.title.value | default: entry.title | default: section.settings.heading %}
                {% assign s_subheading = entry.subheading.value | default: entry.subheading | default: section.settings.subheading %}
                {% assign s_badge = section.settings.badge_text %}
                {% assign s_btn_text = entry.button_text.value | default: entry.button_text | default: section.settings.button_1_text %}
                {% assign s_btn_link = entry.button_link.value | default: entry.button_link | default: section.settings.button_1_link %}
                {% render 'banner-slide-item', s_desk: s_desk, s_mob: s_mob, s_link: s_link, s_heading: s_heading, s_subheading: s_subheading, s_badge: s_badge, s_btn_text: s_btn_text, s_btn_link: s_btn_link, section: section, forloop: forloop %}
              {% endif %}
            {% endfor %}
          {% elsif shop.metaobjects.product_banners != blank %}
            {% for entry in shop.metaobjects.product_banners.values %}
              {% if entry.product.value.handle == product.handle or entry.product.value.id == product.id %}
                {% assign s_desk = entry.desktop_image.value | default: entry.desktop_image | default: entry.image.value | default: entry.image | default: entry.banner.value | default: entry.banner | default: entry.file.value | default: entry.file %}
                {% assign s_mob = entry.mobile_image.value | default: entry.mobile_image | default: entry.mobile_banner.value | default: entry.mobile_banner | default: s_desk %}
                {% assign s_link = entry.link.value | default: entry.link | default: entry.banner_link.value | default: entry.banner_link | default: entry.url.value | default: entry.url | default: section.settings.banner_link %}
                {% assign s_heading = entry.heading.value | default: entry.heading | default: entry.title.value | default: entry.title | default: section.settings.heading %}
                {% assign s_subheading = entry.subheading.value | default: entry.subheading | default: section.settings.subheading %}
                {% assign s_badge = section.settings.badge_text %}
                {% assign s_btn_text = entry.button_text.value | default: entry.button_text | default: section.settings.button_1_text %}
                {% assign s_btn_link = entry.button_link.value | default: entry.button_link | default: section.settings.button_1_link %}
                {% render 'banner-slide-item', s_desk: s_desk, s_mob: s_mob, s_link: s_link, s_heading: s_heading, s_subheading: s_subheading, s_badge: s_badge, s_btn_text: s_btn_text, s_btn_link: s_btn_link, section: section, forloop: forloop %}
              {% endif %}
            {% endfor %}
          {% elsif shop.metaobjects.banner_slide != blank %}
            {% for entry in shop.metaobjects.banner_slide.values %}
              {% if entry.product.value.handle == product.handle or entry.product.value.id == product.id %}
                {% assign s_desk = entry.desktop_image.value | default: entry.desktop_image | default: entry.image.value | default: entry.image | default: entry.banner.value | default: entry.banner | default: entry.file.value | default: entry.file %}
                {% assign s_mob = entry.mobile_image.value | default: entry.mobile_image | default: entry.mobile_banner.value | default: entry.mobile_banner | default: s_desk %}
                {% assign s_link = entry.link.value | default: entry.link | default: entry.banner_link.value | default: entry.banner_link | default: entry.url.value | default: entry.url | default: section.settings.banner_link %}
                {% assign s_heading = entry.heading.value | default: entry.heading | default: entry.title.value | default: entry.title | default: section.settings.heading %}
                {% assign s_subheading = entry.subheading.value | default: entry.subheading | default: section.settings.subheading %}
                {% assign s_badge = section.settings.badge_text %}
                {% assign s_btn_text = entry.button_text.value | default: entry.button_text | default: section.settings.button_1_text %}
                {% assign s_btn_link = entry.button_link.value | default: entry.button_link | default: section.settings.button_1_link %}
                {% render 'banner-slide-item', s_desk: s_desk, s_mob: s_mob, s_link: s_link, s_heading: s_heading, s_subheading: s_subheading, s_badge: s_badge, s_btn_text: s_btn_text, s_btn_link: s_btn_link, section: section, forloop: forloop %}
              {% endif %}
            {% endfor %}
          {% endif %}

        {% comment %} CASE 4: DIRECT METAFIELD LIST OF FILES {% endcomment %}
        {% elsif slide_source == 'meta_list' %}
          {% assign mob_list = product.metafields.custom.mobile_banners.value | default: product.metafields.custom.banners_mobile.value %}
          {% for img_item in file_list %}
            {% assign s_desk = img_item %}
            {% assign s_mob = nil %}
            {% if mob_list != blank and mob_list[forloop.index0] != blank %}
              {% assign s_mob = mob_list[forloop.index0] %}
            {% else %}
              {% assign s_mob = s_desk %}
            {% endif %}
            {% assign s_link = section.settings.banner_link %}
            {% assign s_heading = section.settings.heading %}
            {% assign s_subheading = section.settings.subheading %}
            {% assign s_badge = section.settings.badge_text %}
            {% assign s_btn_text = section.settings.button_1_text %}
            {% assign s_btn_link = section.settings.button_1_link %}
            {% render 'banner-slide-item', s_desk: s_desk, s_mob: s_mob, s_link: s_link, s_heading: s_heading, s_subheading: s_subheading, s_badge: s_badge, s_btn_text: s_btn_text, s_btn_link: s_btn_link, section: section, forloop: forloop %}
          {% endfor %}

        {% comment %} CASE 5: NUMBERED METAFIELDS {% endcomment %}
        {% elsif slide_source == 'meta_numbered' %}
          {% assign mob_1 = product.metafields.custom.mobile_banner.value | default: product.metafields.custom.mobile_banner %}
          {% assign s_mob_1 = mob_1 | default: m1 %}
          {% render 'banner-slide-item', s_desk: m1, s_mob: s_mob_1, s_link: section.settings.banner_link, s_heading: section.settings.heading, s_subheading: section.settings.subheading, s_badge: section.settings.badge_text, s_btn_text: section.settings.button_1_text, s_btn_link: section.settings.button_1_link, section: section, is_first: true %}

          {% if m2 != blank %}
            {% assign mob_2 = product.metafields.custom.mobile_banner_2.value | default: product.metafields.custom.mobile_banner_2 %}
            {% assign s_mob_2 = mob_2 | default: m2 %}
            {% render 'banner-slide-item', s_desk: m2, s_mob: s_mob_2, s_link: section.settings.banner_link, s_heading: section.settings.heading, s_subheading: section.settings.subheading, s_badge: section.settings.badge_text, s_btn_text: section.settings.button_1_text, s_btn_link: section.settings.button_1_link, section: section %}
          {% endif %}

          {% if m3 != blank %}
            {% assign mob_3 = product.metafields.custom.mobile_banner_3.value | default: product.metafields.custom.mobile_banner_3 %}
            {% assign s_mob_3 = mob_3 | default: m3 %}
            {% render 'banner-slide-item', s_desk: m3, s_mob: s_mob_3, s_link: section.settings.banner_link, s_heading: section.settings.heading, s_subheading: section.settings.subheading, s_badge: section.settings.badge_text, s_btn_text: section.settings.button_1_text, s_btn_link: section.settings.button_1_link, section: section %}
          {% endif %}

          {% if m4 != blank %}
            {% assign mob_4 = product.metafields.custom.mobile_banner_4.value | default: product.metafields.custom.mobile_banner_4 %}
            {% assign s_mob_4 = mob_4 | default: m4 %}
            {% render 'banner-slide-item', s_desk: m4, s_mob: s_mob_4, s_link: section.settings.banner_link, s_heading: section.settings.heading, s_subheading: section.settings.subheading, s_badge: section.settings.badge_text, s_btn_text: section.settings.button_1_text, s_btn_link: section.settings.button_1_link, section: section %}
          {% endif %}

          {% if m5 != blank %}
            {% assign mob_5 = product.metafields.custom.mobile_banner_5.value | default: product.metafields.custom.mobile_banner_5 %}
            {% assign s_mob_5 = mob_5 | default: m5 %}
            {% render 'banner-slide-item', s_desk: m5, s_mob: s_mob_5, s_link: section.settings.banner_link, s_heading: section.settings.heading, s_subheading: section.settings.subheading, s_badge: section.settings.badge_text, s_btn_text: section.settings.button_1_text, s_btn_link: section.settings.button_1_link, section: section %}
          {% endif %}

        {% comment %} CASE 6: GENERIC BLOCKS {% endcomment %}
        {% elsif slide_source == 'generic_blocks' %}
          {% for block in section.blocks %}
            {% if block.type == 'product_banner' and block.settings.product == blank and block.settings.desktop_image != blank %}
              {% assign s_desk = block.settings.desktop_image %}
              {% assign s_mob = block.settings.mobile_image | default: s_desk %}
              {% assign s_link = block.settings.banner_link | default: section.settings.banner_link %}
              {% assign s_heading = block.settings.heading | default: section.settings.heading %}
              {% assign s_subheading = block.settings.subheading | default: section.settings.subheading %}
              {% assign s_badge = section.settings.badge_text %}
              {% assign s_btn_text = block.settings.button_text | default: section.settings.button_1_text %}
              {% assign s_btn_link = block.settings.button_link | default: section.settings.button_1_link %}
              {% render 'banner-slide-item', s_desk: s_desk, s_mob: s_mob, s_link: s_link, s_heading: s_heading, s_subheading: s_subheading, s_badge: s_badge, s_btn_text: s_btn_text, s_btn_link: s_btn_link, section: section, forloop: forloop %}
            {% endif %}
          {% endfor %}

        {% comment %} CASE 7: SECTION SETTINGS FALLBACK {% endcomment %}
        {% elsif slide_source == 'section_settings' %}
          {% assign s_desk = section.settings.desktop_image %}
          {% assign s_mob = section.settings.mobile_image | default: s_desk %}
          {% assign s_desk_url = section.settings.desktop_image_url %}
          {% assign s_mob_url = section.settings.mobile_image_url | default: s_desk_url %}
          {% assign s_link = section.settings.banner_link %}
          {% assign s_heading = section.settings.heading %}
          {% assign s_subheading = section.settings.subheading %}
          {% assign s_badge = section.settings.badge_text %}
          {% assign s_btn_text = section.settings.button_1_text %}
          {% assign s_btn_link = section.settings.button_1_link %}
          {% render 'banner-slide-item', s_desk: s_desk, s_mob: s_mob, s_desk_url: s_desk_url, s_mob_url: s_mob_url, s_link: s_link, s_heading: s_heading, s_subheading: s_subheading, s_badge: s_badge, s_btn_text: s_btn_text, s_btn_link: s_btn_link, section: section, is_first: true %}

        {% else %}
          <div class="ayova-banner-slide active">
            <div class="ayova-banner-media-container height-desk-{{ section.settings.desktop_height }} height-mob-{{ section.settings.mobile_height }}">
              <div class="ayova-banner-placeholder">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <span>Upload Banners in Metaobjects or Theme Editor Blocks</span>
              </div>
            </div>
          </div>
        {% endif %}

      </div>

      {% comment %} Slider Controls (when in slider mode and multiple slides exist) {% endcomment %}
      {% if is_slider and total_slides > 1 %}
        {% if section.settings.slider_show_arrows %}
          <button type="button" class="ayova-slider-btn ayova-slider-prev" aria-label="Previous banner">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="ayova-slider-btn ayova-slider-next" aria-label="Next banner">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        {% endif %}

        {% if section.settings.slider_show_dots %}
          <div class="ayova-slider-dots">
            {% for i in (1..total_slides) %}
              <button type="button" class="ayova-slider-dot {% if forloop.first %}active{% endif %}" data-slide-index="{{ forloop.index0 }}" aria-label="Go to banner slide {{ forloop.index }}"></button>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}

    </div>

  </div>
</section>
{% endunless %}

<style>
