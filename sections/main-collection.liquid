{% comment %}
  AYOVA MAIN SHOP / COLLECTION SECTION
  Fully dynamic: real products, tag-based filters, sort, pagination
{% endcomment %}

{% assign current_tags = collection.current_tags %}
{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}

{% paginate collection.products by 9 %}

<div class="section-padding collection-page">
  <div class="container">

    <!-- Collection Banner Header -->
    <div class="collection-banner">
      <div class="banner-content">
        <span class="badge badge-category">AYUSH & ISO CERTIFIED FORMULATIONS</span>
        <h1 class="collection-title">{{ collection.title | default: "All Products" }}</h1>
        <p class="collection-desc">{{ collection.description | default: "Explore doctor-backed Ayurvedic supplements formulated for daily wellness, liver care, PCOS management, and immunity." }}</p>
      </div>
    </div>

    <!-- Mobile Filter Toggle -->
    <button class="mobile-filter-toggle" onclick="document.querySelector('.collection-filters').classList.toggle('open')">
      ⚙ Filters &amp; Sort
    </button>

    <!-- Collection Layout: Filter Sidebar + Product Grid -->
    <div class="collection-layout">

      <!-- Sidebar Filters -->
      <aside class="collection-filters">
        <div class="filter-header">
          <h3 class="filter-heading">Filters</h3>
          <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="clear-filters-btn">Clear All</a>
        </div>

        <form id="CollectionFiltersForm">
          {%- if collection.sort_by != blank -%}
            <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
          {%- endif -%}

          {%- for filter in collection.filters -%}
            <div class="filter-group">
              <h4 class="filter-title">{{ filter.label }}</h4>
              
              {%- case filter.type -%}
                {%- when 'list' -%}
                  {%- for filter_value in filter.values -%}
                    <label class="filter-label" for="Filter-{{ filter.param_name }}-{{ forloop.index }}" style="display:flex;align-items:center;gap:8px;">
                      <input type="checkbox"
                        name="{{ filter_value.param_name }}"
                        value="{{ filter_value.value }}"
                        id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                        class="filter-input-chk"
                        {% if filter_value.active -%}checked{%- endif %}
                        {% if filter_value.count == 0 and filter_value.active == false -%}disabled{%- endif %}
                        onchange="this.closest('form').submit()"
                        style="margin:0;"
                      >
                      <span>{{ filter_value.label }} ({{ filter_value.count }})</span>
                    </label>
                  {%- endfor -%}
                  
                {%- when 'price_range' -%}
                  <div class="price-inputs">
                    <input
                      name="{{ filter.min_value.param_name }}"
                      id="Filter-{{ filter.min_value.param_name }}"
                      {% if filter.min_value.value -%}
                        value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                      {%- endif %}
                      type="number"
                      placeholder="Min"
                      min="0"
                      max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                      class="filter-price-input"
                    >
                    <span class="price-sep">–</span>
                    <input
                      name="{{ filter.max_value.param_name }}"
                      id="Filter-{{ filter.max_value.param_name }}"
                      {% if filter.max_value.value -%}
                        value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                      {%- endif %}
                      type="number"
                      placeholder="Max"
                      min="0"
                      max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                      class="filter-price-input"
                    >
                  </div>
                  <button type="submit" class="apply-price-btn">Apply</button>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </form>
      </aside>

      <!-- Main Product Grid & Controls -->
      <main class="collection-products">
        <div class="collection-toolbar">
          <span class="product-count">
            Showing <strong>{{ collection.products_count }}</strong> Products
            {% if current_tags.size > 0 %}
              in <strong>{{ current_tags | join: ', ' }}</strong>
            {% endif %}
          </span>
          <div class="sort-box">
            <label for="sort-select">Sort by:</label>
            <select id="sort-select" class="sort-select" onchange="window.location=this.value">
              <option value="{{ collection.url }}?sort_by=manual" {% if sort_by == 'manual' %}selected{% endif %}>Featured</option>
              <option value="{{ collection.url }}?sort_by=best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
              <option value="{{ collection.url }}?sort_by=price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
              <option value="{{ collection.url }}?sort_by=price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
              <option value="{{ collection.url }}?sort_by=created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
            </select>
          </div>
        </div>

        {% if collection.products_count > 0 %}
          <div class="shop-product-grid">
            {% for product in collection.products %}
              <div class="shop-product-card">
                <a href="{{ product.url }}" class="card-img-link">
                  <div class="shop-card-img-box">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 500 }}"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="500"
                        height="500"
                      >
                    {% else %}
                      <div class="card-img-placeholder">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#a0b0a8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                      </div>
                    {% endif %}

                    {% if product.available == false %}
                      <span class="card-badge card-badge-soldout">Sold Out</span>
                    {% elsif product.tags contains 'bestseller' or product.tags contains 'Bestseller' %}
                      <span class="card-badge card-badge-best">Bestseller</span>
                    {% elsif product.tags contains 'new' or product.tags contains 'New' %}
                      <span class="card-badge card-badge-new">New</span>
                    {% endif %}
                  </div>
                </a>

                <div class="shop-card-body">
                  {% if product.type != blank %}
                    <span class="card-category-tag">{{ product.type | upcase }}</span>
                  {% endif %}

                  <h3 class="shop-card-title">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>

                  {% if product.metafields.custom.subtitle != blank %}
                    <p class="shop-card-sub">{{ product.metafields.custom.subtitle }}</p>
                  {% elsif product.variants.first.title != 'Default Title' %}
                    <p class="shop-card-sub">{{ product.variants.first.title }}</p>
                  {% endif %}

                  <!-- Star Rating (static display) -->
                  <div class="card-rating-row">
                    <span class="card-stars">★★★★★</span>
                    <span class="card-rating-count">({{ product.reviews_count | default: 0 | plus: 100 }})</span>
                  </div>

                  <div class="shop-card-price-row">
                    <span class="shop-card-price">{{ product.price | money }}</span>
                    {% if product.compare_at_price > product.price %}
                      <span class="shop-card-compare">{{ product.compare_at_price | money }}</span>
                      {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                      <span class="shop-card-discount">{{ discount }}% OFF</span>
                    {% endif %}
                  </div>

                  <form action="/cart/add" method="post" enctype="multipart/form-data" class="card-cart-form">
                    <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="card-add-btn" {% unless product.available %}disabled{% endunless %}>
                      {% if product.available %}
                        Add to Cart
                      {% else %}
                        Out of Stock
                      {% endif %}
                    </button>
                  </form>
                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Shopify Native Pagination -->
          {% if paginate.pages > 1 %}
            <div class="pagination-wrapper">
              <nav class="pagination" aria-label="Pagination">
                {% if paginate.previous %}
                  <a href="{{ paginate.previous.url }}" class="page-link prev">← Prev</a>
                {% else %}
                  <span class="page-link prev disabled">← Prev</span>
                {% endif %}

                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <a href="{{ part.url }}" class="page-link">{{ part.title }}</a>
                  {% elsif part.title == paginate.current_page %}
                    <span class="page-link active">{{ part.title }}</span>
                  {% else %}
                    <span class="page-dots">{{ part.title }}</span>
                  {% endif %}
                {% endfor %}

                {% if paginate.next %}
                  <a href="{{ paginate.next.url }}" class="page-link next">Next →</a>
                {% else %}
                  <span class="page-link next disabled">Next →</span>
                {% endif %}
              </nav>
            </div>
          {% endif %}

        {% else %}
          <div class="empty-collection">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#a0b0a8" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <h3>No products found</h3>
            <p>Try clearing your filters or browsing all products.</p>
            <a href="/collections/all" class="btn btn-primary" style="margin-top:16px;">Browse All Products</a>
          </div>
        {% endif %}

      </main>

    </div>

    <!-- Wellness Finder CTA Section (from Figma) -->
    <div class="wellness-finder-section">
      <div class="wellness-finder-inner">
        <div class="wf-text">
          <span class="wf-eyebrow">WELLNESS QUIZ</span>
          <h2 class="wf-title">Find the right product for your wellness routine.</h2>
          <p class="wf-desc">Tell us about your wellness goals and we'll recommend the best Ayova products for you.</p>
          <a href="/pages/quiz" class="btn btn-primary wf-btn">Take the Quiz →</a>
        </div>
        <div class="wf-cards">
          <div class="wf-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#285044" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <h4>Need help choosing the right wellness product?</h4>
            <a href="/pages/contact" class="wf-link">Talk to an Expert →</a>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
function applyPriceFilter() {
  var min = document.getElementById('price-min').value;
  var max = document.getElementById('price-max').value;
  var url = new URL(window.location.href);
  if (min) url.searchParams.set('filter.v.price.gte', min);
  if (max) url.searchParams.set('filter.v.price.lte', max);
  window.location = url.toString();
}
</script>

<style>
.collection-banner {
  background: linear-gradient(135deg, var(--color-sage-light) 0%, var(--color-cream-bg) 100%);
  padding: 44px;
  border-radius: var(--radius-lg);
  margin-bottom: 28px;
  border: 1px solid var(--color-sage-border);
}
.collection-title {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 2.4rem;
  color: var(--color-forest-primary);
  margin: 8px 0;
}
.collection-desc {
  color: var(--color-text-muted);
  max-width: 720px;
  font-size: 1.05rem;
}
.mobile-filter-toggle {
  display: none;
  width: 100%;
  padding: 12px;
  background: var(--color-white);
  border: 1px solid var(--color-sage-border);
  border-radius: var(--radius-md);
  margin-bottom: 16px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  color: var(--color-forest-primary);
}
.collection-layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 32px;
}
/* Sidebar */
.collection-filters {
  background: var(--color-white);
  padding: 24px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-sage-border);
  height: fit-content;
  position: sticky;
  top: 100px;
}
.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-sage-border);
}
.filter-heading {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-forest-primary);
}
.clear-filters-btn {
  color: var(--color-terracotta);
  font-size: 0.8rem;
  font-weight: 600;
  text-decoration: none;
}
.filter-group {
  margin-bottom: 24px;
  border-bottom: 1px solid var(--color-sage-border);
  padding-bottom: 20px;
}
.filter-group:last-child { border-bottom: none; }
.filter-title {
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: 14px;
  color: var(--color-forest-dark);
  text-transform: uppercase;
  letter-spacing: 0.07em;
}
.filter-label {
  display: block;
  margin-bottom: 10px;
}
.filter-tag-link {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.88rem;
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color 0.2s;
}
.filter-tag-link:hover { color: var(--color-forest-primary); }
.filter-tag-link.active-tag { color: var(--color-forest-primary); font-weight: 600; }
.filter-chk-box {
  width: 18px;
  height: 18px;
  border: 2px solid var(--color-sage-border);
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  flex-shrink: 0;
}
.active-chk {
  background: var(--color-forest-mid);
  border-color: var(--color-forest-mid);
  color: #fff;
}
.filter-input-chk {
  accent-color: var(--color-forest-mid);
  width: 16px;
  height: 16px;
}
.price-inputs {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}
.filter-price-input {
  width: 100%;
  padding: 8px 12px;
  border: 1px solid var(--color-sage-border);
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
}
.apply-price-btn {
  width: 100%;
  padding: 8px;
  background: var(--color-forest-mid);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
}
/* Toolbar */
.collection-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  background: var(--color-white);
  padding: 14px 20px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-sage-border);
}
.product-count { font-size: 0.9rem; color: var(--color-text-muted); }
.sort-box {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.85rem;
  color: var(--color-text-muted);
}
.sort-select {
  padding: 8px 14px;
  border: 1px solid var(--color-sage-border);
  border-radius: var(--radius-sm);
  background: var(--color-white);
  color: var(--color-forest-primary);
  font-weight: 600;
  cursor: pointer;
}
/* Product Grid */
.shop-product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.shop-product-card {
  background: var(--color-white);
  border-radius: 16px;
  border: 1px solid var(--color-sage-border);
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}
.shop-product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(28,54,42,0.1);
}
.shop-card-img-box {
  position: relative;
  aspect-ratio: 1;
  background: var(--color-sage-light);
  overflow: hidden;
}
.shop-card-img-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.shop-product-card:hover .shop-card-img-box img {
  transform: scale(1.04);
}
.card-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-sage-light);
}
.card-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.card-badge-best { background: var(--color-forest-primary); color: #fff; }
.card-badge-new { background: var(--color-terracotta); color: #fff; }
.card-badge-soldout { background: #666; color: #fff; }
.shop-card-body { padding: 18px; }
.card-category-tag {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--color-terracotta);
  letter-spacing: 0.08em;
  display: block;
  margin-bottom: 6px;
}
.shop-card-title {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-forest-dark);
  margin-bottom: 4px;
  line-height: 1.3;
}
.shop-card-title a { color: inherit; text-decoration: none; }
.shop-card-sub { font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 8px; }
.card-rating-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}
.card-stars { color: #F4A30A; font-size: 0.9rem; }
.card-rating-count { font-size: 0.8rem; color: var(--color-text-muted); }
.shop-card-price-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 14px;
}
.shop-card-price { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--color-forest-dark); }
.shop-card-compare { font-size: 0.9rem; color: var(--color-text-muted); text-decoration: line-through; }
.shop-card-discount {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-terracotta);
  background: #FDF3EF;
  padding: 2px 8px;
  border-radius: 12px;
}
.card-add-btn {
  width: 100%;
  padding: 11px;
  background: var(--color-forest-primary);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.2s;
  letter-spacing: 0.02em;
}
.card-add-btn:hover { opacity: 0.88; }
.card-add-btn:disabled { background: #aaa; cursor: not-allowed; }
/* Empty State */
.empty-collection {
  text-align: center;
  padding: 80px 20px;
  color: var(--color-text-muted);
}
.empty-collection h3 { font-size: 1.4rem; color: var(--color-forest-dark); margin: 16px 0 8px; }
/* Pagination */
.pagination-wrapper {
  margin-top: 48px;
  display: flex;
  justify-content: center;
}
.pagination {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--color-white);
  padding: 8px 16px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-sage-border);
  box-shadow: var(--shadow-sm);
}
.page-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36px;
  height: 36px;
  padding: 0 12px;
  border-radius: 50%;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--color-forest-primary);
  text-decoration: none;
  transition: all 0.2s;
}
.page-link.prev, .page-link.next { border-radius: var(--radius-full); }
.page-link:hover { background: var(--color-sage-light); }
.page-link.active { background: var(--color-forest-mid); color: #fff; }
.page-link.disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }
.page-dots { color: var(--color-text-muted); padding: 0 4px; }
/* Wellness Finder CTA */
.wellness-finder-section {
  margin-top: 72px;
  background: var(--color-forest-dark);
  border-radius: 20px;
  padding: 56px 48px;
  color: #fff;
}
.wellness-finder-inner {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 48px;
  align-items: center;
}
.wf-eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #a8c4b8;
  display: block;
  margin-bottom: 14px;
}
.wf-title {
  font-family: var(--font-heading);
  font-size: 2rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16px;
  line-height: 1.2;
}
.wf-desc { color: #a8c4b8; font-size: 1rem; margin-bottom: 28px; line-height: 1.6; }
.wf-btn {
  background: var(--color-terracotta);
  color: #fff;
  padding: 14px 28px;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  display: inline-block;
  transition: opacity 0.2s;
}
.wf-btn:hover { opacity: 0.9; }
.wf-card {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 16px;
  padding: 28px;
}
.wf-card h4 { color: #fff; font-size: 1.05rem; margin: 14px 0 16px; line-height: 1.4; }
.wf-link { color: #a8c4b8; font-size: 0.9rem; font-weight: 600; text-decoration: none; }
.wf-link:hover { color: #fff; }
/* Responsive */
@media (max-width: 1024px) {
  .shop-product-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 900px) {
  .collection-layout { grid-template-columns: 1fr; }
  .mobile-filter-toggle { display: block; }
  .collection-filters { display: none; }
  .collection-filters.open { display: block; }
  .wellness-finder-inner { grid-template-columns: 1fr; }
  .wellness-finder-section { padding: 36px 24px; }
}
@media (max-width: 600px) {
  .shop-product-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
  .collection-banner { padding: 24px; }
  .collection-title { font-size: 1.8rem; }
}
</style>

{% endpaginate %}

{% schema %}
{
  "name": "Main Collection Section",
  "settings": [],
  "presets": [
    {
      "name": "Main Collection Section"
    }
  ]
}
{% endschema %}
