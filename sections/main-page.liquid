{% comment %}
  AYOVA MAIN PAGE SECTION
{% endcomment %}

<section class="section-padding main-page-section">
  <div class="container" style="max-width: 900px;">
    <h1 class="page-title text-center" style="font-family: var(--font-serif); font-size: 2.5rem; margin-bottom: 24px;">
      {{ page.title }}
    </h1>
    <div class="page-content rte" style="line-height: 1.8; font-size: 1.05rem; color: var(--color-text-main);">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Page",
  "settings": [],
  "presets": [
    {
      "name": "Main Page"
    }
  ]
}
{% endschema %}
