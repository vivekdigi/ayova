<div class="watch-and-shop-section section-padding">
  <div class="container">
    {% if section.settings.title != blank %}
      <h2 class="watch-shop-title">{{ section.settings.title | escape }}</h2>
    {% endif %}

    <div class="ws-slider-wrapper">
      <button class="ws-nav-btn ws-prev" aria-label="Previous">←</button>
      <div class="watch-shop-grid" id="ws-grid-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="watch-shop-card" {{ block.shopify_attributes }}>
            <div class="ws-video-container">
              
              {% if block.settings.poster != blank %}
                <img src="{{ block.settings.poster | image_url: width: 400 }}" alt="Poster" class="ws-poster">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ws-poster placeholder-svg' }}
              {% endif %}

              {% if block.settings.mp4_video != blank %}
                <video class="ws-video-element" autoplay muted loop playsinline>
                  {% for source in block.settings.mp4_video.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                </video>
              {% elsif block.settings.youtube_url != blank %}
                <iframe class="ws-youtube-player" src="https://www.youtube.com/embed/{{ block.settings.youtube_url.id }}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&loop=1&playlist={{ block.settings.youtube_url.id }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              {% endif %}

            </div>
            
            <div class="ws-product-info">
              {% if block.settings.product != blank %}
                <div class="ws-product-header">
                  <img src="{{ block.settings.product.featured_image | image_url: width: 60 }}" alt="{{ block.settings.product.title }}" class="ws-product-thumb">
                  <div class="ws-product-details">
                    <span class="ws-product-title">{{ block.settings.product.title | truncate: 35 }}</span>
                    <span class="ws-product-price">{{ block.settings.product.price | money }}</span>
                  </div>
                </div>
                <form method="post" action="/cart/add" class="ws-add-to-cart-form">
                  <input type="hidden" name="id" value="{{ block.settings.product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="ws-buy-btn">Add to Cart</button>
                </form>
              {% else %}
                <div class="ws-product-header">
                  <div class="ws-product-thumb placeholder-svg"></div>
                  <div class="ws-product-details">
                    <span class="ws-product-title">Sample Product Name</span>
                    <span class="ws-product-price">Rs. 999</span>
                  </div>
                </div>
                <button type="button" class="ws-buy-btn">Add to Cart</button>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      <button class="ws-nav-btn ws-next" aria-label="Next">→</button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const grid = document.getElementById('ws-grid-{{ section.id }}');
  const prevBtn = grid.parentElement.querySelector('.ws-prev');
  const nextBtn = grid.parentElement.querySelector('.ws-next');

  if(prevBtn && nextBtn && grid) {
    prevBtn.addEventListener('click', () => {
      grid.scrollBy({ left: -300, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      grid.scrollBy({ left: 300, behavior: 'smooth' });
    });
  }
});
</script>

<style>
.ws-slider-wrapper {
  position: relative;
}
.ws-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  background: #fff;
  border: 1px solid #eaeaea;
  border-radius: 50%;
  font-size: 1.2rem;
  color: #333;
  cursor: pointer;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  transition: background 0.2s, color 0.2s;
}
.ws-nav-btn:hover {
  background: var(--color-forest-dark, #1a3c34);
  color: #fff;
}
.ws-prev { left: 10px; }
.ws-next { right: 10px; }

@media (max-width: 1024px) {
  .ws-prev { left: 5px; }
  .ws-next { right: 5px; }
}

.watch-and-shop-section {
  background: #fff;
  padding: 60px 0;
}
.watch-shop-title {
  text-align: center;
  font-family: var(--font-heading);
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--color-forest-dark);
  margin-bottom: 40px;
}
.watch-shop-grid {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  padding-bottom: 20px;
  scroll-snap-type: x mandatory;
  justify-content: center; /* Center if there are exactly 4 or less */
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none;  /* IE and Edge */
}
.watch-shop-grid::-webkit-scrollbar {
  display: none; /* Chrome, Safari and Opera */
}
.watch-shop-card {
  flex: 0 0 calc(25% - 12px); /* 4 items per row */
  min-width: 240px;
  max-width: 300px;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.08);
  border: 1px solid #eaeaea;
  display: flex;
  flex-direction: column;
  scroll-snap-align: start;
}
.ws-video-container {
  position: relative;
  width: 100%;
  aspect-ratio: 9/16;
  background: #000;
  overflow: hidden;
}
.ws-poster {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  object-fit: cover;
  z-index: 1;
}
.ws-video-element, .ws-youtube-player {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  object-fit: cover;
  z-index: 2;
  pointer-events: none; /* prevents youtube clicks from pausing the background video */
}
.ws-product-info {
  padding: 12px;
  background: #fff;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  justify-content: space-between;
}
.ws-product-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}
.ws-product-thumb {
  width: 40px; height: 40px;
  border-radius: 6px;
  object-fit: cover;
  background: #f4f4f4;
}
.ws-product-details {
  display: flex;
  flex-direction: column;
}
.ws-product-title {
  font-size: 0.85rem;
  font-weight: 600;
  color: #333;
  line-height: 1.2;
}
.ws-product-price {
  font-size: 0.8rem;
  color: #666;
  margin-top: 4px;
}
.ws-buy-btn {
  display: block;
  width: 100%;
  text-align: center;
  background: #000;
  color: #fff;
  padding: 10px;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: background 0.2s;
  margin-top: auto;
}
.ws-buy-btn:hover {
  background: var(--color-terracotta);
}

@media (max-width: 768px) {
  .watch-shop-card {
    flex: 0 0 70%;
  }
}
</style>

{% schema %}
{
  "name": "Watch & Shop",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Watch & Shop"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video Card",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Thumbnail / Poster Image",
          "info": "Fallback image before video loads."
        },
        {
          "type": "video",
          "id": "mp4_video",
          "label": "MP4 Video",
          "info": "Upload an MP4 for best auto-play experience."
        },
        {
          "type": "video_url",
          "id": "youtube_url",
          "accept": ["youtube"],
          "label": "YouTube URL",
          "info": "Fallback if MP4 is not provided."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Linked Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Watch & Shop",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
