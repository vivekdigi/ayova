{% comment %}
  AYOVA COMBO KITS & VALUE PACKS SECTION
  Figma Spec: Centered title "Complete Care COMBOS", 3-column product cards with rating, compare prices, CTA
{% endcomment %}

{% assign header_alignment = section.settings.header_alignment | default: 'center' %}
{% assign items_desktop = section.settings.items_per_view | default: 3 %}

<section class="section-padding combo-kits-section" id="combos">
  <div class="container">
    {% if header_alignment == 'center' %}
      <div class="wellness-header-centered">
        {% if section.settings.badge_text != blank %}
          <span class="badge badge-accent">{{ section.settings.badge_text }}</span>
        {% endif %}
        <h2 class="section-title">{{ section.settings.title | default: "Complete Care COMBOS" }}</h2>
        <p class="section-subtitle">{{ section.settings.subtitle | default: "Curated multi-product kits designed by doctors for holistic healing" }}</p>
      </div>
    {% else %}
      <div class="wellness-header-row">
        <div>
          {% if section.settings.badge_text != blank %}
            <span class="badge badge-accent">{{ section.settings.badge_text }}</span>
          {% endif %}
          <h2 class="section-title">{{ section.settings.title | default: "Complete Care COMBOS" }}</h2>
          <p class="section-subtitle">{{ section.settings.subtitle | default: "Curated multi-product kits designed by doctors for holistic healing" }}</p>
        </div>

        <div class="ayova-carousel-nav">
          <button type="button" class="ayova-carousel-btn" data-carousel-prev aria-label="Previous">←</button>
          <button type="button" class="ayova-carousel-btn" data-carousel-next aria-label="Next">→</button>
        </div>
      </div>
    {% endif %}

    <div class="ayova-carousel-wrapper" data-ayova-carousel data-items-per-view="{{ items_desktop }}" data-gap="24">
      <div class="ayova-carousel-track">

        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="ayova-carousel-slide" {{ block.shopify_attributes }}>
              <div class="ayova-product-card">
                <div class="card-image-wrapper">
                  {% if block.settings.badge != blank %}
                    <span class="card-badge">{{ block.settings.badge }}</span>
                  {% endif %}
                  <img src="{{ block.settings.image | default: 'https://images.unsplash.com/photo-1617897903246-719242758050?w=600&auto=format&fit=crop&q=80' }}" alt="{{ block.settings.title | escape }}" class="card-img">
                </div>
                <div class="card-info">
                  <span class="card-category-tag">{{ block.settings.tag | default: "COMPLETE CARE KIT" }}</span>
                  <h3 class="card-title"><a href="#">{{ block.settings.title }}</a></h3>
                  <p class="card-meta">{{ block.settings.pack_size | default: "2 Products Kit" }}</p>
                  <div class="card-rating">
                    <span class="rating-stars">★★★★★</span>
                    <span class="rating-count">({{ block.settings.reviews | default: "180" }})</span>
                  </div>
                  <div class="card-price-row">
                    <div class="card-price">
                      <span class="price-from">From</span>
                      <span class="price-amount">Rs. {{ block.settings.price | default: "749.00" }}</span>
                      {% if block.settings.compare_price != blank %}
                        <span class="price-compare">Rs. {{ block.settings.compare_price }}</span>
                      {% endif %}
                    </div>
                    <span class="price-gst">inc. of GST</span>
                  </div>
                  <button type="button" class="btn btn-primary card-add-btn" data-add-to-cart>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                    Add Kit to Cart
                  </button>
                </div>
              </div>
            </div>
          {% endfor %}

        {% else %}
          <!-- Default Fallback Combo Cards -->
          <div class="ayova-carousel-slide">
            <div class="ayova-product-card">
              <div class="card-image-wrapper">
                <span class="card-badge">SAVE 25%</span>
                <img src="https://images.unsplash.com/photo-1617897903246-719242758050?w=600&auto=format&fit=crop&q=80" alt="Milk Thistle & Liver Care Combo" class="card-img">
              </div>
              <div class="card-info">
                <span class="card-category-tag">LIVER CARE</span>
                <h3 class="card-title"><a href="#combos">Milk Thistle & Liver Care Combo</a></h3>
                <p class="card-meta">2 Pack Combo</p>
                <div class="card-rating"><span class="rating-stars">★★★★★</span><span class="rating-count">(205)</span></div>
                <div class="card-price-row">
                  <div class="card-price"><span class="price-from">From</span><span class="price-amount">Rs. 749.00</span><span class="price-compare">Rs. 998.00</span></div>
                  <span class="price-gst">inc. of GST</span>
                </div>
                <button type="button" class="btn btn-primary card-add-btn" data-add-to-cart>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                  Add Kit to Cart
                </button>
              </div>
            </div>
          </div>

          <div class="ayova-carousel-slide">
            <div class="ayova-product-card">
              <div class="card-image-wrapper">
                <span class="card-badge">BEST VALUE</span>
                <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=600&auto=format&fit=crop&q=80" alt="PCOS Care & Metabolism Combo" class="card-img">
              </div>
              <div class="card-info">
                <span class="card-category-tag">WOMEN'S HEALTH</span>
                <h3 class="card-title"><a href="#combos">PCOS Care & Metabolism Combo</a></h3>
                <p class="card-meta">2 Pack Combo</p>
                <div class="card-rating"><span class="rating-stars">★★★★★</span><span class="rating-count">(184)</span></div>
                <div class="card-price-row">
                  <div class="card-price"><span class="price-from">From</span><span class="price-amount">Rs. 799.00</span><span class="price-compare">Rs. 1,049.00</span></div>
                  <span class="price-gst">inc. of GST</span>
                </div>
                <button type="button" class="btn btn-primary card-add-btn" data-add-to-cart>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                  Add Kit to Cart
                </button>
              </div>
            </div>
          </div>

          <div class="ayova-carousel-slide">
            <div class="ayova-product-card">
              <div class="card-image-wrapper">
                <span class="card-badge">POPULAR</span>
                <img src="https://images.unsplash.com/photo-1512290900676-26c2a4d48dc1?w=600&auto=format&fit=crop&q=80" alt="Triphala & Probiotics Combo" class="card-img">
              </div>
              <div class="card-info">
                <span class="card-category-tag">GUT HEALTH</span>
                <h3 class="card-title"><a href="#combos">Triphala & Probiotics Digestive Kit</a></h3>
                <p class="card-meta">2 Pack Combo</p>
                <div class="card-rating"><span class="rating-stars">★★★★★</span><span class="rating-count">(167)</span></div>
                <div class="card-price-row">
                  <div class="card-price"><span class="price-from">From</span><span class="price-amount">Rs. 745.00</span><span class="price-compare">Rs. 970.00</span></div>
                  <span class="price-gst">inc. of GST</span>
                </div>
                <button type="button" class="btn btn-primary card-add-btn" data-add-to-cart>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                  Add Kit to Cart
                </button>
              </div>
            </div>
          </div>
        {% endif %}

      </div>

      <div class="ayova-carousel-dots" data-carousel-dots></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Combo Kits",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "VALUE PACKS & COMBOS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Complete Care COMBOS"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Curated multi-product kits designed by doctors for holistic healing"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "row",
          "label": "Row with Controls"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "items_per_view",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop Cards visible",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Kit",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Tag",
          "default": "SAVE 20%"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Category Tag",
          "default": "LIVER & GUT WELLNESS"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Kit Title",
          "default": "Liver Detox Kit"
        },
        {
          "type": "text",
          "id": "pack_size",
          "label": "Pack Size",
          "default": "2 Pack Combo"
        },
        {
          "type": "text",
          "id": "reviews",
          "label": "Review Count",
          "default": "205"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "749.00"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "998.00"
        },
        {
          "type": "text",
          "id": "image",
          "label": "Image URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combo Kits"
    }
  ]
}
{% endschema %}
