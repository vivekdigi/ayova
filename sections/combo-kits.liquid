{% comment %}
  AYOVA COMBO KITS & VALUE PACKS SECTION
  Figma Spec: Centered title "Complete Care COMBOS", 3-column product cards with rating, compare prices, CTA
{% endcomment %}

{% assign header_alignment = section.settings.header_alignment | default: 'center' %}
{% assign items_desktop = section.settings.items_per_view | default: 3 %}

<section class="section-padding combo-kits-section" id="combos">
  <div class="container">
    {% if header_alignment == 'center' %}
      <div class="wellness-header-centered">
        {% if section.settings.badge_text != blank %}
          <span class="badge badge-accent">{{ section.settings.badge_text }}</span>
        {% endif %}
        <h2 class="section-title">{{ section.settings.title | default: "Complete Care COMBOS" }}</h2>
        <p class="section-subtitle">{{ section.settings.subtitle | default: "Curated multi-product kits designed by doctors for holistic healing" }}</p>
      </div>
    {% else %}
      <div class="wellness-header-row">
        <div>
          {% if section.settings.badge_text != blank %}
            <span class="badge badge-accent">{{ section.settings.badge_text }}</span>
          {% endif %}
          <h2 class="section-title">{{ section.settings.title | default: "Complete Care COMBOS" }}</h2>
          <p class="section-subtitle">{{ section.settings.subtitle | default: "Curated multi-product kits designed by doctors for holistic healing" }}</p>
        </div>

        <div class="ayova-carousel-nav">
          <button type="button" class="ayova-carousel-btn" data-carousel-prev aria-label="Previous">←</button>
          <button type="button" class="ayova-carousel-btn" data-carousel-next aria-label="Next">→</button>
        </div>
      </div>
    {% endif %}

    <div class="ayova-carousel-wrapper" data-ayova-carousel data-items-per-view="{{ items_desktop }}" data-gap="24">
      <div class="ayova-carousel-track">

        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign block_prod = all_products[block.settings.product] %}
            <div class="ayova-carousel-slide" {{ block.shopify_attributes }}>
              {% render 'product-card',
                product: block_prod,
                title: block.settings.title,
                short_description: block.settings.short_description,
                category: block.settings.tag,
                pack: block.settings.pack_size,
                price: block.settings.price,
                compare_price: block.settings.compare_price,
                badge: block.settings.badge,
                reviews: block.settings.reviews,
                custom_image: block.settings.custom_image,
                image_url: block.settings.image,
                show_per_count: section.settings.show_per_count,
                per_count_text: block.settings.per_count_text
              %}
            </div>
          {% endfor %}

        {% else %}
          <!-- Default Fallback Combo Cards -->
          <div class="ayova-carousel-slide">
            {% render 'product-card',
              title: 'Milk Thistle & Liver Care Combo',
              category: 'LIVER CARE',
              pack: '2 Pack Combo',
              price: 'Rs. 749.00',
              compare_price: 'Rs. 998.00',
              badge: 'SAVE 25%',
              reviews: '205',
              image_url: 'https://images.unsplash.com/photo-1617897903246-719242758050?w=600&auto=format&fit=crop&q=80',
              show_per_count: section.settings.show_per_count
            %}
          </div>

          <div class="ayova-carousel-slide">
            {% render 'product-card',
              title: 'PCOS Care & Metabolism Combo',
              category: 'WOMEN\'S HEALTH',
              pack: '2 Pack Combo',
              price: 'Rs. 799.00',
              compare_price: 'Rs. 1,049.00',
              badge: 'BEST VALUE',
              reviews: '184',
              image_url: 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=600&auto=format&fit=crop&q=80',
              show_per_count: section.settings.show_per_count
            %}
          </div>

          <div class="ayova-carousel-slide">
            {% render 'product-card',
              title: 'Triphala & Probiotics Digestive Kit',
              category: 'GUT HEALTH',
              pack: '2 Pack Combo',
              price: 'Rs. 745.00',
              compare_price: 'Rs. 970.00',
              badge: 'POPULAR',
              reviews: '167',
              image_url: 'https://images.unsplash.com/photo-1512290900676-26c2a4d48dc1?w=600&auto=format&fit=crop&q=80',
              show_per_count: section.settings.show_per_count
            %}
          </div>
        {% endif %}

      </div>

      <div class="ayova-carousel-dots" data-carousel-dots></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Combo Kits",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "VALUE PACKS & COMBOS"
    },
    {
      "type": "checkbox",
      "id": "show_per_count",
      "label": "Enable Per Count Details",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Complete Care COMBOS"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Curated multi-product kits designed by doctors for holistic healing"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "row",
          "label": "Row with Controls"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "items_per_view",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop Cards visible",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Kit",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Shopify Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Tag",
          "default": "SAVE 20%"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Category Tag",
          "default": "LIVER & GUT WELLNESS"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Kit Title",
          "default": "Liver Detox Kit"
        },
        {
          "type": "textarea",
          "id": "short_description",
          "label": "Short Description (Fallback)"
        },
        {
          "type": "text",
          "id": "pack_size",
          "label": "Pack Size",
          "default": "2 Pack Combo"
        },
        {
          "type": "text",
          "id": "reviews",
          "label": "Review Count",
          "default": "205"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "749.00"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "998.00"
        },
        {
          "type": "text",
          "id": "per_count_text",
          "label": "Per Count Text (e.g. ₹58.10/count)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Product Image"
        },
        {
          "type": "text",
          "id": "image",
          "label": "Fallback Image URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combo Kits"
    }
  ]
}
{% endschema %}
