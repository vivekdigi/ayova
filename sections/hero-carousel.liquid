{% comment %}
  AYOVA HERO CAROUSEL SECTION
  Figma & Image 2 Spec: Dynamic Hero Carousel with Tagline, Headline, "Shop Now" pill CTA,
  Product Cluster image, Floating "+ Digestive Support" badge, and Decorative Palm Leaves.
{% endcomment %}

<section class="ayova-hero-section" style="background-color: transparent;">

  <div class="ayova-carousel-wrapper hero-carousel-container" data-ayova-carousel {% if section.settings.autoplay %}data-autoplay{% endif %} data-items-per-view="1" data-gap="0">
    <div class="ayova-carousel-track">

      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign highlight = block.settings.highlight_text | default: "Modern Wellness." %}
          {% assign span_tag = '<span class="highlight-text">' | append: highlight | append: '</span>' %}
          <div class="ayova-carousel-slide hero-slide" {{ block.shopify_attributes }}>
            {% if block.settings.title == blank and block.settings.subtag == blank %}
              <!-- Full Width Banner Mode -->
              <div class="hero-full-banner">
                {% if block.settings.button_link != blank %}
                  <a href="{{ block.settings.button_link }}">
                {% endif %}
                
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="Banner" class="hero-full-img">
                {% else %}
                  <img src="{{ block.settings.image_url | default: 'https://images.unsplash.com/photo-1617897903246-719242758050?w=2000&auto=format&fit=crop&q=80' }}" alt="Banner" class="hero-full-img">
                {% endif %}

                {% if block.settings.button_link != blank %}
                  </a>
                {% endif %}
              </div>
            {% else %}
              <!-- Standard Split Layout Mode -->
              <div class="container hero-slide-grid">
                <div class="hero-content">
                  {% if block.settings.subtag != blank %}
                    <span class="hero-sub-tag">{{ block.settings.subtag }}</span>
                  {% endif %}
                  
                  <h1 class="hero-title">
                    {% if block.settings.title != blank %}
                      {{ block.settings.title | replace: highlight, span_tag }}
                    {% else %}
                      Rooted in Ayurveda. <br>Made for <span class="highlight-text">Modern Wellness.</span>
                    {% endif %}
                  </h1>

                  {% if block.settings.description != blank %}
                    <p class="hero-description">{{ block.settings.description }}</p>
                  {% endif %}

                  <div class="hero-actions">
                    {% if block.settings.button_text != blank %}
                      <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="btn btn-primary btn-hero-pill">
                        {{ block.settings.button_text }}
                      </a>
                    {% endif %}

                    {% if block.settings.secondary_button_text != blank %}
                      <a href="{{ block.settings.secondary_button_link | default: '/pages/about' }}" class="btn btn-outline btn-hero-pill">
                        {{ block.settings.secondary_button_text }}
                      </a>
                    {% endif %}
                  </div>
                </div>

                <div class="hero-image-container">
                  <div class="hero-image-wrapper">
                    {% if block.settings.image != blank %}
                      <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" class="hero-img">
                    {% else %}
                      <img src="{{ block.settings.image_url | default: 'https://images.unsplash.com/photo-1617897903246-719242758050?w=900&auto=format&fit=crop&q=80' }}" alt="Ayova Formulations" class="hero-img">
                    {% endif %}
                  </div>

                  {% if block.settings.floating_badge != blank %}
                    <div class="hero-floating-badge">
                      <span class="badge-icon">+</span>
                      <span class="badge-text">{{ block.settings.floating_badge }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}

      {% else %}
        <!-- Default Slide 1 matching Figma Hero -->
        <div class="ayova-carousel-slide hero-slide">
          <div class="container hero-slide-grid">
            <div class="hero-content">
              <span class="hero-sub-tag">100% PURE &amp; NATURAL AYURVEDA</span>
              <h1 class="hero-title">
                Rooted in Ayurveda.<br>Made for <span class="highlight-text">Modern<br>Wellness.</span>
              </h1>
              <p class="hero-description">
                Clean, doctor-formulated herbal supplements designed for stress relief, digestive health, liver care, and daily vitality.
              </p>
              <div class="hero-actions">
                <a href="/collections/all" class="btn btn-primary btn-hero-pill">Shop Now</a>
                <a href="/pages/about" class="btn btn-outline btn-hero-pill">Learn More</a>
              </div>
              <!-- Category Pills row matching Figma -->
              <div class="hero-category-chips">
                <span class="hero-chip"><span class="chip-dot"></span>Digestive Support</span>
                <span class="hero-chip"><span class="chip-dot"></span>Liver Health</span>
                <span class="hero-chip"><span class="chip-dot"></span>Immunity</span>
              </div>
            </div>

            <div class="hero-image-container">
              <div class="hero-product-cluster">
                <!-- Decorative sage halo background -->
                <div class="hero-halo"></div>
                <!-- Multiple product bottle images stacked -->
                <div class="hero-product-main">
                  <img src="https://images.unsplash.com/photo-1587854692152-cbe660dbde88?w=280&auto=format&fit=crop&q=80" alt="Ayova Liver Care" class="hero-product-img hero-prod-center">
                </div>
                <div class="hero-product-side hero-prod-left">
                  <img src="https://images.unsplash.com/photo-1576602976047-174e57a47881?w=160&auto=format&fit=crop&q=80" alt="Ayova Milk Thistle" class="hero-product-img">
                </div>
                <div class="hero-product-side hero-prod-right">
                  <img src="https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=160&auto=format&fit=crop&q=80" alt="Ayova Supplement" class="hero-product-img">
                </div>
                <!-- Ground shadow -->
                <div class="hero-ground-shadow"></div>
              </div>

              <div class="hero-floating-badge">
                <span class="badge-icon">+</span>
                <span class="badge-text">Digestive Support</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Default Slide 2 -->
        <div class="ayova-carousel-slide hero-slide">
          <div class="container hero-slide-grid">
            <div class="hero-content">
              <span class="hero-sub-tag">100% NATURAL & LAB TESTED</span>
              <h1 class="hero-title">
                Pure Extracts. <br>Maximum <span class="highlight-text">Absorption.</span>
              </h1>
              <p class="hero-description">
                Formulated by leading doctors using standardized herbal concentrates for daily healing and vitality.
              </p>
              <div class="hero-actions">
                <a href="/collections/all" class="btn btn-primary btn-hero-pill">Explore Products →</a>
              </div>
            </div>

            <div class="hero-image-container">
              <div class="hero-image-wrapper">
                <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=900&auto=format&fit=crop&q=80" alt="Ayurvedic Formulations" class="hero-img">
              </div>

              <div class="hero-floating-badge">
                <span class="badge-icon">+</span>
                <span class="badge-text">Liver Detox</span>
              </div>
            </div>
          </div>
        </div>
      {% endif %}

    </div>

    <!-- Hero Carousel Controls & Navigation Dots -->
    <div class="hero-carousel-controls container">
      <div class="ayova-carousel-dots" data-carousel-dots></div>
    </div>
  </div>
</section>

<style>
.ayova-hero-section {
  position: relative;
  overflow: hidden;
  background-color: transparent;
  height: auto !important;
  max-width: 100%;
}

.hero-carousel-container {
  width: 100%;
  position: relative;
  z-index: 2;
  max-width: 100%;
}

.hero-carousel-controls {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  width: auto;
}

.hero-slide {
  width: 100% !important;
  height: auto !important;
  max-width: 100%;
}

.hero-full-banner {
  width: 100%;
  display: block;
  max-width: 100%;
}

.hero-full-img {
  width: 100%;
  height: auto;
  max-height: 600px;
  object-fit: cover;
  display: block;
  border-radius: 0;
  max-width: 100%;
}

.hero-slide-grid {
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  align-items: center;
  gap: 48px;
  padding: 56px 0 64px;
}

.hero-content {
  max-width: 580px;
}

.hero-sub-tag {
  color: var(--color-terracotta);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  display: inline-block;
  margin-bottom: 14px;
  text-transform: uppercase;
}

.hero-title {
  font-family: var(--font-heading) !important;
  font-weight: 700;
  font-size: 4rem;
  line-height: 1.08;
  color: #173E34;
  margin-bottom: 24px;
  letter-spacing: -0.01em;
}

.highlight-text {
  font-weight: 700;
  color: #285044;
  font-style: normal;
}

.hero-description {
  font-size: 1.05rem;
  color: var(--color-text-muted);
  margin-bottom: 32px;
  line-height: 1.6;
  max-width: 480px;
}

.hero-actions {
  display: flex;
  gap: 16px;
  align-items: center;
}

.btn-hero-pill {
  padding: 14px 34px;
  font-size: 0.95rem;
  font-weight: 700;
  border-radius: 9999px !important;
  background-color: #153D30;
  color: #FFFFFF;
  border: none;
  box-shadow: 0 4px 14px rgba(21, 61, 48, 0.2);
  transition: all 0.3s ease;
}

.btn-hero-pill:hover {
  background-color: #0E2920;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(21, 61, 48, 0.3);
}

.hero-image-container {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-image-wrapper {
  position: relative;
  width: 100%;
  max-width: 540px;
  border-radius: 20px;
  overflow: hidden;
  background: transparent;
}

.hero-img {
  width: 100%;
  height: auto;
  max-height: 480px;
  object-fit: contain;
  filter: drop-shadow(0 12px 24px rgba(21, 61, 48, 0.12));
}

/* Floating Badge Pill (Matching Image 2) */
.hero-floating-badge {
  position: absolute;
  bottom: 12px;
  right: 24px;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(21, 61, 48, 0.15);
  box-shadow: 0 8px 20px rgba(21, 61, 48, 0.1);
  padding: 8px 18px;
  border-radius: 9999px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  z-index: 5;
}

.badge-icon {
  font-weight: 700;
  font-size: 0.9rem;
  color: #153D30;
}

.badge-text {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  color: #153D30;
}

/* Category Chips in Hero (matching Figma category pill component) */
.hero-category-chips {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 24px;
}

.hero-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #F7F6F1;
  border: 1px solid #D7DED2;
  border-radius: 999px;
  padding: 6px 14px;
  font-family: 'Inter', sans-serif;
  font-weight: 500;
  font-size: 0.75rem;
  color: #203225;
  box-shadow: 0 6px 16px rgba(41, 55, 48, 0.08);
}

.chip-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #718066;
  flex-shrink: 0;
}

/* Product cluster layout for default hero */
.hero-product-cluster {
  position: relative;
  width: 100%;
  max-width: 520px;
  height: 480px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.hero-halo {
  position: absolute;
  top: 30px;
  left: 50%;
  transform: translateX(-50%);
  width: 430px;
  height: 340px;
  border-radius: 50%;
  background: transparent;
  pointer-events: none;
}

.hero-product-main {
  position: absolute;
  bottom: 60px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
}

.hero-product-img {
  height: auto;
  object-fit: contain;
  border-radius: 8px;
  filter: drop-shadow(0 12px 24px rgba(21, 61, 48, 0.15));
}

.hero-prod-center {
  width: 200px;
  max-height: 380px;
}

.hero-product-side {
  position: absolute;
  bottom: 70px;
  z-index: 2;
}

.hero-product-side img {
  width: 110px;
  max-height: 240px;
}

.hero-prod-left {
  left: 20px;
}

.hero-prod-right {
  right: 20px;
}

.hero-ground-shadow {
  position: absolute;
  bottom: 42px;
  left: 50%;
  transform: translateX(-50%);
  width: 380px;
  height: 40px;
  background: rgba(41, 55, 48, 0.12);
  border-radius: 50%;
  filter: blur(12px);
  z-index: 1;
}

@media (max-width: 1024px) {
  .hero-title {
    font-size: 2.8rem;
  }
  .hero-slide-grid {
    gap: 32px;
  }
}

@media (max-width: 768px) {
  .hero-slide-grid {
    padding: 36px 0 44px;
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero-content {
    margin: 0 auto;
  }
  .hero-title {
    font-size: 2.2rem;
  }
  .hero-description {
    margin: 0 auto 24px;
  }
  .hero-actions {
    justify-content: center;
  }
  .hero-floating-badge {
    bottom: 8px;
    right: 50%;
    transform: translateX(50%);
  }
  .hero-leaf-left, .hero-leaf-right {
    opacity: 0.5;
    scale: 0.7;
  }
}
</style>

{% schema %}
{
  "name": "Hero Carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "text",
          "id": "subtag",
          "label": "Subtag / Category Tag",
          "default": "100% PURE & NATURAL AYURVEDA"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Heading Text",
          "default": "Rooted in Ayurveda. Made for Modern Wellness."
        },
        {
          "type": "text",
          "id": "highlight_text",
          "label": "Highlighted/Bold Words in Heading",
          "default": "Modern Wellness."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Subtitle Description",
          "default": "Clean, doctor-formulated herbal supplements designed for stress relief, digestive health, liver care, and daily vitality."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Primary Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary Button URL"
        },
        {
          "type": "text",
          "id": "secondary_button_text",
          "label": "Secondary Button Label"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary Button URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Main Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Fallback Image URL"
        },
        {
          "type": "text",
          "id": "floating_badge",
          "label": "Floating Pill Badge Text",
          "default": "+ Digestive Support"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Carousel",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
