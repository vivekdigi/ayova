{% comment %}
  AYOVA HERO CAROUSEL SECTION
  Figma & Image 2 Spec: Dynamic Hero Carousel with Tagline, Headline, "Shop Now" pill CTA,
  Product Cluster image, Floating "+ Digestive Support" badge, and Decorative Palm Leaves.
{% endcomment %}

<section class="ayova-hero-section" style="background: {{ section.settings.background_color | default: '#FAF8F2' }};">
  {% if section.settings.show_leaf_decorations %}
    <!-- Decorative Palm Leaves (Bottom Left) -->
    <div class="hero-leaf-left" aria-hidden="true">
      <svg width="220" height="240" viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 210C35 150 75 90 150 40M150 40C120 40 85 60 50 110M150 40C140 70 120 115 80 160M150 40C165 65 170 100 155 140M150 40C120 25 80 25 30 50M150 40C175 25 190 20 195 10" stroke="#7A9A8B" stroke-width="3" stroke-linecap="round" opacity="0.45"/>
        <path d="M-10 190C15 130 55 70 130 20M130 20C100 20 65 40 30 90M130 20C120 50 100 95 60 140" stroke="#5A7D6E" stroke-width="2.5" stroke-linecap="round" opacity="0.35"/>
      </svg>
    </div>

    <!-- Decorative Palm Leaves (Top Right) -->
    <div class="hero-leaf-right" aria-hidden="true">
      <svg width="240" height="220" viewBox="0 0 220 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M210 10C160 35 100 75 40 150M40 150C40 120 60 85 110 50M40 150C70 140 115 120 160 80M40 150C65 165 100 170 140 155M40 150C25 120 25 80 50 30" stroke="#7A9A8B" stroke-width="3" stroke-linecap="round" opacity="0.45"/>
        <path d="M190 -10C140 15 80 55 20 130M20 130C20 100 40 65 90 30" stroke="#5A7D6E" stroke-width="2.5" stroke-linecap="round" opacity="0.35"/>
      </svg>
    </div>
  {% endif %}

  <div class="ayova-carousel-wrapper hero-carousel-container" data-ayova-carousel {% if section.settings.autoplay %}data-autoplay{% endif %} data-items-per-view="1">
    <div class="ayova-carousel-track">

      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign highlight = block.settings.highlight_text | default: "Modern Wellness." %}
          {% assign span_tag = '<span class="highlight-text">' | append: highlight | append: '</span>' %}
          <div class="ayova-carousel-slide hero-slide" {{ block.shopify_attributes }}>
            <div class="container hero-slide-grid">
              <div class="hero-content">
                {% if block.settings.subtag != blank %}
                  <span class="hero-sub-tag">{{ block.settings.subtag }}</span>
                {% endif %}
                
                <h1 class="hero-title">
                  {% if block.settings.title != blank %}
                    {{ block.settings.title | replace: highlight, span_tag }}
                  {% else %}
                    Rooted in Ayurveda. <br>Made for <span class="highlight-text">Modern Wellness.</span>
                  {% endif %}
                </h1>

                {% if block.settings.description != blank %}
                  <p class="hero-description">{{ block.settings.description }}</p>
                {% endif %}

                <div class="hero-actions">
                  {% if block.settings.button_text != blank %}
                    <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="btn btn-primary btn-hero-pill">
                      {{ block.settings.button_text }}
                    </a>
                  {% endif %}

                  {% if block.settings.secondary_button_text != blank %}
                    <a href="{{ block.settings.secondary_button_link | default: '/pages/about' }}" class="btn btn-outline btn-hero-pill">
                      {{ block.settings.secondary_button_text }}
                    </a>
                  {% endif %}
                </div>
              </div>

              <div class="hero-image-container">
                <div class="hero-image-wrapper">
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" class="hero-img">
                  {% else %}
                    <img src="{{ block.settings.image_url | default: 'https://images.unsplash.com/photo-1617897903246-719242758050?w=900&auto=format&fit=crop&q=80' }}" alt="Ayova Formulations" class="hero-img">
                  {% endif %}
                </div>

                {% if block.settings.floating_badge != blank %}
                  <div class="hero-floating-badge">
                    <span class="badge-icon">+</span>
                    <span class="badge-text">{{ block.settings.floating_badge }}</span>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}

      {% else %}
        <!-- Default Slide 1 matching Image 2 -->
        <div class="ayova-carousel-slide hero-slide">
          <div class="container hero-slide-grid">
            <div class="hero-content">
              <h1 class="hero-title">
                Rooted in Ayurveda. <br>Made for <span class="highlight-text">Modern <br>Wellness.</span>
              </h1>
              <p class="hero-description">
                Clean, doctor-formulated herbal supplements designed for stress relief, digestive health, liver care, and daily vitality.
              </p>
              <div class="hero-actions">
                <a href="/collections/all" class="btn btn-primary btn-hero-pill">Shop Now</a>
              </div>
            </div>

            <div class="hero-image-container">
              <div class="hero-image-wrapper">
                <img src="https://images.unsplash.com/photo-1617897903246-719242758050?w=900&auto=format&fit=crop&q=80" alt="Ayova Ayurvedic Products" class="hero-img">
              </div>

              <div class="hero-floating-badge">
                <span class="badge-icon">+</span>
                <span class="badge-text">Digestive Support</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Default Slide 2 -->
        <div class="ayova-carousel-slide hero-slide">
          <div class="container hero-slide-grid">
            <div class="hero-content">
              <span class="hero-sub-tag">100% NATURAL & LAB TESTED</span>
              <h1 class="hero-title">
                Pure Extracts. <br>Maximum <span class="highlight-text">Absorption.</span>
              </h1>
              <p class="hero-description">
                Formulated by leading doctors using standardized herbal concentrates for daily healing and vitality.
              </p>
              <div class="hero-actions">
                <a href="/collections/all" class="btn btn-primary btn-hero-pill">Explore Products →</a>
              </div>
            </div>

            <div class="hero-image-container">
              <div class="hero-image-wrapper">
                <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=900&auto=format&fit=crop&q=80" alt="Ayurvedic Formulations" class="hero-img">
              </div>

              <div class="hero-floating-badge">
                <span class="badge-icon">+</span>
                <span class="badge-text">Liver Detox</span>
              </div>
            </div>
          </div>
        </div>
      {% endif %}

    </div>

    <!-- Hero Carousel Controls & Navigation Dots -->
    <div class="hero-carousel-controls container">
      <div class="ayova-carousel-dots" data-carousel-dots></div>
    </div>
  </div>
</section>

<style>
.ayova-hero-section {
  position: relative;
  padding: 56px 0 64px;
  overflow: hidden;
  background-color: #FAF8F2;
}

/* Decorative Leaf Overlays */
.hero-leaf-left {
  position: absolute;
  bottom: -20px;
  left: -20px;
  z-index: 1;
  pointer-events: none;
  transform: rotate(-10deg);
}

.hero-leaf-right {
  position: absolute;
  top: -10px;
  right: -20px;
  z-index: 1;
  pointer-events: none;
  transform: rotate(15deg);
}

.hero-carousel-container {
  width: 100%;
  position: relative;
  z-index: 2;
}

.hero-slide {
  width: 100% !important;
}

.hero-slide-grid {
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  align-items: center;
  gap: 48px;
}

.hero-content {
  max-width: 580px;
}

.hero-sub-tag {
  color: var(--color-terracotta);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  display: inline-block;
  margin-bottom: 14px;
  text-transform: uppercase;
}

.hero-title {
  font-family: 'Plus Jakarta Sans', sans-serif !important;
  font-weight: 400;
  font-size: 3.6rem;
  line-height: 1.15;
  color: #153D30;
  margin-bottom: 24px;
  letter-spacing: -0.03em;
}

.highlight-text {
  font-weight: 800;
  color: #153D30;
}

.hero-description {
  font-size: 1.05rem;
  color: var(--color-text-muted);
  margin-bottom: 32px;
  line-height: 1.6;
  max-width: 480px;
}

.hero-actions {
  display: flex;
  gap: 16px;
  align-items: center;
}

.btn-hero-pill {
  padding: 14px 34px;
  font-size: 0.95rem;
  font-weight: 700;
  border-radius: 9999px !important;
  background-color: #153D30;
  color: #FFFFFF;
  border: none;
  box-shadow: 0 4px 14px rgba(21, 61, 48, 0.2);
  transition: all 0.3s ease;
}

.btn-hero-pill:hover {
  background-color: #0E2920;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(21, 61, 48, 0.3);
}

.hero-image-container {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-image-wrapper {
  position: relative;
  width: 100%;
  max-width: 540px;
  border-radius: 20px;
  overflow: hidden;
  background: transparent;
}

.hero-img {
  width: 100%;
  height: auto;
  max-height: 480px;
  object-fit: contain;
  filter: drop-shadow(0 12px 24px rgba(21, 61, 48, 0.12));
}

/* Floating Badge Pill (Matching Image 2) */
.hero-floating-badge {
  position: absolute;
  bottom: 12px;
  right: 24px;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(21, 61, 48, 0.15);
  box-shadow: 0 8px 20px rgba(21, 61, 48, 0.1);
  padding: 8px 18px;
  border-radius: 9999px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  z-index: 5;
}

.badge-icon {
  font-weight: 700;
  font-size: 0.9rem;
  color: #153D30;
}

.badge-text {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  color: #153D30;
}

.hero-carousel-controls {
  margin-top: 10px;
  position: relative;
  z-index: 10;
}

@media (max-width: 1024px) {
  .hero-title {
    font-size: 2.8rem;
  }
  .hero-slide-grid {
    gap: 32px;
  }
}

@media (max-width: 768px) {
  .ayova-hero-section {
    padding: 36px 0 44px;
  }
  .hero-slide-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero-content {
    margin: 0 auto;
  }
  .hero-title {
    font-size: 2.2rem;
  }
  .hero-description {
    margin: 0 auto 24px;
  }
  .hero-actions {
    justify-content: center;
  }
  .hero-floating-badge {
    bottom: 8px;
    right: 50%;
    transform: translateX(50%);
  }
  .hero-leaf-left, .hero-leaf-right {
    opacity: 0.5;
    scale: 0.7;
  }
}
</style>

{% schema %}
{
  "name": "Hero Carousel",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF8F2"
    },
    {
      "type": "checkbox",
      "id": "show_leaf_decorations",
      "label": "Show Decorative Leaf Overlays",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "text",
          "id": "subtag",
          "label": "Subtag / Category Tag",
          "default": "100% PURE & NATURAL AYURVEDA"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Heading Text",
          "default": "Rooted in Ayurveda. Made for Modern Wellness."
        },
        {
          "type": "text",
          "id": "highlight_text",
          "label": "Highlighted/Bold Words in Heading",
          "default": "Modern Wellness."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Subtitle Description",
          "default": "Clean, doctor-formulated herbal supplements designed for stress relief, digestive health, liver care, and daily vitality."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Primary Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary Button URL"
        },
        {
          "type": "text",
          "id": "secondary_button_text",
          "label": "Secondary Button Label"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary Button URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Main Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Fallback Image URL"
        },
        {
          "type": "text",
          "id": "floating_badge",
          "label": "Floating Pill Badge Text",
          "default": "+ Digestive Support"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Carousel",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
