{% comment %}
  AYOVA CUSTOMER TESTIMONIALS CAROUSEL SECTION
  Figma Spec: Centered title "Real stories. Real wellness journeys.", testimonial cards with stars, quote, author info
{% endcomment %}

{% assign header_alignment = section.settings.header_alignment | default: 'center' %}
{% assign items_desktop = section.settings.items_per_view | default: 3 %}

<section class="section-padding testimonials-section" id="testimonials">
  <div class="container">
    {% if header_alignment == 'center' %}
      <div class="wellness-header-centered">
        {% if section.settings.badge_text != blank %}
          <span class="badge badge-category">{{ section.settings.badge_text }}</span>
        {% endif %}
        <h2 class="section-title">{{ section.settings.title | default: "Real stories. Real wellness journeys." }}</h2>
        <p class="section-subtitle">{{ section.settings.subtitle | default: "Thousands of verified buyers trust Ayova for their daily health transformation" }}</p>
      </div>
    {% else %}
      <div class="wellness-header-row">
        <div>
          {% if section.settings.badge_text != blank %}
            <span class="badge badge-category">{{ section.settings.badge_text }}</span>
          {% endif %}
          <h2 class="section-title">{{ section.settings.title | default: "Real stories. Real wellness journeys." }}</h2>
          <p class="section-subtitle">{{ section.settings.subtitle | default: "Thousands of verified buyers trust Ayova for their daily health transformation" }}</p>
        </div>

        <div class="ayova-carousel-nav">
          <button type="button" class="ayova-carousel-btn" data-carousel-prev aria-label="Previous">←</button>
          <button type="button" class="ayova-carousel-btn" data-carousel-next aria-label="Next">→</button>
        </div>
      </div>
    {% endif %}

    <div class="ayova-carousel-wrapper" data-ayova-carousel data-items-per-view="{{ items_desktop }}" data-gap="24">
      <div class="ayova-carousel-track">

        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="ayova-carousel-slide" {{ block.shopify_attributes }}>
              <div class="testimonial-card">
                <div class="verified-pill">
                  <span class="verified-icon">✓</span> VERIFIED
                </div>
                <div class="testimonial-rating">★★★★★</div>
                <h3 class="testimonial-title">{{ block.settings.review_title | default: "Liver wellness that fits my routine" }}</h3>
                <p class="testimonial-quote">"{{ block.settings.quote | default: "The capsules are easy to take and the packaging feels very trustworthy. I have been consistent for six weeks and feel noticeably lighter after meals." }}"</p>
                <div class="testimonial-divider"></div>
                <div class="testimonial-author">
                  <h4 class="author-name">{{ block.settings.name | default: "PRIYA" | upcase }}</h4>
                  <span class="author-product">Verified Buyer - {{ block.settings.product | default: "Milk Thistle" }}</span>
                </div>
              </div>
            </div>
          {% endfor %}

        {% else %}
          <!-- Default Fallback Testimonials -->
          <div class="ayova-carousel-slide">
            <div class="testimonial-card">
              <div class="verified-pill">
                <span class="verified-icon">✓</span> VERIFIED
              </div>
              <div class="testimonial-rating">★★★★★</div>
              <h3 class="testimonial-title">Liver wellness that fits my routine</h3>
              <p class="testimonial-quote">"The capsules are easy to take and the packaging feels very trustworthy. I have been consistent for six weeks and feel noticeably lighter after meals."</p>
              <div class="testimonial-divider"></div>
              <div class="testimonial-author">
                <h4 class="author-name">PRIYA</h4>
                <span class="author-product">Verified Buyer - Milk Thistle</span>
              </div>
            </div>
          </div>

          <div class="ayova-carousel-slide">
            <div class="testimonial-card">
              <div class="verified-pill">
                <span class="verified-icon">✓</span> VERIFIED
              </div>
              <div class="testimonial-rating">★★★★★</div>
              <h3 class="testimonial-title">A simple daily wellness upgrade</h3>
              <p class="testimonial-quote">"I wanted something uncomplicated. The clear dosage guidance, clean ingredients, and quick delivery made Ayova an easy repeat purchase."</p>
              <div class="testimonial-divider"></div>
              <div class="testimonial-author">
                <h4 class="author-name">ROHAN</h4>
                <span class="author-product">Verified Buyer - Multivitamin Gummies</span>
              </div>
            </div>
          </div>

          <div class="ayova-carousel-slide">
            <div class="testimonial-card">
              <div class="verified-pill">
                <span class="verified-icon">✓</span> VERIFIED
              </div>
              <div class="testimonial-rating">★★★★★</div>
              <h3 class="testimonial-title">The support team was genuinely helpful</h3>
              <p class="testimonial-quote">"I had questions before ordering and received a thoughtful response. The probiotics has now become part of my morning routine."</p>
              <div class="testimonial-divider"></div>
              <div class="testimonial-author">
                <h4 class="author-name">NEHA</h4>
                <span class="author-product">Verified Buyer - Probiotics</span>
              </div>
            </div>
          </div>
        {% endif %}

      </div>

      <div class="ayova-carousel-dots" data-carousel-dots></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials Carousel",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "VERIFIED REVIEWS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Real stories. Real wellness journeys."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Thousands of verified buyers trust Ayova for their daily health transformation"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "row",
          "label": "Row with Controls"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "items_per_view",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Cards Visible on Desktop",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "review_title",
          "label": "Review Title"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "Customer Name"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product Purchased",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Carousel"
    }
  ]
}
{% endschema %}
