{% comment %}
  AYOVA DOCTOR CONSULTATION BANNER SECTION
  Figma Spec: "Our experts are here to guide you every step of the way."
{% endcomment %}

<section class="section-padding doctor-consultation-section" id="consult">
  <div class="container">
    <div class="doctor-banner">
        <div class="doctor-image-wrapper">
          <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=600&auto=format&fit=crop&q=80" alt="Ayova Wellness Expert" class="doctor-img">
          
          <div class="badge-free-guidance">FREE 1:1 GUIDANCE</div>
          
          <div class="doctor-status-bar">
            <div class="status-left">
              <div class="status-title"><span class="status-dot"></span> Ayova Wellness Expert</div>
              <div class="status-time">Available Mon-Sat • 10:00 AM-6:00 PM</div>
            </div>
            <a href="https://wa.me/919999999999" target="_blank" class="btn-chat-now">CHAT NOW →</a>
          </div>
        </div>

        <div class="doctor-content">
          <h2 class="doctor-title">{{ section.settings.title | default: "Our experts are here to guide you every step of the way." }}</h2>
          <div class="doctor-actions">
            <a href="{{ section.settings.consult_link | default: '#consult' }}" class="btn btn-primary btn-doctor">Talk to an Expert →</a>
          </div>
        </div>
      </div>
    </div>
</section>

{% schema %}
{
  "name": "Doctor Consultation",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our experts are here to guide you every step of the way."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "consult_link",
      "label": "Consultation Link"
    }
  ],
  "presets": [
    {
      "name": "Doctor Consultation"
    }
  ]
}
{% endschema %}
