{% comment %}
  AYOVA ABOUT US PAGE — Full Figma Redesign
  Sections: Hero, Origin Story (2-col), Mission Quote, Values, Marketplace Strip
{% endcomment %}

<!-- Hero Section -->
<div class="about-hero-section">
  <div class="container">
    <div class="about-hero-inner">
      <div class="about-hero-text">
        <span class="about-eyebrow">{{ section.settings.hero_eyebrow | escape }}</span>
        <h1 class="about-hero-title">{{ section.settings.hero_title | newline_to_br }}</h1>
        <p class="about-hero-desc">{{ section.settings.hero_desc | escape }}</p>
        {% if section.settings.hero_btn_label != blank %}
        <a href="{{ section.settings.hero_btn_link }}" class="btn about-hero-btn">{{ section.settings.hero_btn_label | escape }} →</a>
        {% endif %}
      </div>
      <div class="about-hero-image">
        {% if section.settings.hero_image != blank %}
          <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="{{ section.settings.hero_image.alt | default: 'Ayova Hero' }}" loading="lazy">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</div>

<!-- Origin Story Section -->
<div class="section-padding about-story-section">
  <div class="container">
    <div class="about-story-grid">

      <div class="about-story-text">
        <span class="about-eyebrow">{{ section.settings.story_eyebrow | escape }}</span>
        <h2 class="about-story-title">{{ section.settings.story_title | escape }}</h2>
        <div class="about-story-p">
          {{ section.settings.story_text }}
        </div>
        <div class="about-story-stats">
          {% for block in section.blocks %}
            {% if block.type == 'stat' %}
              <div class="story-stat" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.stat_value | escape }}</strong>
                <span>{{ block.settings.stat_label | escape }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="about-story-image-col">
        <div class="story-main-img">
          {% if section.settings.story_image != blank %}
            <img src="{{ section.settings.story_image | image_url: width: 600 }}" alt="{{ section.settings.story_image.alt | default: 'Our Story' }}" loading="lazy">
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <div class="story-mission-card">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#a8c4b8" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <p class="mission-quote">"{{ section.settings.mission_quote | escape }}"</p>
          <span class="mission-author">— {{ section.settings.mission_author | escape }}</span>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Values / Why Different Section -->
<div class="about-values-section">
  <div class="container">
    <div class="values-header">
      <span class="about-eyebrow">{{ section.settings.values_eyebrow | escape }}</span>
      <h2 class="values-title">{{ section.settings.values_title | escape }}</h2>
    </div>
    <div class="values-grid">
      {% for block in section.blocks %}
        {% if block.type == 'value' %}
          <div class="value-card" {{ block.shopify_attributes }}>
            <div class="value-icon">{{ block.settings.icon | escape }}</div>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>



<style>
/* About Hero */
.about-hero-section {
  background: linear-gradient(135deg, var(--color-forest-dark) 0%, #285044 100%);
  padding: 80px 0;
  color: #fff;
}
.about-hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.about-eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: #a8c4b8;
  display: block;
  margin-bottom: 16px;
  text-transform: uppercase;
}
.about-hero-title {
  font-family: var(--font-heading);
  font-size: 3rem;
  font-weight: 700;
  color: #fff;
  line-height: 1.18;
  margin-bottom: 20px;
}
.about-hero-desc {
  font-size: 1.1rem;
  color: #a8c4b8;
  line-height: 1.65;
  margin-bottom: 32px;
}
.about-hero-btn {
  background: var(--color-terracotta);
  color: #fff;
  padding: 14px 28px;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  display: inline-block;
}
.about-hero-image {
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  aspect-ratio: 4/3;
  background: #3a5c4e;
}
.about-hero-image img, .about-hero-image svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
/* Story Section */
.about-story-section { background: var(--color-cream-bg, #FAFAF8); }
.about-story-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}
.about-story-title {
  font-family: var(--font-heading);
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--color-forest-dark);
  margin: 12px 0 20px;
  line-height: 1.25;
}
.about-story-p p {
  font-size: 1rem;
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-bottom: 20px;
}
.about-story-stats {
  display: flex;
  gap: 24px;
  margin-top: 32px;
  padding-top: 28px;
  border-top: 1px solid var(--color-sage-border);
}
.story-stat strong {
  display: block;
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--color-forest-dark);
}
.story-stat span { font-size: 0.85rem; color: var(--color-text-muted); }
.about-story-image-col { display: flex; flex-direction: column; gap: 20px; }
.story-main-img {
  border-radius: 16px;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: #eaeaea;
}
.story-main-img img, .story-main-img svg { width: 100%; height: 100%; object-fit: cover; }
.story-mission-card {
  background: var(--color-forest-dark);
  border-radius: 16px;
  padding: 28px;
  color: #fff;
}
.mission-quote {
  font-size: 1.1rem;
  color: #e0ede8;
  line-height: 1.6;
  font-style: italic;
  margin: 16px 0 12px;
}
.mission-author { font-size: 0.85rem; color: #a8c4b8; font-weight: 600; }
/* Values */
.about-values-section {
  padding: 80px 0;
  background: #fff;
}
.values-header {
  text-align: center;
  margin-bottom: 48px;
}
.values-title {
  font-family: var(--font-heading);
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--color-forest-dark);
  margin-top: 10px;
}
.values-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.value-card {
  background: var(--color-sage-light);
  border: 1px solid var(--color-sage-border);
  border-radius: 16px;
  padding: 28px 24px;
  transition: transform 0.2s;
}
.value-card:hover { transform: translateY(-4px); }
.value-icon { font-size: 2rem; margin-bottom: 14px; display: block; }
.value-card h3 {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-forest-dark);
  margin-bottom: 10px;
}
.value-card p { font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.55; }
/* Responsive */
@media (max-width: 900px) {
  .about-hero-inner,
  .about-story-grid { grid-template-columns: 1fr; gap: 40px; }
  .about-hero-title { font-size: 2.2rem; }
  .values-grid { grid-template-columns: repeat(2, 1fr); }
  .about-story-stats { flex-wrap: wrap; gap: 16px; }
}
@media (max-width: 600px) {
  .about-hero-section { padding: 48px 0; }
  .about-hero-title { font-size: 1.8rem; }
  .values-grid { grid-template-columns: 1fr; }
  .about-values-section { padding: 48px 0; }
}
</style>

{% schema %}
{
  "name": "About Us Page",
  "settings": [
    {
      "type": "header",
      "content": "Hero Settings"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero Eyebrow",
      "default": "OUR STORY"
    },
    {
      "type": "textarea",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Wellness made cleaner,\ncleaner and more trustworthy."
    },
    {
      "type": "textarea",
      "id": "hero_desc",
      "label": "Hero Description",
      "default": "Ayova was founded with one simple belief — that wellness products should work, be honest about what's inside, and be accessible to everyone in India."
    },
    {
      "type": "text",
      "id": "hero_btn_label",
      "label": "Hero Button Label",
      "default": "Explore Our Products"
    },
    {
      "type": "url",
      "id": "hero_btn_link",
      "label": "Hero Button Link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "header",
      "content": "Story Settings"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Story Eyebrow",
      "default": "BORN FROM A SIMPLE PROBLEM"
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Story Title",
      "default": "Born from a simple wellness problem."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Text",
      "default": "<p>Our founder spent years struggling to find supplements he could actually trust. The market was flooded with products that were under-dosed, filled with synthetic binders, and impossible to verify.</p><p>Ayova was built to be different. We work directly with certified Ayurvedic formulators, use only standardized botanical extracts, and publish every ingredient with its exact potency — no hidden proprietary blends, no marketing fictions.</p>"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story Image"
    },
    {
      "type": "textarea",
      "id": "mission_quote",
      "label": "Mission Quote",
      "default": "We decided to build a wellness brand people could understand, question and trust."
    },
    {
      "type": "text",
      "id": "mission_author",
      "label": "Mission Author",
      "default": "Ayova Founders"
    },
    {
      "type": "header",
      "content": "Values Settings"
    },
    {
      "type": "text",
      "id": "values_eyebrow",
      "label": "Values Eyebrow",
      "default": "WHY WE'RE DIFFERENT"
    },
    {
      "type": "text",
      "id": "values_title",
      "label": "Values Title",
      "default": "The Ayova Standard"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "stat_value",
          "label": "Value",
          "default": "100%"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Label",
          "default": "Plant-Based"
        }
      ]
    },
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "🌿"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Standardized Extracts"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Every ingredient is standardized to a verified potency — not raw powders that vary batch to batch."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Page",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "stat_value": "50,000+",
            "stat_label": "Happy Customers"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat_value": "100%",
            "stat_label": "Plant-Based"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat_value": "AYUSH",
            "stat_label": "Certified"
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "🌿",
            "title": "Standardized Extracts",
            "text": "Every ingredient is standardized to a verified potency — not raw powders that vary batch to batch."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "🔬",
            "title": "Lab Tested",
            "text": "Third-party tested for heavy metals, microbial purity, and active phytochemical content."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "📋",
