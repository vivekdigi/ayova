{% comment %}
  AYOVA ABOUT US PAGE — Full Figma Redesign
  Sections: Hero, Origin Story (2-col), Mission Quote, Values, Marketplace Strip
{% endcomment %}

<!-- Hero Section -->
<div class="about-hero-section">
  <div class="container">
    <div class="about-hero-inner">
      <div class="about-hero-text">
        <span class="about-eyebrow">OUR STORY</span>
        <h1 class="about-hero-title">Wellness made cleaner,<br>cleaner and more trustworthy.</h1>
        <p class="about-hero-desc">
          Ayova was founded with one simple belief — that wellness products should work, be honest about what's inside, and be accessible to everyone in India.
        </p>
        <a href="/collections/all" class="btn about-hero-btn">Explore Our Products →</a>
      </div>
      <div class="about-hero-image">
        <img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=800&auto=format&fit=crop&q=80" alt="Fresh herbs and natural wellness" loading="lazy">
      </div>
    </div>
  </div>
</div>

<!-- Origin Story Section -->
<div class="section-padding about-story-section">
  <div class="container">
    <div class="about-story-grid">

      <div class="about-story-text">
        <span class="about-eyebrow">BORN FROM A SIMPLE PROBLEM</span>
        <h2 class="about-story-title">Born from a simple wellness problem.</h2>
        <p class="about-story-p">
          Our founder spent years struggling to find supplements he could actually trust. The market was flooded with products that were under-dosed, filled with synthetic binders, and impossible to verify.
        </p>
        <p class="about-story-p">
          Ayova was built to be different. We work directly with certified Ayurvedic formulators, use only standardized botanical extracts, and publish every ingredient with its exact potency — no hidden proprietary blends, no marketing fictions.
        </p>
        <div class="about-story-stats">
          <div class="story-stat">
            <strong>50,000+</strong>
            <span>Happy Customers</span>
          </div>
          <div class="story-stat">
            <strong>100%</strong>
            <span>Plant-Based</span>
          </div>
          <div class="story-stat">
            <strong>AYUSH</strong>
            <span>Certified</span>
          </div>
        </div>
      </div>

      <div class="about-story-image-col">
        <div class="story-main-img">
          <img src="https://images.unsplash.com/photo-1466637574441-749b8f19452f?w=600&auto=format&fit=crop&q=80" alt="Natural herbs being prepared" loading="lazy">
        </div>
        <div class="story-mission-card">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#a8c4b8" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <p class="mission-quote">"We decided to build a wellness brand people could understand, question and trust."</p>
          <span class="mission-author">— Ayova Founders</span>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Values / Why Different Section -->
<div class="about-values-section">
  <div class="container">
    <div class="values-header">
      <span class="about-eyebrow">WHY WE'RE DIFFERENT</span>
      <h2 class="values-title">The Ayova Standard</h2>
    </div>
    <div class="values-grid">
      <div class="value-card">
        <div class="value-icon">🌿</div>
        <h3>Standardized Extracts</h3>
        <p>Every ingredient is standardized to a verified potency — not raw powders that vary batch to batch.</p>
      </div>
      <div class="value-card">
        <div class="value-icon">🔬</div>
        <h3>Lab Tested</h3>
        <p>Third-party tested for heavy metals, microbial purity, and active phytochemical content.</p>
      </div>
      <div class="value-card">
        <div class="value-icon">📋</div>
        <h3>Full Transparency</h3>
        <p>Every supplement lists its exact ingredient, extract ratio, and dosage. No proprietary blends.</p>
      </div>
      <div class="value-card">
        <div class="value-icon">✅</div>
        <h3>AYUSH & FSSAI Certified</h3>
        <p>Manufactured in GMP-certified facilities under AYUSH and FSSAI regulations for Indian consumers.</p>
      </div>
    </div>
  </div>
</div>

<!-- Marketplace / Shop Everywhere Strip -->
<div class="about-marketplace-section">
  <div class="container">
    <h3 class="marketplace-title">SHOP AYOVA EVERYWHERE</h3>
    <p class="marketplace-sub">Your wellness essentials, wherever you shop.</p>
    <div class="marketplace-logos">
      <a href="#" class="marketplace-logo marketplace-logo-blinkit" target="_blank" rel="noopener">
        <span>blinkit</span>
      </a>
      <a href="#" class="marketplace-logo marketplace-logo-amazon" target="_blank" rel="noopener">
        <span style="font-family: var(--font-accent); font-weight: 700; color: #232F3E;">amazon</span>
      </a>
      <a href="#" class="marketplace-logo marketplace-logo-flipkart" target="_blank" rel="noopener">
        <span style="font-weight: 700; color: #fff;">Flipkart</span>
      </a>
    </div>
  </div>
</div>

<style>
/* About Hero */
.about-hero-section {
  background: linear-gradient(135deg, var(--color-forest-dark) 0%, #285044 100%);
  padding: 80px 0;
  color: #fff;
}
.about-hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.about-eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: #a8c4b8;
  display: block;
  margin-bottom: 16px;
  text-transform: uppercase;
}
.about-hero-title {
  font-family: var(--font-heading);
  font-size: 3rem;
  font-weight: 700;
  color: #fff;
  line-height: 1.18;
  margin-bottom: 20px;
}
.about-hero-desc {
  font-size: 1.1rem;
  color: #a8c4b8;
  line-height: 1.65;
  margin-bottom: 32px;
}
.about-hero-btn {
  background: var(--color-terracotta);
  color: #fff;
  padding: 14px 28px;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  display: inline-block;
}
.about-hero-image {
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  aspect-ratio: 4/3;
}
.about-hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
/* Story Section */
.about-story-section { background: var(--color-cream-bg, #FAFAF8); }
.about-story-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}
.about-story-title {
  font-family: var(--font-heading);
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--color-forest-dark);
  margin: 12px 0 20px;
  line-height: 1.25;
}
.about-story-p {
  font-size: 1rem;
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-bottom: 20px;
}
.about-story-stats {
  display: flex;
  gap: 24px;
  margin-top: 32px;
  padding-top: 28px;
  border-top: 1px solid var(--color-sage-border);
}
.story-stat strong {
  display: block;
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--color-forest-dark);
}
.story-stat span { font-size: 0.85rem; color: var(--color-text-muted); }
.about-story-image-col { display: flex; flex-direction: column; gap: 20px; }
.story-main-img {
  border-radius: 16px;
  overflow: hidden;
  aspect-ratio: 4/3;
}
.story-main-img img { width: 100%; height: 100%; object-fit: cover; }
.story-mission-card {
  background: var(--color-forest-dark);
  border-radius: 16px;
  padding: 28px;
  color: #fff;
}
.mission-quote {
  font-size: 1.1rem;
  color: #e0ede8;
  line-height: 1.6;
  font-style: italic;
  margin: 16px 0 12px;
}
.mission-author { font-size: 0.85rem; color: #a8c4b8; font-weight: 600; }
/* Values */
.about-values-section {
  padding: 80px 0;
  background: #fff;
}
.values-header {
  text-align: center;
  margin-bottom: 48px;
}
.values-title {
  font-family: var(--font-heading);
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--color-forest-dark);
  margin-top: 10px;
}
.values-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.value-card {
  background: var(--color-sage-light);
  border: 1px solid var(--color-sage-border);
  border-radius: 16px;
  padding: 28px 24px;
  transition: transform 0.2s;
}
.value-card:hover { transform: translateY(-4px); }
.value-icon { font-size: 2rem; margin-bottom: 14px; display: block; }
.value-card h3 {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-forest-dark);
  margin-bottom: 10px;
}
.value-card p { font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.55; }
/* Marketplace */
.about-marketplace-section {
  background: var(--color-forest-dark);
  padding: 64px 0;
  text-align: center;
}
.marketplace-title {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}
.marketplace-sub { color: #a8c4b8; font-size: 1rem; margin-bottom: 36px; }
.marketplace-logos { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
.marketplace-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 32px;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: 700;
  text-decoration: none;
  transition: opacity 0.2s;
  min-width: 140px;
}
.marketplace-logo:hover { opacity: 0.85; }
.marketplace-logo-blinkit { background: #F8D000; color: #1A1A1A; }
.marketplace-logo-amazon { background: #fff; color: #232F3E; }
.marketplace-logo-flipkart { background: #2874F0; color: #fff; }
/* Responsive */
@media (max-width: 900px) {
  .about-hero-inner,
  .about-story-grid { grid-template-columns: 1fr; gap: 40px; }
  .about-hero-title { font-size: 2.2rem; }
  .values-grid { grid-template-columns: repeat(2, 1fr); }
  .about-story-stats { flex-wrap: wrap; gap: 16px; }
}
@media (max-width: 600px) {
  .about-hero-section { padding: 48px 0; }
  .about-hero-title { font-size: 1.8rem; }
  .values-grid { grid-template-columns: 1fr; }
  .about-values-section { padding: 48px 0; }
}
</style>

{% schema %}
{
  "name": "About Us Page",
  "settings": [],
  "presets": [
    {
      "name": "About Us Page"
    }
  ]
}
{% endschema %}
