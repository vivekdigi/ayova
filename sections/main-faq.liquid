{% comment %}
  AYOVA FAQ SECTION — Accordion two-column layout
{% endcomment %}

<!-- FAQ Hero -->
<div class="faq-hero">
  <div class="container">
    <span class="faq-eyebrow">{{ section.settings.hero_eyebrow | escape }}</span>
    <h1 class="faq-hero-title">{{ section.settings.hero_title | newline_to_br }}</h1>
    <p class="faq-hero-sub">{{ section.settings.hero_subtitle | escape }}</p>
  </div>
</div>

<!-- FAQ Accordion Section -->
<div class="section-padding faq-section">
  <div class="container">
    <div class="faq-columns">
      {% assign half_count = section.blocks.size | divided_by: 2.0 | ceil %}
      
      <!-- Left Column -->
      <div class="faq-col">
        {% for block in section.blocks limit: half_count %}
          <div class="faq-item" {{ block.shopify_attributes }}>
            <button class="faq-question" aria-expanded="false">
              {{ block.settings.question | escape }}
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              <p>{{ block.settings.answer }}</p>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Right Column -->
      <div class="faq-col">
        {% for block in section.blocks offset: half_count %}
          <div class="faq-item" {{ block.shopify_attributes }}>
            <button class="faq-question" aria-expanded="false">
              {{ block.settings.question | escape }}
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              <p>{{ block.settings.answer }}</p>
            </div>
          </div>
        {% endfor %}
      </div>

    </div>

    <!-- Still Have Questions CTA -->
    <div class="faq-cta">
      <div class="faq-cta-inner">
        <h3>{{ section.settings.cta_title | escape }}</h3>
        <p>{{ section.settings.cta_text | escape }}</p>
        <a href="{{ section.settings.cta_link }}" class="btn btn-primary">{{ section.settings.cta_button_label | escape }} →</a>
      </div>
    </div>

  </div>
</div>



<script>
document.querySelectorAll('.faq-question').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = this.closest('.faq-item');
    var isOpen = item.classList.contains('open');
    // Close all
    document.querySelectorAll('.faq-item').forEach(function(i) {
      i.classList.remove('open');
      i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
      i.querySelector('.faq-icon').textContent = '+';
    });
    // Toggle clicked
    if (!isOpen) {
      item.classList.add('open');
      this.setAttribute('aria-expanded', 'true');
      this.querySelector('.faq-icon').textContent = '×';
    }
  });
});
</script>

<style>
.faq-hero {
  background: var(--color-sage-light, #EEF2EF);
  padding: 72px 0 56px;
  border-bottom: 1px solid var(--color-sage-border);
}
.faq-eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--color-terracotta);
  display: block;
  margin-bottom: 14px;
  text-transform: uppercase;
}
.faq-hero-title {
  font-family: var(--font-heading);
  font-size: 2.6rem;
  font-weight: 700;
  color: var(--color-forest-dark);
  line-height: 1.2;
  margin-bottom: 16px;
}
.faq-hero-sub {
  font-size: 1.05rem;
  color: var(--color-text-muted);
  max-width: 620px;
}
.faq-section { background: #fff; }
.faq-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}
.faq-col { display: flex; flex-direction: column; gap: 0; }
.faq-item {
  border-bottom: 1px solid var(--color-sage-border);
}
.faq-question {
  width: 100%;
  background: none;
  border: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 20px 0;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-forest-dark);
  cursor: pointer;
  text-align: left;
  transition: color 0.2s;
}
.faq-question:hover { color: var(--color-forest-primary); }
.faq-item.open .faq-question { color: var(--color-terracotta); }
.faq-icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1.5px solid var(--color-sage-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  color: var(--color-forest-primary);
  transition: all 0.2s;
}
.faq-item.open .faq-icon {
  background: var(--color-terracotta);
  border-color: var(--color-terracotta);
  color: #fff;
}
.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.2s;
}
.faq-item.open .faq-answer {
  max-height: 300px;
  padding-bottom: 20px;
}
.faq-answer p {
  font-size: 0.92rem;
  color: var(--color-text-muted);
  line-height: 1.65;
}
.faq-answer a { color: var(--color-terracotta); }
.faq-cta {
  margin-top: 60px;
  text-align: center;
  background: var(--color-sage-light);
  border: 1px solid var(--color-sage-border);
  border-radius: 16px;
  padding: 48px;
}
.faq-cta h3 {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  color: var(--color-forest-dark);
  margin-bottom: 10px;
}
.faq-cta p { color: var(--color-text-muted); margin-bottom: 24px; font-size: 1rem; }
/* Marketplace */
.faq-marketplace {
  background: var(--color-forest-dark);
  padding: 60px 0;
  text-align: center;
}
.marketplace-title-faq {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}
.marketplace-sub-faq { color: #a8c4b8; font-size: 1rem; margin-bottom: 32px; }
.marketplace-logos-faq { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; }
.mkt-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 28px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 1rem;
  text-decoration: none;
  min-width: 130px;
  transition: opacity 0.2s;
}
.mkt-logo:hover { opacity: 0.85; }
.mkt-blinkit { background: #F8D000; color: #1A1A1A; }
.mkt-amazon { background: #fff; color: #232F3E; font-family: var(--font-accent); }
.mkt-flipkart { background: #2874F0; color: #fff; }
@media (max-width: 900px) {
  .faq-hero-title { font-size: 1.9rem; }
  .faq-columns { grid-template-columns: 1fr; gap: 0; }
  .faq-hero { padding: 48px 0 36px; }
}
@media (max-width: 600px) {
  .faq-cta { padding: 32px 20px; }
}
</style>

{% schema %}
{
  "name": "FAQ Page",
  "settings": [
    {
      "type": "header",
      "content": "Hero Settings"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero Eyebrow",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "textarea",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Everything you may want to know\nbefore you order."
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "We've answered the most common questions about our products, ingredients, and delivery."
    },
    {
      "type": "header",
      "content": "CTA Settings"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA Title",
      "default": "Still have a question?"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Our wellness experts are happy to help you find the right product for your needs."
    },
    {
      "type": "text",
      "id": "cta_button_label",
      "label": "CTA Button Label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your question?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Provide the answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Page",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}
