[
  {
    "name": "theme_info",
    "theme_name": "Ayova",
    "theme_version": "2.0.0",
    "theme_author": "Ayova Organics",
    "theme_documentation_url": "https://ayovaorganics.com",
    "theme_support_url": "https://ayovaorganics.com"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 200,
        "step": 5,
        "unit": "px",
        "label": "Logo Width",
        "default": 100
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social Media Links"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_twitter",
        "label": "Twitter / X URL"
      },
      {
        "type": "url",
        "id": "social_whatsapp",
        "label": "WhatsApp URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Type",
        "options": [
          { "value": "page", "label": "Cart Page" },
          { "value": "drawer", "label": "Cart Drawer" }
        ],
        "default": "page"
      }
    ]
  },
  {
    "name": "Marketplace Logos & Buttons",
    "settings": [
      {
        "type": "header",
        "content": "Amazon & Flipkart Buy Now Buttons"
      },
      {
        "type": "text",
        "id": "marketplace_buy_label",
        "label": "Buy Now Label Text",
        "default": "Buy now",
        "info": "Text displayed beside Amazon & Flipkart logo buttons (e.g. 'Buy now' or 'Buy on')"
      },
      {
        "type": "image_picker",
        "id": "amazon_logo",
        "label": "Amazon Logo",
        "info": "Upload custom Amazon logo image. If left blank, default Amazon SVG logo is used."
      },
      {
        "type": "image_picker",
        "id": "flipkart_logo",
        "label": "Flipkart Logo",
        "info": "Upload custom Flipkart logo image. If left blank, default Flipkart SVG logo is used."
      }
    ]
  }
]