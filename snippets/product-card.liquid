{% comment %}
  PRODUCT CARD SNIPPET — Figma: 310x690px card
  Accepts either a Shopify product object OR manual parameters for fallback
  
  Usage:
    {% render 'product-card', product: product_object %}
    {% render 'product-card', title: 'Name', price: '389.00', image_url: '...' %}
{% endcomment %}

{% if product != blank and product != empty %}
  {%- assign card_title = product.title -%}
  {%- assign card_url = product.url -%}
  {%- assign card_price = product.price | money -%}
  {%- assign card_compare = product.compare_at_price | money -%}
  {%- assign card_has_compare = false -%}
  {%- if product.compare_at_price > product.price -%}
    {%- assign card_has_compare = true -%}
  {%- endif -%}
  {%- assign card_available = product.available -%}
  {%- assign card_image = custom_image | default: product.featured_image -%}
  {%- assign card_type = product.type -%}
  {%- assign card_vendor = product.vendor -%}
  {%- assign card_first_variant = product.first_available_variant | default: product.selected_or_first_available_variant -%}
  {%- assign card_amazon_link = product.metafields.custom.amazon_link.value | default: product.metafields.custom.amazon_link -%}
  {%- if card_amazon_link == blank -%}
    {%- assign card_amazon_link = product.metafields.custom.amazon_url.value | default: product.metafields.custom.amazon_url -%}
  {%- endif -%}
  {%- if card_amazon_link == blank -%}
    {%- assign card_amazon_link = product.metafields.custom.amazon_product_link.value | default: product.metafields.custom.amazon_product_link -%}
  {%- endif -%}
  {%- if card_amazon_link == blank -%}
    {%- assign card_amazon_link = product.metafields.custom.amazon.value | default: product.metafields.custom.amazon -%}
  {%- endif -%}
  {%- if card_amazon_link == blank and product.tags != blank -%}
    {%- for tag in product.tags -%}
      {%- assign tag_lower = tag | downcase -%}
      {%- if tag_lower contains 'amazon:' -%}
        {%- assign card_amazon_link = tag | remove_first: 'amazon:' | strip -%}
        {%- break -%}
      {%- elsif tag_lower contains 'amazon_link:' -%}
        {%- assign card_amazon_link = tag | remove_first: 'amazon_link:' | strip -%}
        {%- break -%}
      {%- elsif tag_lower contains 'amazon_url:' -%}
        {%- assign card_amazon_link = tag | remove_first: 'amazon_url:' | strip -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if card_amazon_link != blank -%}
    {%- unless card_amazon_link contains 'http://' or card_amazon_link contains 'https://' -%}
      {%- assign card_amazon_link = 'https://' | append: card_amazon_link -%}
    {%- endunless -%}
  {%- endif -%}
{% else %}
  {%- assign card_title = title | default: 'Product Name' -%}
  {%- assign card_url = url | default: '#' -%}
  {%- assign card_price = price | default: 'Rs. 389.00' -%}
  {%- assign card_compare = compare_price -%}
  {%- assign card_has_compare = false -%}
  {%- if compare_price != blank -%}
    {%- assign card_has_compare = true -%}
  {%- endif -%}
  {%- assign card_available = true -%}
  {%- assign card_image = custom_image -%}
  {%- assign card_type = category | default: 'Category' -%}
  {%- assign card_vendor = '' -%}
  {%- assign card_amazon_link = amazon_link | default: amazon_url -%}
  {%- if card_amazon_link != blank -%}
    {%- unless card_amazon_link contains 'http://' or card_amazon_link contains 'https://' -%}
      {%- assign card_amazon_link = 'https://' | append: card_amazon_link -%}
    {%- endunless -%}
  {%- endif -%}
{% endif %}

<div class="ayova-product-card">
  <!-- Image Area — Figma: 278x360px, bg #EEF3EF, border-radius 22px -->
  <div class="card-image-wrapper">
    {% if badge != blank %}
      <span class="card-badge">{{ badge }}</span>
    {% elsif product != blank and product.compare_at_price > product.price %}
      {%- assign save_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
      <span class="card-badge">SAVE {{ save_pct }}%</span>
    {% endif %}

    <a href="{{ card_url }}" aria-label="View {{ card_title | escape }}">
      {% if card_image != blank %}
        <img
          src="{{ card_image | image_url: width: 560 }}"
          srcset="{{ card_image | image_url: width: 280 }} 1x, {{ card_image | image_url: width: 560 }} 2x"
          alt="{{ card_image.alt | default: card_title | escape }}"
          class="card-img"
          loading="lazy"
          width="278"
          height="360"
        >
      {% elsif image_url != blank %}
        <img src="{{ image_url }}" alt="{{ card_title | escape }}" class="card-img" loading="lazy" width="278" height="360">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'card-img' }}
      {% endif %}
    </a>

    <span class="card-quick-view">Quick View</span>
  </div>

  <!-- Info Section -->
  <div class="card-info">
    {% if card_type != blank %}
      <span class="card-category-tag">{{ card_type }}</span>
    {% endif %}

    <!-- Rating (Moved above title) -->
    <div class="card-rating">
      <span class="rating-stars">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#FFC107" stroke="#FFC107" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#FFC107" stroke="#FFC107" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#FFC107" stroke="#FFC107" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#FFC107" stroke="#FFC107" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFC107" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      </span>
      {% if reviews != blank %}
        <span class="rating-count">{{ reviews }}</span>
      {% elsif product != blank and product.metafields.reviews.rating.value != blank %}
        <span class="rating-count">{{ product.metafields.reviews.rating.value | round: 1 }}</span>
      {% else %}
        <span class="rating-count">4.4</span>
      {% endif %}
    </div>

    <h3 class="card-title">
      <a href="{{ card_url }}">{{ card_title }}</a>
    </h3>

    <!-- Short Description -->
    {% assign short_desc = short_description | default: product.metafields.custom.short_description %}
    {% if short_desc != blank %}
      <div class="card-short-desc">
        {{ short_desc }}
      </div>
    {% endif %}

    <!-- Price Row -->
    <div class="card-price-row">
      <span class="price-amount">{{ card_price }}</span>
      {% if card_has_compare %}
        <span class="price-compare">{{ card_compare }}</span>
        {%- if product != blank -%}
          {%- assign save_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        {%- else -%}
          {%- assign save_pct = "30" -%}
        {%- endif -%}
        <span class="price-save-badge">SAVE {{ save_pct }}%</span>
      {% endif %}
    </div>

    <!-- Per Count (Toggled via settings) -->
    {% if show_per_count %}
      {% assign count_text = per_count_text | default: product.metafields.custom.per_count_price %}
      {% if count_text != blank %}
        <div class="card-per-count">
          ({{ count_text }})
        </div>
      {% endif %}
    {% endif %}

    <!-- Pack Size Pill -->
    {% assign pack_size = pack | default: product.metafields.custom.pack_size %}
    {% if pack_size != blank %}
      <div class="card-pack-pill">
        {{ pack_size }}
      </div>
    {% endif %}

    <!-- Add to Cart Button — Figma: #285044, border-radius 11px -->
    {%- assign redirect_enabled = product.metafields.custom.enable_redirect.value -%}
    {%- assign card_flipkart_link = product.metafields.custom.flipkart_link.value | default: product.metafields.custom.flipkart_link -%}
    {% if card_amazon_link != blank %}
      <a href="{{ card_amazon_link }}" target="_blank" rel="noopener noreferrer" class="btn-add-cart" style="text-decoration:none; display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; width:100%; height:46px; padding:0 16px; line-height:1;"><span style="display:inline-flex; align-items:center; justify-content:center; line-height:1; transform:translateY(1px); letter-spacing:0.02em;">BUY ON AMAZON</span></a>
    {% elsif card_flipkart_link != blank and redirect_enabled == true or redirect_enabled == "true" or redirect_enabled == "True" and card_flipkart_link != blank %}
      <a href="{{ card_flipkart_link }}" target="_blank" rel="noopener noreferrer" class="btn-add-cart" style="text-decoration:none; display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; width:100%; height:46px; padding:0 16px; line-height:1;"><span style="display:inline-flex; align-items:center; justify-content:center; line-height:1; transform:translateY(1px);">Add to Cart</span></a>
    {% elsif product != blank %}
      <form method="post" action="/cart/add" style="width:100%; margin-top:auto; display:flex; justify-content:center;" onsubmit="event.preventDefault(); var btn = this.querySelector('button'); if(btn.dataset.added === 'true') { window.location.href='/cart'; return; } btn.innerHTML = '<span>Adding...</span>'; btn.disabled = true; fetch('/cart/add.js', { method: 'POST', body: new FormData(this) }).then(res=>res.json()).then(data=>{ btn.innerHTML = '<span>View Cart</span>'; btn.disabled = false; btn.dataset.added = 'true'; }).catch(err => { btn.innerHTML = '<span>Add to Cart</span>'; btn.disabled = false; });">
        <input type="hidden" name="id" value="{{ card_first_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn-add-cart" style="display:flex; align-items:center; justify-content:center; text-align:center; width:100%; height:46px; padding:0 16px; line-height:1;" {% unless card_available %}disabled{% endunless %}><span style="display:inline-flex; align-items:center; justify-content:center; line-height:1; transform:translateY(1px);">{% if card_available %}Add to Cart{% else %}Sold Out{% endif %}</span></button>
      </form>
    {% else %}
      <button type="button" class="btn-add-cart" style="display:flex; align-items:center; justify-content:center; text-align:center; width:100%; height:46px; padding:0 16px; line-height:1;"><span style="display:inline-flex; align-items:center; justify-content:center; line-height:1; transform:translateY(1px);">Add to Cart</span></button>
    {% endif %}
  </div>
</div>