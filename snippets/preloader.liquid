<!-- Ayova Site Preloader -->
<div id="site-preloader" class="site-preloader" aria-hidden="false">
  <div class="site-preloader-content">
    <div class="preloader-spinner-wrap">
      <div class="preloader-spinner"></div>
      <div class="preloader-center-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#173E34" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
          <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
        </svg>
      </div>
    </div>
    
    <div class="preloader-brand">
      <span class="preloader-name">AYOVA</span>
      <span class="preloader-tagline">WELLNESS IN BALANCE</span>
    </div>

    <div class="preloader-bar-wrap">
      <div class="preloader-bar"></div>
    </div>
  </div>
</div>

<style>
html.preloader-active, 
body.preloader-active {
  overflow: hidden !important;
}

.site-preloader {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: #FFFFFF;
  z-index: 99999999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
  visibility: visible;
  transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.5s ease;
  pointer-events: all;
}

.site-preloader.preloader-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.site-preloader-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  user-select: none;
}

.preloader-spinner-wrap {
  position: relative;
  width: 68px;
  height: 68px;
  margin-bottom: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preloader-spinner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2.5px solid rgba(23, 62, 52, 0.12);
  border-top-color: #173E34;
  border-right-color: #D96C3F;
  animation: preloader-spin 0.9s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite;
}

.preloader-center-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  animation: preloader-pulse 1.8s ease-in-out infinite;
}

.preloader-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 18px;
}

.preloader-name {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.45rem;
  font-weight: 700;
  letter-spacing: 0.28em;
  color: #173E34;
  margin-left: 0.28em;
  line-height: 1;
}

.preloader-tagline {
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  color: #7A857F;
  margin-top: 8px;
  margin-left: 0.22em;
}

.preloader-bar-wrap {
  width: 110px;
  height: 3px;
  background: rgba(23, 62, 52, 0.08);
  border-radius: 99px;
  overflow: hidden;
  position: relative;
}

.preloader-bar {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 40%;
  background: linear-gradient(90deg, #173E34, #D96C3F);
  border-radius: 99px;
  animation: preloader-slide 1.4s ease-in-out infinite;
}

@keyframes preloader-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes preloader-pulse {
  0%, 100% { transform: scale(1); opacity: 0.85; }
  50% { transform: scale(1.12); opacity: 1; }
}

@keyframes preloader-slide {
  0% { left: -40%; width: 30%; }
  50% { width: 60%; }
  100% { left: 100%; width: 30%; }
}
</style>

<script>
(function() {
  document.documentElement.classList.add('preloader-active');
  if (document.body) {
    document.body.classList.add('preloader-active');
  }

  function removePreloader() {
    var loader = document.getElementById('site-preloader');
    if (!loader || loader.classList.contains('preloader-hidden')) return;

    loader.classList.add('preloader-hidden');
    document.documentElement.classList.remove('preloader-active');
    if (document.body) {
      document.body.classList.remove('preloader-active');
    }

    setTimeout(function() {
      if (loader && loader.parentNode) {
        loader.parentNode.removeChild(loader);
      }
    }, 600);
  }

  // Trigger when everything on the page is fully loaded (DOM, images, stylesheets, scripts)
  if (document.readyState === 'complete') {
    removePreloader();
  } else {
    window.addEventListener('load', removePreloader);
  }

  // Safety fallback after 4 seconds to prevent blocking users if third-party scripts hang
  setTimeout(removePreloader, 4000);
})();
</script>