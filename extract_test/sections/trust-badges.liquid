{% comment %}
  TRUST & CERTIFICATIONS BADGES SECTION + SHOP EVERYWHERE MARKETPLACES
  Figma Spec: "SHOP AYOVA EVERYWHERE" (Amazon, Flipkart, Nykaa) + AYUSH, ISO, GMP, Eco-Friendly certifications
{% endcomment %}

<section class="trust-badges-section">
  <!-- Marketplace Section matching Figma -->
  <div class="marketplaces-block text-center">
    <span class="marketplace-tag">SHOP AYOVA EVERYWHERE</span>
    <h3 class="marketplace-title">Your wellness essentials, wherever you shop.</h3>
    <div class="marketplace-logos">
      <span class="m-badge m-amazon">amazon</span>
      <span class="m-badge m-flipkart">Flipkart</span>
      <span class="m-badge m-nykaa">Nykaa</span>
    </div>
  </div>

  <div class="container" style="margin-top: 36px;">
    <div class="trust-badges-grid">
      
      <div class="trust-item">
        <div class="trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <div class="trust-text-box">
          <h4 class="trust-title">AYUSH Certified</h4>
          <p class="trust-desc">Government recognized authentic Ayurvedic formulas</p>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <div class="trust-text-box">
          <h4 class="trust-title">GMP Certified</h4>
          <p class="trust-desc">Good Manufacturing Practice standard facility</p>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <div class="trust-text-box">
          <h4 class="trust-title">ISO Certified</h4>
          <p class="trust-desc">Rigorous international lab safety testing</p>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"></path></svg>
        </div>
        <div class="trust-text-box">
          <h4 class="trust-title">100% Eco Friendly</h4>
          <p class="trust-desc">Sustainably sourced botanical ingredients</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.trust-badges-section {
  background-color: var(--color-forest-deep);
  color: var(--color-white);
  padding: 50px 0 40px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.marketplaces-block {
  margin-bottom: 32px;
}

.marketplace-tag {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-gold);
  letter-spacing: 0.1em;
}

.marketplace-title {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  margin: 6px 0 18px;
}

.marketplace-logos {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.m-badge {
  background: #FFFFFF;
  color: #1F2924;
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: 0.9rem;
  padding: 8px 22px;
  border-radius: 6px;
  letter-spacing: 0.02em;
}

.m-amazon {
  color: #232F3E;
  border-bottom: 2px solid #FF9900;
}

.m-flipkart {
  color: #2874F0;
  font-style: italic;
}

.m-nykaa {
  color: #FC2779;
}

.trust-badges-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 16px;
}

.trust-icon-box {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  flex-shrink: 0;
}

.trust-title {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.05rem;
  margin-bottom: 2px;
}

.trust-desc {
  font-size: 0.8rem;
  opacity: 0.85;
  line-height: 1.3;
}

@media (max-width: 900px) {
  .trust-badges-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 540px) {
  .trust-badges-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Trust Badges and Marketplaces",
  "settings": [],
  "presets": [
    {
      "name": "Trust Badges and Marketplaces"
    }
  ]
}
{% endschema %}
