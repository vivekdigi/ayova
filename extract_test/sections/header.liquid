{% comment %}
  AYOVA HEADER — Figma Pixel-Perfect
  Dynamic: Logo, Navigation (Shopify menus), Utilities, Mobile Drawer
  Announcement bar with dynamic blocks
{% endcomment %}

<header class="ayova-header-wrapper" data-header>
  <!-- Announcement Bar — Figma: 34px, #285044 -->
  {% if section.settings.show_announcement %}
    <div class="announcement-bar" style="background-color: {{ section.settings.announcement_bg | default: '#285044' }}; color: {{ section.settings.announcement_text_color | default: '#FFFFFF' }};">
      <div class="container announcement-content">
        {% for block in section.blocks %}
          {% if block.type == 'announcement' %}
            {% unless forloop.first %}
              <span class="announcement-divider">•</span>
            {% endunless %}
            <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- Main Header — Figma: 80px height -->
  <div class="main-header">
    <div class="header-inner">
      <!-- Logo — Figma: 97x48px -->
      <a href="/" class="header-logo" aria-label="{{ shop.name }}">
        {% if settings.logo != blank %}
          <img
            src="{{ settings.logo | image_url: width: 194 }}"
            srcset="{{ settings.logo | image_url: width: 97 }} 1x, {{ settings.logo | image_url: width: 194 }} 2x"
            alt="{{ settings.logo.alt | default: shop.name | escape }}"
            width="{{ settings.logo_width | default: 97 }}"
            height="{{ settings.logo_width | default: 97 | divided_by: 2 }}"
            loading="eager"
            style="width: {{ settings.logo_width | default: 97 }}px; height: auto;"
          >
        {% else %}
          <span class="logo-text">
            <span class="logo-title">{{ shop.name | upcase }}</span>
          </span>
        {% endif %}
      </a>

      <!-- Desktop Navigation — Figma: Montserrat Medium/SemiBold 16px, gap 26px -->
      {% assign main_menu = linklists[section.settings.menu] %}
      <nav class="header-nav" role="navigation" aria-label="Main navigation">
        {% for link in main_menu.links %}
          <div class="nav-item {% if link.active %}active{% endif %}">
            <a href="{{ link.url }}" class="nav-link" {% if link.current %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
            {% if link.links.size > 0 %}
              <div class="nav-dropdown">
                {% for child_link in link.links %}
                  <a href="{{ child_link.url }}" class="nav-dropdown-link">{{ child_link.title }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </nav>

      <!-- Header Utilities — Figma: Search, Account, Wishlist icons + Cart pill -->
      <div class="header-utilities">
        <!-- Search -->
        <button type="button" class="utility-icon-btn" aria-label="Search" data-search-toggle>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- Account -->
        <a href="{{ routes.account_url }}" class="utility-icon-btn" aria-label="Account">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>

        {% if section.settings.show_wishlist %}
          <!-- Wishlist -->
          <button type="button" class="utility-icon-btn" aria-label="Wishlist">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </button>
        {% endif %}

        <!-- Cart Bag — Figma: #285044, border-radius 20px, 46px wide -->
        <a href="{{ routes.cart_url }}" class="cart-btn" aria-label="Cart ({{ cart.item_count }} items)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-count-badge" data-cart-count>{{ cart.item_count }}</span>
        </a>

        <!-- Mobile Menu Toggle -->
        <button type="button" class="mobile-toggle-btn" data-mobile-menu-toggle aria-label="Open menu" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu-overlay" data-mobile-overlay></div>
  <div class="mobile-menu-drawer" data-mobile-menu role="dialog" aria-label="Mobile menu">
    <div class="mobile-menu-header">
      <a href="/" class="header-logo" aria-label="{{ shop.name }}">
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 97 }}" alt="{{ shop.name | escape }}" width="97" height="48" style="width: 97px; height: auto;">
        {% else %}
          <span class="logo-text"><span class="logo-title">{{ shop.name | upcase }}</span></span>
        {% endif %}
      </a>
      <button type="button" class="mobile-menu-close" data-mobile-menu-close aria-label="Close menu">✕</button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {% for link in main_menu.links %}
        <a href="{{ link.url }}" class="mobile-nav-link">{{ link.title }}</a>
        {% if link.links.size > 0 %}
          <div class="mobile-nav-child">
            {% for child_link in link.links %}
              <a href="{{ child_link.url }}" class="mobile-nav-link">{{ child_link.title }}</a>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </nav>
  </div>

  <!-- Search Overlay -->
  <div class="search-overlay-bg" data-search-overlay-bg></div>
  <div class="search-overlay" data-search-overlay role="dialog" aria-label="Search">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <div class="search-input-wrapper">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7A857F" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" name="q" class="search-input" placeholder="Search for products, wellness goals..." autocomplete="off" aria-label="Search">
        <button type="button" class="mobile-menu-close" data-search-close aria-label="Close search">✕</button>
      </div>
      <input type="hidden" name="type" value="product">
    </form>
    <div data-search-results></div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement Background",
      "default": "#285044"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Utilities"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky Header",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message Text",
          "default": "🌿 Free Shipping on orders above Rs. 499"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "announcement",
          "settings": { "text": "🌿 Free Shipping on orders above Rs. 499" }
        },
        {
          "type": "announcement",
          "settings": { "text": "100% Ayurvedic & Lab Tested" }
        },
        {
          "type": "announcement",
          "settings": { "text": "AYUSH & ISO Certified Quality" }
        },
        {
          "type": "announcement",
          "settings": { "text": "⭐ 10,000+ Happy Customers" }
        }
      ]
    }
  ]
}
{% endschema %}
