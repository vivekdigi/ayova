<div class="password-page">
  <div class="password-main">
    <h2 class="password-heading">Opening Soon</h2>
    <p>Our store is currently password protected.</p>
    {%- form 'storefront_password', class: 'password-form' -%}
      <div class="password-field">
        <input
          type="password"
          name="password"
          id="Password"
          class="field__input"
          autocomplete="current-password"
          placeholder="Enter store password"
        >
        <button name="commit" class="password-button">
          Enter
        </button>
      </div>
      {%- if form.errors -%}
        <div class="password-form-error">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}
