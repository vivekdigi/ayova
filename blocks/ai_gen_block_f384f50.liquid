{% doc %}
  @prompt
    Create title section with mobile responsive should like h2 bold 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-title-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-title-section-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-title-section-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-title-section-{{ ai_gen_id }}__inner {
      width: 100%;
      padding: {{ block.settings.mobile_padding_top }}px 16px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-title-section-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<title-section-{{ ai_gen_id }}
  class="ai-title-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-title-section-{{ ai_gen_id }}__inner">
    <h2 class="ai-title-section-{{ ai_gen_id }}__title">
      {{ block.settings.title | escape }}
    </h2>
  </div>
</title-section-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Title section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our collection"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile size",
      "min": 18,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1D1D1D"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Title section"
    }
  ],
  "tag": null,
  "class": "title-section-block"
}
{% endschema %}